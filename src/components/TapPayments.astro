---
import type { DoorPaymentRow, TicketTypeRow } from '../lib/db';
import type { ProductRow } from '../lib/purchases';
import { agoLabel } from '../lib/time';

// Card payments taken in the Stripe Dashboard app (Tap to Pay), and the
// form that turns each one into what it bought: door tickets by name,
// checked in at once, and shop items sold and handed over. One payment can
// pay for several things, so the form takes a line per thing. The board
// sees this on the door page and on the shop's orders page, which is why
// it lives in one component; the door page also offers the ticket types,
// the orders page only the shop's items.

interface Props {
  mode: 'door' | 'shop';
  payments: DoorPaymentRow[];
  products: ProductRow[];
  types?: TicketTypeRow[]; // the event's ticket types, on the door page
  action: string; // where the attach form posts
  csrf: string;
  refresh: string; // this page, for the link and the reload
}

const { mode, payments, products, types = [], action, csrf, refresh } = Astro.props;
const now = Math.floor(Date.now() / 1000);
const euro = (cents: number) => `${(cents / 100).toFixed(2)} €`;
const tickets = types.filter((t) => t.active === 1);

// Everything a payment can be for, at both prices: the board picks the one
// they charged, so the record says what was really taken.
interface Choice {
  value: string;
  group: 'Tickets' | 'Shop';
  label: string;
  cents: number;
}
const choices: Choice[] = [
  ...tickets.flatMap((t) => [
    { value: `ticket:${t.id}`, group: 'Tickets' as const, label: `${t.name} · ${euro(t.price_cents)}`, cents: t.price_cents },
    ...(t.member_price_cents !== null
      ? [{ value: `ticket:${t.id}:m`, group: 'Tickets' as const, label: `${t.name} · members ${euro(t.member_price_cents)}`, cents: t.member_price_cents }]
      : []),
  ]),
  ...products.flatMap((p) => [
    { value: `item:${p.id}`, group: 'Shop' as const, label: `${p.name} · ${euro(p.price_cents)}`, cents: p.price_cents },
    ...(p.member_price_cents !== null
      ? [{ value: `item:${p.id}:m`, group: 'Shop' as const, label: `${p.name} · members ${euro(p.member_price_cents)}`, cents: p.member_price_cents }]
      : []),
  ]),
];
const groups: Choice['group'][] = mode === 'door' ? ['Tickets', 'Shop'] : ['Shop'];
// The prices to charge, once each, for the list under the steps.
const priceList = [
  ...tickets.filter((t) => t.price_cents > 0).map((t) => ({ name: t.name, price_cents: t.price_cents, member_price_cents: t.member_price_cents })),
  ...products.map((p) => ({ name: p.name, price_cents: p.price_cents, member_price_cents: p.member_price_cents })),
];
const matchFor = (cents: number) => choices.find((c) => c.cents === cents) ?? null;
const ref = (intent: string) => intent.slice(-6).toUpperCase();
---
<section class="panel-card tap-card" id="tap">
  <div class="card-head">
    <div>
      <h2>{mode === 'door' ? 'Card at the door' : 'Selling on the spot'}</h2>
      <p>
        Take the payment in the <strong>Stripe Dashboard</strong> app and attach it here:
        {mode === 'door' ? ' the buyer gets a door ticket for this event and is checked in on the spot.' : ' the item is sold and marked handed over in one go.'}
        {' '}One payment can cover several things — add a line for each.
      </p>
    </div>
    {payments.length > 0 ? (
      <span class="status-badge status-pending">{payments.length} to attach</span>
    ) : (
      <span class="tap-watch" data-tap-poll><span class="tap-dot" aria-hidden="true"></span>Watching for payments</span>
    )}
  </div>

  <ol class="tap-steps">
    <li><b>1</b><span>In the app: <strong>+</strong> → <strong>Charge card or send invoice</strong></span></li>
    <li><b>2</b><span>The total, and the buyer's name as the description</span></li>
    <li><b>3</b><span><strong>Tap to Pay</strong> — they tap their card or phone</span></li>
    <li><b>4</b><span>It turns up here in seconds: check the name, say what it was for, <strong>Attach</strong></span></li>
  </ol>

  {priceList.length > 0 && (
    <ul class="tap-prices">
      {priceList.map((p) => (
        <li>
          <span class="tap-price-name">{p.name}</span>
          <span class="tap-price">{euro(p.price_cents)}</span>
          {p.member_price_cents !== null && <span class="tap-price-member">members {euro(p.member_price_cents)}</span>}
        </li>
      ))}
    </ul>
  )}

  {payments.length === 0 ? (
    <p class="tap-empty">
      Nothing waiting. A payment shows up here within seconds of the card being tapped — this page looks again by itself every 15 seconds, or <a href={refresh}>refresh it</a>.
    </p>
  ) : (
    <ul class="tap-list">
      {payments.map((p) => {
        const match = matchFor(p.amount_cents);
        return (
          <li class="tap-payment">
            <div class="tap-sum">
              <strong class="tap-amount">{euro(p.amount_cents)}</strong>
              <span class="tap-when">{agoLabel(p.created_at, now)}</span>
              <span class="tap-ref" title={p.stripe_payment_intent}>Stripe ····{ref(p.stripe_payment_intent)}</span>
              {match ? (
                <span class="tap-match">the price of {match.label.replace(' · ', ', ')}</span>
              ) : (
                <span class="tap-match tap-nomatch">
                  {mode === 'door'
                    ? 'no single price matches — several things, or a price of its own: a line each'
                    : "no item costs this — several items, or a ticket taken at the door (that one belongs on the event's door page)"}
                </span>
              )}
            </div>
            <form method="post" action={action} class="tap-form" data-tap-amount={p.amount_cents}>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="payment_intent" value={p.stripe_payment_intent} />
              <label class="tap-field tap-who">
                <span>Who paid</span>
                <input name="holder_name" required maxlength="60" placeholder="Name" value={p.note ?? ''} />
              </label>
              <div class="tap-lines" data-tap-lines>
                <div class="tap-line" data-tap-line>
                  <label class="tap-field tap-what">
                    <span>What for</span>
                    <select name="line_what" data-tap-what>
                      {groups.map((group) =>
                        choices.some((c) => c.group === group) ? (
                          <optgroup label={group}>
                            {choices.filter((c) => c.group === group).map((c) => (
                              <option value={c.value} data-cents={c.cents} selected={match?.value === c.value}>{c.label}</option>
                            ))}
                          </optgroup>
                        ) : null,
                      )}
                    </select>
                  </label>
                  <label class="tap-field tap-name" data-tap-name hidden>
                    <span>Name</span>
                    <input name="line_name" maxlength="60" placeholder="On the ticket" />
                  </label>
                  <label class="tap-field tap-qty" data-tap-qty>
                    <span>Qty</span>
                    <input name="line_qty" type="number" min="1" max="10" value="1" />
                  </label>
                  <button class="tap-remove" type="button" data-tap-remove hidden aria-label="Take this line off">×</button>
                </div>
              </div>
              <div class="tap-do">
                <button class="btn btn-ghost btn-sm" type="button" data-tap-add hidden>Add a line</button>
                <span class="tap-count" data-tap-count hidden></span>
                <button class="btn btn-primary" type="submit">Attach</button>
              </div>
            </form>
          </li>
        );
      })}
    </ul>
  )}
</section>

<script>
  // The lines: a name for a ticket, a quantity for an item, and a running
  // total against what was charged. Without this the form still posts its
  // one line, which is the everyday case.
  const money = (cents: number) => `${(cents / 100).toFixed(2)} €`;

  function wire(form: HTMLFormElement): void {
    const box = form.querySelector<HTMLElement>('[data-tap-lines]');
    const add = form.querySelector<HTMLButtonElement>('[data-tap-add]');
    const count = form.querySelector<HTMLElement>('[data-tap-count]');
    const charged = Number(form.dataset.tapAmount ?? 0);
    if (!box || !add || !count) return;

    const lines = () => [...box.querySelectorAll<HTMLElement>('[data-tap-line]')];
    const sync = () => {
      let total = 0;
      lines().forEach((line, i) => {
        const what = line.querySelector<HTMLSelectElement>('[data-tap-what]');
        const name = line.querySelector<HTMLElement>('[data-tap-name]');
        const qty = line.querySelector<HTMLElement>('[data-tap-qty]');
        const remove = line.querySelector<HTMLButtonElement>('[data-tap-remove]');
        if (!what || !name || !qty || !remove) return;
        const isTicket = what.value.startsWith('ticket:');
        // The first line's holder is whoever paid; a further ticket is somebody else.
        name.hidden = !isTicket || i === 0;
        qty.hidden = isTicket;
        remove.hidden = i === 0;
        const pieces = isTicket ? 1 : Math.max(1, Number(qty.querySelector('input')?.value) || 1);
        total += Number(what.selectedOptions[0]?.dataset.cents ?? 0) * pieces;
      });
      count.hidden = lines().length < 2 && total === charged;
      count.textContent = total === charged ? `adds up to ${money(total)}` : `lines ${money(total)} · charged ${money(charged)}`;
      count.classList.toggle('tap-off', total !== charged);
    };

    add.hidden = false;
    add.addEventListener('click', () => {
      const all = lines();
      const copy = all[all.length - 1].cloneNode(true) as HTMLElement;
      copy.querySelectorAll('input').forEach((i) => {
        i.value = i.type === 'number' ? '1' : '';
      });
      box.append(copy);
      sync();
      copy.querySelector<HTMLSelectElement>('[data-tap-what]')?.focus();
    });
    box.addEventListener('change', sync);
    box.addEventListener('input', sync);
    box.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tap-remove]');
      if (!button) return;
      button.closest('[data-tap-line]')?.remove();
      sync();
    });
    sync();
  }

  document.querySelectorAll<HTMLFormElement>('form.tap-form').forEach(wire);

  // While nothing waits to be attached the page looks again by itself, so a
  // payment taken on the phone turns up without anyone reaching for the
  // browser — never while someone is typing.
  if (document.querySelector('[data-tap-poll]')) {
    const busy = () => {
      const active = document.activeElement;
      if (active instanceof HTMLInputElement || active instanceof HTMLSelectElement || active instanceof HTMLTextAreaElement) return true;
      return [...document.querySelectorAll<HTMLInputElement>('input')].some((i) => i.type !== 'hidden' && i.type !== 'number' && i.value !== '');
    };
    setInterval(() => {
      if (document.visibilityState === 'visible' && !busy()) location.reload();
    }, 15000);
  }
</script>
