---
// The strip on register pages: which Workspace account is signed in for
// the register, and a way to end that sign-in on a shared device.

interface Props {
  email: string;
  csrf: string;
}

const { email, csrf } = Astro.props;
---
<div class="session-box">
  <p>Register access as <strong>{email}</strong></p>
  <form method="post" action="/auth/google/logout">
    <input type="hidden" name="csrf" value={csrf} />
    <button class="btn-link" type="submit">End register sign-in</button>
  </form>
</div>
