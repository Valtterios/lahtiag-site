---
import type { Session } from '../lib/auth';

// The signed-in strip at the top of every server-rendered page. Prerendered
// pages can't show session state (they're built once for everyone), which
// is why this lives on the SSR pages and not in the header.

interface Props {
  session: Session | null;
  csrf: string;
}

const { session, csrf } = Astro.props;
---
<div class="session-box">
  {session ? (
    <>
      <p>
        Signed in as <strong>{session.username}</strong>
        {session.isAdmin && <span class="session-admin">admin</span>}
      </p>
      <form method="post" action="/logout">
        <input type="hidden" name="csrf" value={csrf} />
        <button class="btn-link" type="submit">Sign out</button>
      </form>
    </>
  ) : (
    <>
      <p>Sign in to join event signups.</p>
      <a class="btn btn-primary btn-sm" href="/login">Sign in with Discord</a>
    </>
  )}
</div>

<style is:global>
  .session-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.7rem 1rem;
    margin-bottom: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .session-box p {
    margin: 0;
  }
  .session-box strong {
    color: var(--text);
  }
  .session-admin {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 5px;
    padding: 0.1rem 0.4rem;
    margin-left: 0.5rem;
  }
  .btn-link {
    background: none;
    border: none;
    padding: 0;
    color: var(--link);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
  }
  .btn-link:hover {
    color: var(--text);
  }
  .btn-sm {
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
  }
</style>
