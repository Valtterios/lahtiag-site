---
// The board's pages, one click away: shown on /board and, for a board
// member without register access, in place of the register.
import { formatHelsinki } from '../lib/time';

interface Props {
  // Upcoming events, for the door-page shortcuts.
  events?: { id: number; title: string; starts_at: number }[];
  // Card payments taken with Tap to Pay and not attached to anything yet.
  payments?: number;
  // Members who asked to be an active and are still waiting.
  actives?: number;
}

const { events = [], payments = 0, actives = 0 } = Astro.props;
---
<div class="paths board-links">
  <section class="path-card">
    <h2>At the door</h2>
    <p>Check tickets in, sell on the spot, and attach the card payments you take with Tap to Pay in the Stripe app.</p>
    {payments > 0 && (
      <p class="board-alert">
        <strong>{payments} card payment{payments === 1 ? '' : 's'}</strong> waiting to be attached: on the door page of the event
        {payments === 1 ? ' it was' : ' they were'} taken at, or under <a href="/shop/orders#tap">Items to hand over</a> for a shop sale.
      </p>
    )}
    {events.length === 0 ? (
      <p>No upcoming events. Create one on the events page; its door page appears here.</p>
    ) : (
      <ul class="board-doors">
        {events.map((e) => (
          <li><a href={`/events/${e.id}/door`}>{e.title}</a> <span class="queue-meta">{formatHelsinki(e.starts_at)}</span></li>
        ))}
      </ul>
    )}
    <p class="entry-actions"><a class="btn btn-ghost btn-sm" href="/shop/orders">Items to hand over · card payments</a></p>
  </section>
  <section class="path-card">
    <h2>Members</h2>
    <p>Is someone a member? Name and status only. The actives — who they are, and who asked to become one — are a list any board member can open and decide on.</p>
    {actives > 0 && (
      <p class="board-alert">
        <strong>{actives} actives request{actives === 1 ? '' : 's'}</strong> waiting for the board, on the <a href="/board/actives#waiting">actives page</a> or on the buttons in the board channel.
      </p>
    )}
    <p class="entry-actions">
      <a class="btn btn-primary" href="/register/lookup">Member check</a>
      <a class="btn btn-ghost" href="/board/actives">Actives</a>
    </p>
  </section>
  <section class="path-card">
    <h2>Run things</h2>
    <ul class="board-doors">
      <li><a href="/events">Events</a> <span class="queue-meta">create, tickets, questions</span></li>
      <li><a href="/board/season">Season</a> <span class="queue-meta">activity counts and ticks</span></li>
      <li><a href="/whitelist">Minecraft whitelist</a> <span class="queue-meta">names and friends</span></li>
      <li><a href="/shop">Shop</a> <span class="queue-meta">products and pictures</span></li>
      <li><a href="/announcements">News</a> <span class="queue-meta">write and publish</span></li>
    </ul>
  </section>
  <section class="path-card">
    <h2>How it all works</h2>
    <p>The board guide is the short version; the technical handbook has the settings and the fixes.</p>
    <p class="entry-actions"><a class="btn btn-primary" href="/handbook">Board guide</a> <a class="btn btn-ghost" href="/handbook/technical">Technical handbook</a></p>
  </section>
</div>
