---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import { currentSession, ensureCsrf, checkCsrf } from '../lib/guard';
import { getRegisterByDiscord, getPendingLinkByDiscord, setOwnActive, updateOwnEntry, listMyEvents, memberStats, isLeaderboardOptIn, RuleError } from '../lib/db';
import {
  parseApplication,
  normalizeHandle,
  GAMES,
  STUDENT_STATUSES,
  STUDENT_STATUS_LABELS,
  UNIONS,
  UNION_LABELS,
  MEMBER_TYPE_LABELS,
  LIMITS,
  type FieldError,
} from '../lib/register';
import { postWebhook, NO_MENTIONS, avatarUrl } from '../lib/discord';
import MemberCard from '../components/MemberCard.astro';
import { postActivesRequest } from '../lib/board-channel';
import { applyRoles, loadRoleConfig } from '../lib/roles';
import { formatHelsinkiDate, formatHelsinkiRange } from '../lib/time';
import { listMinecraftNames, serversLabel, narrowed, SERVERS, FRIENDS_PER_MEMBER } from '../lib/minecraft';
import { voiceLabel } from '../lib/activity';
import { seasonSummary, minecraftLine, lifetimeTotals } from '../lib/season';
import { tickList } from '../lib/ticks';
import { levelTitle, rewardText } from '../lib/pass';

// A member's own page: their status, the actives request, and every
// detail they gave on the application, editable by them. Needs a Discord
// sign-in linked to an entry; status, class, and the link itself stay
// with the board. Two POSTs, told apart by `intent`: self (actives +
// Telegram) and details (the rest).

const session = await currentSession(Astro.request, env);
const csrf = ensureCsrf(Astro.cookies);
const entry = session ? await getRegisterByDiscord(env.DB, session.discordId) : null;
const myEvents = session ? await listMyEvents(env.DB, session.discordId, Math.floor(Date.now() / 1000)) : [];
const stats = session ? await memberStats(env.DB, session.discordId, Math.floor(Date.now() / 1000)) : null;
// The season so far (src/lib/season.ts): Discord activity from the listener, Minecraft play time from the servers.
const season = session ? await seasonSummary(env.DB, session.discordId, Math.floor(Date.now() / 1000)) : null;
// The card carries the whole record rather than the season's, so it is
// worth showing in September as well as in May.
const lifetime = session ? await lifetimeTotals(env.DB, session.discordId) : null;
const isMember = entry?.status === 'member';
// A level on the pass track: reached by XP or held from the ledger (a
// reward once given stays), the next line to cross, or still ahead.
const levelState = (l: { id: number; xp: number }): 'pass-done' | 'pass-next' | undefined =>
  season && (l.xp <= season.pass.xp || season.held.includes(l.id)) ? 'pass-done' : season?.pass.next?.id === l.id ? 'pass-next' : undefined;
const onLeaderboard = session ? await isLeaderboardOptIn(env.DB, session.discordId) : false;
const mcNames = session ? await listMinecraftNames(env.DB, session.discordId) : [];
const mcOwn = mcNames.find((n) => n.kind === 'own') ?? null;
const mcFriends = mcNames.filter((n) => n.kind === 'friend');
// The line under the name on the membership card: the class for members,
// otherwise where the entry stands.
const statusLabel = entry ? (entry.status === 'member' ? MEMBER_TYPE_LABELS[entry.member_type] : entry.status === 'pending' ? 'Application pending' : 'Former member') : '';
const RELATION: Record<string, string> = { ticket: 'Ticket', going: 'Going', maybe: 'Maybe', waitlist: 'On the waitlist', interested: 'Interested' };
const pendingLink = session && !entry ? await getPendingLinkByDiscord(env.DB, session.discordId) : null;

// Four figures for the card, in the order they read best: what they turned
// up to, what they won, and how much of each place they have used. Only on
// an issued card; before that there is nothing to put on it.
const figures =
  isMember && stats && lifetime
    ? [
        { label: 'Events', value: String(stats.attended) },
        { label: 'Wins', value: String(stats.wins) },
        { label: 'Messages', value: String(lifetime.messages) },
        { label: 'Minecraft', value: lifetime.minecraft_minutes > 0 ? voiceLabel(lifetime.minecraft_minutes) : '—' },
      ]
    : [];

// The rest of the record goes on the back, where there is room for the
// figures that would not earn a tile of their own on the front.
const record =
  isMember && stats && lifetime
    ? [
        `Tournaments ${stats.tournaments}`,
        `In voice ${lifetime.voice_minutes > 0 ? voiceLabel(lifetime.voice_minutes) : 'none yet'}`,
        stats.first_event_at ? `First event ${formatHelsinkiDate(stats.first_event_at)}` : null,
        stats.last_win ? `Last win ${stats.last_win.title}` : null,
      ].filter((line): line is string => line !== null)
    : [];

let errors: FieldError[] = [];
let problem: 'csrf' | 'duplicate' | null = null;
const values: Record<string, string> = {};
let pickedGames: string[] | null = null;

if (Astro.request.method === 'POST' && session && entry) {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const now = Math.floor(Date.now() / 1000);
  const notify = (content: string) => {
    if (env.BOARD_WEBHOOK_URL) {
      Astro.locals.cfContext.waitUntil(postWebhook(env.BOARD_WEBHOOK_URL, content, NO_MENTIONS));
    }
  };

  if (!(await checkCsrf(Astro.request, form))) {
    problem = 'csrf';
  } else if (intent === 'self') {
    const wants = form.get('wants_active') === 'on';
    const telegramRaw = String(form.get('telegram') ?? '');
    if (telegramRaw.length > LIMITS.telegram) return Astro.redirect('/membership?err=telegram', 303);
    const updated = await setOwnActive(env.DB, session.discordId, wants, normalizeHandle(telegramRaw), now);
    if (updated && wants && !entry.wants_active) {
      // The board's channel, with Approve / Decline for any board member.
      Astro.locals.cfContext.waitUntil(postActivesRequest(env.DB, env, updated, Astro.url.origin));
    }
    // Leaving the actives takes the Discord role away at once.
    if (updated && entry.is_active && !updated.is_active) {
      await applyRoles(await loadRoleConfig(env, env.DB), updated);
    }
    return Astro.redirect('/membership?ok=saved', 303);
  } else if (intent === 'details') {
    for (const name of ['full_name', 'domicile', 'email', 'student_status', 'union_member', 'telegram', 'games_other', 'message']) {
      values[name] = String(form.get(name) ?? '');
    }
    pickedGames = form.getAll('games').map(String);
    // The actives flag lives in the panel above; the details form keeps
    // whatever it is.
    if (entry.wants_active) form.set('wants_active', 'on');
    form.set('telegram', entry.telegram ?? values.telegram);
    const parsed = parseApplication(form, false);
    if (!parsed.ok) {
      errors = parsed.errors;
    } else {
      try {
        const updated = await updateOwnEntry(env.DB, session.discordId, parsed.value, now);
        if (updated && entry.is_active && !updated.is_active) {
          await applyRoles(await loadRoleConfig(env, env.DB), updated);
        }
        return Astro.redirect('/membership?ok=details', 303);
      } catch (error) {
        if (!(error instanceof RuleError)) throw error;
        problem = 'duplicate';
      }
    }
  }
  Astro.response.status = 422;
}

const gamesList = entry?.games ? entry.games.split(',').map((g) => g.trim()) : [];
const knownGames = pickedGames ?? gamesList.filter((g) => (GAMES as readonly string[]).includes(g));
const otherGames = values.games_other ?? gamesList.filter((g) => !(GAMES as readonly string[]).includes(g)).join(', ');
const field = (name: string, fallback: string | null) => values[name] ?? fallback ?? '';

const NOTES: Record<string, string> = {
  saved: 'Saved.',
  details: 'Your details are updated.',
  leaderboard: 'Leaderboard choice saved.',
  telegram: 'That Telegram handle is too long.',
  mc_own: 'Your Minecraft name is on the list. The server picks it up within a few minutes.',
  mc_friend: 'Sent to the board. Once a board member approves, the name goes on the servers and you get a DM.',
  mc_friend_on: 'That name was on the list already, so it is yours now, no approval needed.',
  mc_remove: 'Taken off the list. The server drops the name within a few minutes.',
  mc_bad_name: 'A Minecraft name is 3 to 16 letters, digits or underscores.',
  mc_name_taken: 'That name is already on the list.',
  mc_not_member: 'The whitelist needs a current membership.',
  mc_friend_limit: `${FRIENDS_PER_MEMBER} friends per member. Take one off first.`,
  mc_no_account: 'No Minecraft account has that name. Check the spelling; it is the Java edition name.',
  mc_mojang_down: "Mojang didn't answer. Try again in a minute.",
  mc_bad: "That didn't work. Try again.",
};
const note = NOTES[Astro.url.searchParams.get('ok') ?? Astro.url.searchParams.get('err') ?? ''] ?? null;
const bad = (f: FieldError) => (errors.includes(f) ? 'field-error' : undefined);
const MESSAGES: Record<FieldError, string> = {
  full_name: 'Your full name, 2 to 100 characters.',
  domicile: 'Your home municipality is required (the Associations Act asks for it).',
  email: 'That email address does not look right.',
  student_status: 'Pick where you study.',
  union_member: 'Pick your student union, or Neither.',
  telegram: 'That Telegram handle is too long.',
  discord_name: '',
  games: 'The "other games" text is too long.',
  message: 'The message is too long (500 characters).',
  consent: '',
};
---
<Base title="Your membership" description="Your LahtiAG membership: status, actives, and your details.">
  <header class="page-head">
    <h1>Your membership</h1>
    {session && (
      <div class="account-bar">
        <span class="account-who">Signed in as <strong>{session.username}</strong> on Discord</span>
        <a class="btn btn-ghost btn-sm" href="/tickets">My tickets</a>
        <a class="btn btn-ghost btn-sm" href="/purchases">My purchases</a>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="csrf" value={csrf} />
          <button class="btn btn-ghost btn-sm" type="submit">Sign out</button>
        </form>
      </div>
    )}
  </header>

  {!session && (
    <div class="paths">
      <section class="path-card">
        <h2>Sign in first</h2>
        <p>Your membership page opens with the Discord account linked to your membership.</p>
        <a class="btn btn-primary" href="/login?next=/membership">Sign in with Discord</a>
      </section>
      <section class="path-card path-new">
        <h2>Not a member yet?</h2>
        <p>Membership is free for higher education students in Lahti.</p>
        <a class="btn btn-cta" href="/join">Become a member</a>
      </section>
    </div>
  )}

  {session && !entry && (
    <div class="paths">
      <section class="path-card">
        <h2>Not linked yet</h2>
        {pendingLink ? (
          <p>
            Signed in as <strong>{session.username}</strong>. Your request to link this account is
            waiting for the board; this page fills in once it's confirmed.
          </p>
        ) : (
          <>
            <p>
              Signed in as <strong>{session.username}</strong>, but this Discord account isn't linked
              to a membership. Members from before link it on the join page; new people apply there.
            </p>
            <a class="btn btn-primary" href="/join">Go to the join page</a>
          </>
        )}
      </section>
    </div>
  )}

  {session && entry && (
    <>
      {note && <p class="flash">{note}</p>}

      {entry.fix_note !== null && (
        <div class="flash flash-ask">
          <p><strong>The board has a question about your application.</strong></p>
          <blockquote>{entry.fix_note}</blockquote>
          <p>
            Put it right under <a href="#details">Your details</a> below and save — that is all it takes, and the
            board sees it straight away. Nothing else about your application changes.
          </p>
        </div>
      )}

      <section class="member-hero" id="my-stats">
        <MemberCard
          name={entry.full_name}
          number={entry.id}
          klass={statusLabel}
          status={entry.status}
          since={entry.status === 'pending' ? entry.applied_at : (entry.decided_at ?? entry.applied_at)}
          discord={entry.discord_name ?? session.username}
          avatar={avatarUrl(session.discordId, session.avatarHash, 128)}
          active={entry.is_active}
          board={session.isAdmin}
          honorary={entry.member_type === 'honorary'}
          honour={entry.honour}
          outside={entry.member_type === 'external' || entry.member_type === 'supporting'}
          figures={figures}
          minecraft={mcOwn?.name ?? null}
          telegram={entry.telegram}
          record={record}
        />
        <div class="member-status">
          {entry.status !== 'member' && (
            <p class="member-meta">
              {entry.status === 'pending'
                ? 'The board decides on applications at its next meeting. Your card is issued the moment it does.'
                : "You're listed as a former member; email the board to rejoin."}
            </p>
          )}

          {season && isMember && (
            <dl class="season-facts">
              <div class="season-facts-head">
                <dt>Season {season.label}</dt>
                <dd><strong>{season.tick_xp} XP</strong></dd>
              </div>
              <div class="season-pass" id="pass">
                <dt>Pass</dt>
                <dd>
                  {season.pass.levels.length === 0 ? (
                    'The board sets this season\'s levels in the autumn. Your XP counts already.'
                  ) : (
                    <>
                      <p class="pass-standing">
                        {season.pass.current ? <strong>{levelTitle(season.pass.current)}</strong> : <strong>No level yet</strong>}
                        {season.pass.next
                          ? <span> · {season.pass.to_next} XP to {levelTitle(season.pass.next)}</span>
                          : <span> · every level reached</span>}
                      </p>
                      <div class="pass-bar" role="progressbar" aria-valuemin="0" aria-valuemax={season.pass.next?.xp ?? season.pass.xp} aria-valuenow={season.pass.xp} aria-label="Season pass progress">
                        <span style={`width: ${Math.round(season.pass.fraction * 100)}%`}></span>
                      </div>
                      <ol class="pass-levels">
                        {season.pass.levels.map((l) => (
                          <li class={levelState(l)}>
                            <span class="pass-mark" aria-hidden="true">{levelState(l) === 'pass-done' ? '✓' : l.level}</span>
                            <span class="pass-level">
                              <strong>{l.name}</strong> <span class="pass-xp">{l.xp} XP</span>
                              <br />{rewardText(l)}
                            </span>
                          </li>
                        ))}
                      </ol>
                    </>
                  )}
                </dd>
              </div>
              <div>
                <dt>Discord</dt>
                <dd>{season.messages > 0 || season.voice_minutes > 0 ? <><strong>{season.messages}</strong> messages · <strong>{voiceLabel(season.voice_minutes)}</strong> in voice</> : 'Nothing counted yet'}</dd>
              </div>
              <div>
                <dt>Minecraft</dt>
                <dd>{minecraftLine(season, 'Add it under Minecraft below.')}</dd>
              </div>
              <div>
                <dt>Ticks</dt>
                <dd>{season.ticks.length > 0 ? tickList(season.ticks) : 'None from the board yet'}</dd>
              </div>
              {season.claims_pending > 0 && (
                <div>
                  <dt>Claims</dt>
                  <dd><strong>{season.claims_pending}</strong> waiting for the board. You get a DM when they are decided.</dd>
                </div>
              )}
            </dl>
          )}
          <p class="member-foot">
            Discord counts only channels every member can see. <code>/season</code> in Discord shows this season to you.
          </p>
        </div>
      </section>

      <nav class="tabs" data-tabs aria-label="Membership sections">
        <a class="tab" href="#membership" role="tab" aria-selected="true">Membership</a>
        <a class="tab" href="#my-events" role="tab" aria-selected="false">My events{myEvents.length > 0 && <span class="tab-count">{myEvents.length}</span>}</a>
        <a class="tab" href="#minecraft" role="tab" aria-selected="false">Minecraft{mcNames.some((n) => n.approved_at === null) && <span class="tab-count">!</span>}</a>
      </nav>
      <noscript><style>{'.tab-panel[hidden]{display:block} .tabs{display:none}'}</style></noscript>

      <section class="tab-panel" id="membership" data-tab-panel>
        {stats && (
          <section class="panel-card">
            <div class="card-head">
              <div>
                <h2>Your card in Discord</h2>
                <p>
                  <code>/profile</code> posts this for everyone in the server to see, and anyone looking at it
                  can turn it over. It is the same card as above with everything the register keeps to itself
                  taken off: no full name, no number, no membership class — only what Discord already knows
                  and what the association says out loud.
                </p>
              </div>
            </div>
            <img class="profile-card" src="/membership/card.png" alt="Your card as Discord shows it" width="900" height="567" />
            <form method="post" action="/membership/leaderboard" class="leaderboard-optin">
              <input type="hidden" name="csrf" value={csrf} />
              <label class="check"><input type="checkbox" name="hide" checked={!onLeaderboard} /> <span>Hide me from the public leaderboard on the <a href="/history">history page</a> and keep my season off my profile card. Everyone is on both unless hidden.</span></label>
              <button class="btn btn-ghost btn-sm" type="submit">Save</button>
            </form>
          </section>
        )}

        <section class="panel-card">
          <div class="card-head">
            <div>
              <h2>Actives</h2>
              <p>
                Actives hear about event ideas, planning and meetings first, in the actives channel on
                Discord. It commits you to nothing. The board approves actives; once approved you get the
                Actives role. Untick to leave.
              </p>
            </div>
            {entry.is_active && <span class="status-badge status-member">You're an active</span>}
            {!entry.is_active && entry.wants_active && <span class="status-badge status-pending">Waiting for the board</span>}
          </div>
          <form method="post" action="/membership" class="self-row">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="intent" value="self" />
            <label class="check">
              <input type="checkbox" name="wants_active" checked={entry.wants_active} />
              <span><strong>I want to be an active</strong></span>
            </label>
            <label class="self-field">
              Telegram
              <input name="telegram" maxlength={LIMITS.telegram} placeholder="@handle" value={entry.telegram ?? ''} />
            </label>
            <button class="btn btn-primary" type="submit">Save</button>
          </form>
        </section>

        <section class="panel-card" id="details">
          <div class="card-head">
            <div>
              <h2>Your details</h2>
              <p>
                Keep these current, especially your home municipality: the association must keep it on
                record. Your membership class and status are the board's to change.
              </p>
            </div>
          </div>
          {problem === 'csrf' && <p class="flash">The form was stale. Please send it again.</p>}
          {problem === 'duplicate' && <p class="flash">Another member already uses that email address.</p>}
          {errors.length > 0 && (
            <ul class="flash flash-list">
              {errors.filter((e) => MESSAGES[e]).map((e) => <li>{MESSAGES[e]}</li>)}
            </ul>
          )}
          <form method="post" action="/membership" class="app-form join-form" novalidate>
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="intent" value="details" />
            <div class="form-grid">
              <label class={bad('full_name')}>Full name *<input name="full_name" required maxlength={LIMITS.full_name} value={field('full_name', entry.full_name)} /></label>
              <label class={bad('domicile')}>Home municipality (kotikunta) *<input name="domicile" required maxlength={LIMITS.domicile} value={field('domicile', entry.domicile)} /></label>
              <label class={bad('email')}>Email *<input name="email" type="email" required maxlength={LIMITS.email} value={field('email', entry.email)} /></label>
              <label class={bad('student_status')}>
                I study at *
                <select name="student_status" required>
                  {STUDENT_STATUSES.map((s) => (
                    <option value={s} selected={field('student_status', entry.student_status) === s}>{STUDENT_STATUS_LABELS[s]}</option>
                  ))}
                </select>
              </label>
              <label class={bad('union_member')}>
                Student union *
                <select name="union_member" required>
                  {UNIONS.map((u) => (
                    <option value={u} selected={field('union_member', entry.union_member) === u}>{UNION_LABELS[u]}</option>
                  ))}
                </select>
              </label>
              <label>Discord<input value={entry.discord_name ?? session.username} readonly /></label>
            </div>
            <fieldset class="checkbox-grid">
              <legend>I'm interested in</legend>
              {GAMES.map((game) => (
                <label class="check"><input type="checkbox" name="games" value={game} checked={knownGames.includes(game)} /> {game}</label>
              ))}
              <label class={`check-other ${bad('games') ?? ''}`}>Other<input name="games_other" maxlength={LIMITS.games_other} value={otherGames} /></label>
            </fieldset>
            <label class={bad('message')}>
              Message to the board
              <textarea name="message" rows="2" maxlength={LIMITS.message}>{field('message', entry.message)}</textarea>
            </label>
            <button class="btn btn-primary" type="submit">Save details</button>
          </form>
        </section>

        <p class="queue-meta">To resign, email <a href="mailto:board@lahtiag.fi">board@lahtiag.fi</a>.</p>
      </section>

      <section class="tab-panel" id="my-events" data-tab-panel hidden>
        <section class="panel-card">
          <div class="card-head">
            <div>
              <h2>My events</h2>
              <p>Everything you're signed up for, on a waitlist for, or marked as interested in.</p>
            </div>
          </div>
          {myEvents.length === 0 ? (
            <p class="app-empty">Nothing coming up yet. Sign up, join a waitlist, or press Interested on an <a href="/events">event</a> and it shows here.</p>
          ) : (
            <ul class="ticket-list">
              {myEvents.map((e) => (
                <li class="ticket-card">
                  <div>
                    <p class="ticket-event"><a href={`/events/${e.id}`}>{e.title}</a></p>
                    <p class="queue-meta">{formatHelsinkiRange(e.starts_at, e.ends_at)}{e.location ? ` · ${e.location}` : ''}</p>
                  </div>
                  <span class={`status-badge${e.relation === 'ticket' || e.relation === 'going' ? ' status-member' : e.relation === 'interested' ? ' status-muted' : ''}`}>{RELATION[e.relation]}</span>
                </li>
              ))}
            </ul>
          )}
          <p class="queue-meta card-foot">Tickets are under <a href="/tickets">My tickets</a>; past events and results on the <a href="/history">history page</a>.</p>
        </section>
      </section>

      <section class="tab-panel" id="minecraft" data-tab-panel hidden>
        <div class="mc-card">
          <div class="mc-head">
            <div>
              <h2>Whitelist</h2>
              <p>
                Your Java edition name goes on every LahtiAG server within five minutes. Up to {FRIENDS_PER_MEMBER} friends can come along on your
                membership once the board says yes. Every name is checked with Mojang and shown with its skin, so you can see it's the right account.
              </p>
            </div>
            <ul class="mc-servers">
              {SERVERS.map((s) => (
                <li><span class="mc-server-name">{s.label}</span><code>{s.address}</code></li>
              ))}
            </ul>
          </div>

          {entry.status !== 'member' ? (
            <p class="queue-meta">The whitelist opens once your membership is approved.</p>
          ) : (
            <>
              {mcNames.length > 0 ? (
                <ul class="mc-rows">
                  {mcNames.map((n) => (
                    <li class="mc-row">
                      {n.uuid ? <img class="mc-face" src={`/membership/minecraft/face/${n.uuid}`} width="32" height="32" alt="" loading="lazy" /> : <span class="mc-face mc-face-empty" />}
                      <span class="mc-name">{n.name}</span>
                      <span class="mc-meta">{n.kind === 'own' ? 'you' : 'your friend'}{narrowed(n.servers) && ` · ${serversLabel(n.servers)} only`}</span>
                      <span class={`status-badge ${n.approved_at === null ? 'status-muted' : 'status-member'}`}>{n.approved_at === null ? 'Waiting for the board' : 'On the servers'}</span>
                      <form method="post" action="/membership/minecraft" class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="name" value={n.name} />
                        <button class="btn btn-ghost btn-sm" type="submit">Remove</button>
                      </form>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="app-empty">No names yet. Add yours below and you're in within five minutes.</p>
              )}

              <div class="mc-forms">
                <form method="post" action="/membership/minecraft" class="mc-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="action" value="own" />
                  <h4>{mcOwn ? 'Your name' : 'Whitelist yourself'}</h4>
                  <label>Minecraft name <input name="name" required maxlength="16" pattern="[A-Za-z0-9_]{3,16}" value={mcOwn?.name ?? ''} placeholder="Steve" /></label>
                  <button class="btn btn-primary btn-sm" type="submit">{mcOwn ? 'Change' : 'Whitelist me'}</button>
                </form>
                {mcFriends.length < FRIENDS_PER_MEMBER && (
                  <form method="post" action="/membership/minecraft" class="mc-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="friend" />
                    <h4>Bring a friend</h4>
                    <label>Their Minecraft name <input name="name" required maxlength="16" pattern="[A-Za-z0-9_]{3,16}" placeholder="Alex" /></label>
                    <label>For
                      <select name="servers">
                        <option value="all">every server</option>
                        {SERVERS.map((s) => <option value={s.slug}>{s.label} only</option>)}
                      </select>
                    </label>
                    <button class="btn btn-ghost btn-sm" type="submit">Ask the board</button>
                  </form>
                )}
              </div>
              <p class="queue-meta card-foot">
                In Discord, <code>/whitelist</code> does all of this too.{session.isAdmin && <> Board: <a href="/whitelist">the whitelist table</a>.</>}
              </p>
            </>
          )}
        </div>
      </section>
    </>
  )}
</Base>

<script>
  // Tabs on the membership page: one panel at a time, the choice kept in
  // the hash so links and redirects (#minecraft, #my-events) land on the
  // right one. Without JavaScript every panel simply shows.
  const bar = document.querySelector('[data-tabs]');
  if (bar) {
    const tabs = Array.from(bar.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-tab-panel]'));
    const ALIASES: Record<string, string> = { 'my-stats': 'membership' };
    const show = (wanted: string, remember: boolean) => {
      const id = panels.some((p) => p.id === wanted) ? wanted : 'membership';
      for (const p of panels) p.hidden = p.id !== id;
      for (const t of tabs) t.setAttribute('aria-selected', String(t.getAttribute('href') === `#${id}`));
      if (remember) history.replaceState(null, '', `#${id}`);
    };
    for (const t of tabs) {
      t.addEventListener('click', (e) => {
        e.preventDefault();
        show((t.getAttribute('href') ?? '').slice(1), true);
      });
    }
    const initial = location.hash.slice(1);
    show(ALIASES[initial] ?? initial, false);
    window.addEventListener('hashchange', () => show(location.hash.slice(1), false));
  }
</script>
