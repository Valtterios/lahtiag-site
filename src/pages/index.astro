---
import { env } from 'cloudflare:workers';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import DiscordWidget from '../components/DiscordWidget.astro';
import { listUpcomingEvents, type EventWithCounts } from '../lib/db';
import { formatHelsinkiRange } from '../lib/time';

// Server-rendered since the "coming up" strip reads D1. A database hiccup
// must never take the front page down, so the query degrades to an empty
// strip instead of an error.

const entry = await getEntry('pages', 'home');
if (!entry) {
  throw new Error('src/content/pages/home.md is required: it is the site root.');
}
const { Content } = await render(entry);

const now = Math.floor(Date.now() / 1000);
let upcoming: EventWithCounts[] = [];
try {
  upcoming = (await listUpcomingEvents(env.DB, now)).slice(0, 4);
} catch {
  // strip stays empty; the page stays up
}
---
<Base title={entry.data.title} description={entry.data.description}>
  <section class="hero">
    <div>
      <p class="hero-eyebrow">Lahti Association of Gaming LAG ry</p>
      <h1>Where Lahti's students <em>come to play</em>.</h1>
      <p class="hero-lede">
        A non-profit gaming and esports association for students of Lahti's
        higher education institutions. Gaming nights, tournaments, LAN
        events, and a Discord that never sleeps.
      </p>
      <p class="hero-ctas">
        <a class="btn btn-cta" href="https://forms.gle/nwsqFmqDyzJtpntE9" rel="noopener">
          Become a member, it's free
        </a>
        <a class="btn btn-ghost" href="/events">See what's on</a>
      </p>
    </div>
    <div class="hero-side">
      <p class="live-tag">Live from our Discord</p>
      <DiscordWidget />
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="upnext">
      <article class="prose"><h2>Coming up</h2></article>
      <ul class="upnext-list">
        {upcoming.map((event) => (
          <li>
            {event.starts_at <= now && <span class="live-badge">Happening now</span>}
            <a href={`/events/${event.id}`}>{event.title}</a>
            <span class="event-meta">{formatHelsinkiRange(event.starts_at, event.ends_at)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <article class="prose">
    <Content />
  </article>
</Base>
