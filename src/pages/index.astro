---
import { env } from 'cloudflare:workers';
import { getEntry } from 'astro:content';
import { Marked } from 'marked';
import Base from '../layouts/Base.astro';
import DiscordWidget from '../components/DiscordWidget.astro';
import { listUpcomingEvents, listAnnouncements, listPhotoAlbums, coverVersions, type EventWithCounts, type AnnouncementRow, type PhotoAlbum } from '../lib/db';
import { ticketPrice, seatsLeft, isFull } from '../lib/price';
import { newsExcerpt } from '../lib/news';
import { formatHelsinkiRange, formatHelsinkiDate } from '../lib/time';

// Server-rendered: what is coming up, what was written and what was played
// all come from D1. A database hiccup must never take the front page down,
// so every strip degrades to nothing instead of an error.

const entry = await getEntry('pages', 'home');
if (!entry) {
  throw new Error('src/content/pages/home.md is required: it is the site root.');
}
// The page's own words are one Markdown file the board edits, but they
// belong in two places: what the association is, high up, and what it does,
// beside the way in. Each "## " heading starts a piece; the first piece is
// the first slot and everything after it the second, so an edited file with
// one heading or three still renders whole.
const escapeHtml = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const markdown = new Marked({ renderer: { html: ({ text }) => escapeHtml(text) } });
const pieces = entry.body
  ? entry.body
      .split(/^(?=## )/m)
      .map((piece) => piece.trim())
      .filter(Boolean)
      .map((piece) => markdown.parse(piece, { async: false }) as string)
  : [];
const aboutHtml = pieces[0] ?? '';
const doesHtml = pieces.slice(1).join('\n');

const now = Math.floor(Date.now() / 1000);
let upcoming: EventWithCounts[] = [];
let covers = new Map<number, number>();
let news: AnnouncementRow[] = [];
let albums: PhotoAlbum[] = [];
try {
  [upcoming, news, albums] = await Promise.all([
    listUpcomingEvents(env.DB, now).then((all) => all.slice(0, 3)),
    listAnnouncements(env.DB, 3),
    listPhotoAlbums(env.DB, 6),
  ]);
  covers = await coverVersions(env.DB, upcoming.map((e) => e.id));
} catch {
  // the strips stay empty; the page stays up
}
---
<Base title={entry.data.title} description={entry.data.description}>
  <section class="hero">
    <div>
      <p class="hero-eyebrow">Lahti Association of Gaming LAG ry</p>
      <h1>Where Lahti's students <em>come to play</em>.</h1>
      <p class="hero-lede">
        A non-profit gaming and esports association for students of Lahti's
        higher education institutions. Gaming nights, tournaments, LAN
        events, and a Discord that never sleeps.
      </p>
      <p class="hero-ctas">
        <a class="btn btn-cta" href="/join">
          Become a member, it's free
        </a>
        <a class="btn btn-ghost" href="/events">See what's on</a>
      </p>
    </div>
    <div class="hero-side">
      <p class="live-tag">Live from our Discord</p>
      <DiscordWidget />
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="home-section">
      <div class="home-head">
        <h2>Coming up</h2>
        <a class="btn btn-ghost btn-sm" href="/events">All events</a>
      </div>
      <ul class="event-grid">
        {upcoming.map((event) => (
          <li class="event-tile">
            <a class="event-tile-cover" href={`/events/${event.id}`} tabindex="-1" aria-hidden="true">
              {covers.has(event.id) ? (
                <img src={`/events/${event.id}/cover?t=${covers.get(event.id)}`} alt="" loading="lazy" />
              ) : (
                <span class="event-tile-empty"><img src="/brand/mark-blue.png" alt="" width="512" height="443" /></span>
              )}
            </a>
            <div class="event-tile-body">
              <p class="event-when">
                {event.starts_at <= now && <span class="live-badge">Happening now</span>}
                {formatHelsinkiRange(event.starts_at, event.ends_at)}
              </p>
              <h3><a href={`/events/${event.id}`}>{event.title}</a></h3>
              {event.location && <p class="event-meta">{event.location}</p>}
              <p class="event-tags">
                <span class="event-price">{ticketPrice(event)}</span>
                {event.members_only === 1 && <span class="status-badge status-member">Members only</span>}
                {isFull(event) && <span class="status-badge status-muted">{event.ticket_types > 0 ? 'Sold out' : 'Full'}</span>}
                {!isFull(event) && seatsLeft(event) !== null && seatsLeft(event)! <= 5 && (
                  <span class="status-badge status-pending">{seatsLeft(event)} {event.team_size !== null ? 'team slots left' : 'left'}</span>
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {aboutHtml && (
    <section class="home-section home-words">
      <div class="prose home-prose" set:html={aboutHtml} />
    </section>
  )}

  {news.length > 0 && (
    <section class="home-section">
      <div class="home-head">
        <h2>Latest news</h2>
        <a class="btn btn-ghost btn-sm" href="/announcements">All news</a>
      </div>
      <ul class="news-strip">
        {news.map((post) => (
          <li class="news-tile">
            <a class={`news-tile-cover${post.cover_at ? '' : ' news-tile-empty'}`} href={`/announcements#post-${post.id}`} tabindex="-1" aria-hidden="true">
              {post.cover_at ? (
                <img src={`/announcements/${post.id}/cover?v=${post.cover_at}`} alt="" loading="lazy" />
              ) : (
                <img src="/brand/mark-blue.png" alt="" width="512" height="443" />
              )}
            </a>
            <div class="news-tile-body">
              <p class="event-when">{formatHelsinkiDate(post.published_at)}</p>
              <h3><a href={`/announcements#post-${post.id}`}>{post.title}</a></h3>
              <p class="event-meta">{newsExcerpt(post)}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {doesHtml && (
    <section class="home-about">
      <div class="prose home-prose" set:html={doesHtml} />
      <aside class="home-join">
        <h2>Membership is free</h2>
        <p>
          Open to every student at Lahti's higher education institutions, and to anyone else as a supporting member.
          Members pay less for tickets, get the member channels on Discord, and count towards the season.
        </p>
        <p class="entry-actions">
          <a class="btn btn-cta" href="/join">Become a member</a>
          <a class="btn btn-ghost" href="https://discord.com/invite/u2pcgDhQ7G" rel="noopener">Say hi on Discord</a>
        </p>
      </aside>
    </section>
  )}

  {albums.length > 0 && (
    <section class="home-section">
      <div class="home-head">
        <h2>From our events</h2>
        <a class="btn btn-ghost btn-sm" href="/history">The whole history</a>
      </div>
      <ul class="photo-strip">
        {albums.map((album) => (
          <li>
            <a href={`/events/${album.event_id}#photos`} title={album.title}>
              <img src={`/events/${album.event_id}/photos/${album.first_id}?thumb`} alt="" loading="lazy" />
              <span>{album.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

</Base>
