---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import { currentSession, ensureCsrf, checkCsrf } from '../lib/guard';
import {
  applyForMembership,
  getRegisterByDiscord,
  getPendingLinkByDiscord,
  requestDiscordLink,
  RuleError,
} from '../lib/db';
import {
  parseApplication,
  GAMES,
  STUDENT_STATUSES,
  STUDENT_STATUS_LABELS,
  UNIONS,
  UNION_LABELS,
  LIMITS,
  type FieldError,
} from '../lib/register';
import { postWebhook, applicationNotice, linkRequestNotice, NO_MENTIONS } from '../lib/discord';

// The join page, replacing the Google Form. Two ways in, shown as two
// cards: new people apply; existing members sign in with Discord to link
// their account (the board confirms). Once linked, their own page is
// /membership. The form's `intent` tells the two POSTs apart: apply |
// claim. The page handles its own POST so a rejected application
// re-renders with what was typed; success redirects (post/redirect/get).

const session = await currentSession(Astro.request, env);
const csrf = ensureCsrf(Astro.cookies);
const existing = session ? await getRegisterByDiscord(env.DB, session.discordId) : null;
// A linked member's own page is /membership; the join page is for joining.
if (existing) return Astro.redirect('/membership', 303);
const pendingLink = session ? await getPendingLinkByDiscord(env.DB, session.discordId) : null;

let errors: FieldError[] = [];
let problem: 'csrf' | null = null;
const values: Record<string, string> = {};
let pickedGames: string[] = [];
let wantsActive = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'apply');
  const now = Math.floor(Date.now() / 1000);
  // Board notices go out after the response, never before it (security
  // review): awaiting Discord only on some paths made response time reveal
  // whether an email was already in the register.
  const notify = (content: string) => {
    if (env.BOARD_WEBHOOK_URL) {
      Astro.locals.cfContext.waitUntil(postWebhook(env.BOARD_WEBHOOK_URL, content, NO_MENTIONS));
    }
  };

  if (!(await checkCsrf(Astro.request, form))) {
    problem = 'csrf';
  } else if (intent === 'claim' && session) {
    const email = String(form.get('claim_email') ?? '')
      .trim()
      .toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > LIMITS.email) {
      return Astro.redirect('/join?err=claim_email', 303);
    }
    const handle = session.handle ?? session.username;
    const result = await requestDiscordLink(env.DB, email, session.discordId, handle, now);
    // Matched or not, the same answer: nobody learns whether an email is
    // in the register. Only a real match reaches the board.
    if (result === 'requested') {
      notify(linkRequestNotice({ handle, url: `${Astro.url.origin}/register` }));
    }
    return Astro.redirect('/join?ok=claim', 303);
  } else if (intent === 'apply') {
    for (const name of [
      'full_name',
      'domicile',
      'email',
      'student_status',
      'union_member',
      'telegram',
      'discord_name',
      'games_other',
      'message',
    ]) {
      values[name] = String(form.get(name) ?? '');
    }
    pickedGames = form.getAll('games').map(String);
    wantsActive = form.get('wants_active') === 'on';

    if (String(form.get('website') ?? '') !== '') {
      // Honeypot: no human sees that field. Pretend it worked.
      return Astro.redirect('/join?ok=1', 303);
    }
    const parsed = parseApplication(form, true);
    if (!parsed.ok) {
      errors = parsed.errors;
    } else {
      // A signed-in applicant's Discord identity comes from the session,
      // never from the form.
      const input = session
        ? { ...parsed.value, discord_name: session.handle ?? session.username }
        : parsed.value;
      try {
        await applyForMembership(env.DB, input, session?.discordId ?? null, now);
      } catch (error) {
        // A duplicate email gets the same "thanks" as a new application:
        // telling the sender would let anyone test whether an address is
        // in the register. The earlier entry stands; nothing is announced.
        if (error instanceof RuleError && error.code === 'duplicate') {
          return Astro.redirect('/join?ok=1', 303);
        }
        throw error;
      }
      notify(
        applicationNotice({
          name: input.full_name,
          studentStatus: STUDENT_STATUS_LABELS[input.student_status],
          url: `${Astro.url.origin}/register`,
        }),
      );
      return Astro.redirect('/join?ok=1', 303);
    }
  }
  if (problem === null && errors.length === 0) return Astro.redirect('/join', 303);
  Astro.response.status = 422;
}

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const submitted = ok === '1';
const NOTES: Record<string, string> = {
  claim:
    'Thanks. If that email matches an entry, the board will confirm the link and this page will then show your membership. Nothing else to do.',
  claim_email: "That email address doesn't look right.",
};
const note = NOTES[ok ?? err ?? ''] ?? null;
const bad = (field: FieldError) => (errors.includes(field) ? 'field-error' : undefined);
const FIELD_MESSAGES: Record<FieldError, string> = {
  full_name: 'Your full name, 2 to 100 characters.',
  domicile: 'Your home municipality is required (the Associations Act asks for it).',
  email: 'That email address does not look right.',
  student_status: 'Pick where you study.',
  union_member: 'Pick your student union, or Neither.',
  telegram: 'That Telegram handle is too long.',
  discord_name: 'That Discord name is too long.',
  games: 'The "other games" text is too long.',
  message: 'The message is too long (500 characters).',
  consent: 'The application needs your permission to store the information.',
};
---
<Base
  title="Become a member"
  description="Join Lahti Association of Gaming LAG ry. Membership is free and open to higher education students in Lahti."
>
  <article class="prose">
    <h1>Become a member</h1>
    {!submitted && (
      <p>
        Membership is <strong>free</strong>. Higher education students in Lahti are eligible to join
        Lahti Association of Gaming LAG ry; alumni and friends of the association are welcome too.
        The board approves applications.
      </p>
    )}
  </article>

  {note && <p class="flash">{note}</p>}

  {submitted && (
    <>
      <p class="flash">
        Thanks! Your application is in. The board reviews applications and you'll be counted in
        once it's approved. No email is sent; if you signed in with Discord, this page will show
        your status. If you had already applied with the same email, your earlier application
        stands and nothing changed.
      </p>
      <p><a class="btn btn-primary" href="/events">See what's coming up</a></p>
    </>
  )}

  {!submitted && (
    <>
      <div class="paths">
        <section class="path-card path-new">
          <h2>New here?</h2>
          <p>
            Fill in the application below. Full name and home municipality are what Finnish law
            asks an association to keep; the rest helps us plan events.
            {' '}<a href="/privacy">What we store and why.</a>
          </p>
          {session ? (
            <p>Signed in as <strong>{session.username}</strong>: your Discord account is linked to the application from the start.</p>
          ) : (
            <p>
              <strong>Sign in with Discord first</strong> if you're on our server: your account is then
              linked from the start, for the member price at events and your own membership page.
            </p>
          )}
          <p class="entry-actions">
            {!session && <a class="btn btn-primary" href="/login?next=/join">Sign in, then apply</a>}
            <a class={session ? 'btn btn-cta' : 'btn btn-ghost'} href="#apply">{session ? 'Apply for membership' : 'Apply without signing in'}</a>
          </p>
        </section>

        <section class="path-card">
          <h2>Already a member?</h2>
          {!session && (
            <>
              <p>
                Sign in with Discord to link your account to your membership. Then you can manage
                your actives status here and get the member mark at events.
              </p>
              <a class="btn btn-primary" href="/login?next=/join">Sign in with Discord</a>
            </>
          )}
          {session && pendingLink && (
            <p>
              Signed in as <strong>{session.username}</strong>. Your request to link this account is
              waiting for the board. Once confirmed, this page shows your membership.
            </p>
          )}
          {session && !pendingLink && (
            <>
              <p>
                Signed in as <strong>{session.username}</strong>. Enter the email you registered with
                and the board links this Discord account to your membership.
              </p>
              <form method="post" action="/join" class="app-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="intent" value="claim" />
                <label>
                  Registered email
                  <input name="claim_email" type="email" required maxlength={LIMITS.email} />
                </label>
                <button class="btn btn-primary" type="submit">Link my Discord account</button>
              </form>
            </>
          )}
        </section>
      </div>

      <article class="prose apply-heading" id="apply">
        <h2>Membership application</h2>
        {session && (
          <p class="queue-meta">
            Signed in as <strong>{session.username}</strong>: this Discord account will be linked to
            your membership.
          </p>
        )}
      </article>

      {problem === 'csrf' && <p class="flash">The form was stale. Please send it again.</p>}
      {errors.length > 0 && (
        <ul class="flash flash-list">
          {errors.map((field) => <li>{FIELD_MESSAGES[field]}</li>)}
        </ul>
      )}
      <form method="post" action="/join" class="app-form join-form" novalidate>
        <input type="hidden" name="csrf" value={csrf} />
        <input type="hidden" name="intent" value="apply" />
        <div class="hp" aria-hidden="true">
          <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="form-grid">
          <label class={bad('full_name')}>
            Full name *
            <input name="full_name" required maxlength={LIMITS.full_name} autocomplete="name" value={values.full_name ?? ''} />
          </label>
          <label class={bad('domicile')}>
            Home municipality (kotikunta) *
            <input name="domicile" required maxlength={LIMITS.domicile} placeholder="Lahti" value={values.domicile ?? ''} />
          </label>
          <label class={bad('email')}>
            Email *
            <input name="email" type="email" required maxlength={LIMITS.email} autocomplete="email" value={values.email ?? ''} />
          </label>
          <label class={bad('student_status')}>
            I study at *
            <select name="student_status" required>
              <option value="" selected={!values.student_status}>Choose…</option>
              {STUDENT_STATUSES.map((s) => (
                <option value={s} selected={values.student_status === s}>{STUDENT_STATUS_LABELS[s]}</option>
              ))}
            </select>
          </label>
          <label class={bad('union_member')}>
            Student union *
            <select name="union_member" required>
              <option value="" selected={!values.union_member}>Choose…</option>
              {UNIONS.map((u) => (
                <option value={u} selected={values.union_member === u}>{UNION_LABELS[u]}</option>
              ))}
            </select>
          </label>
          <label class={bad('discord_name')}>
            Discord username
            {session ? (
              <input name="discord_name" value={session.handle ?? session.username} readonly />
            ) : (
              <input name="discord_name" maxlength={LIMITS.discord_name} placeholder="optional" value={values.discord_name ?? ''} />
            )}
          </label>
          <label class={bad('telegram')}>
            Telegram username
            <input name="telegram" maxlength={LIMITS.telegram} placeholder="optional, @handle" value={values.telegram ?? ''} />
          </label>
        </div>

        <fieldset class="checkbox-grid">
          <legend>I'm interested in</legend>
          {GAMES.map((game) => (
            <label class="check">
              <input type="checkbox" name="games" value={game} checked={pickedGames.includes(game)} /> {game}
            </label>
          ))}
          <label class={`check-other ${bad('games') ?? ''}`}>
            Other
            <input name="games_other" maxlength={LIMITS.games_other} placeholder="anything else" value={values.games_other ?? ''} />
          </label>
        </fieldset>

        <label class="check check-standalone">
          <input type="checkbox" name="wants_active" checked={wantsActive} />
          <span>
            <strong>I want to be an active.</strong> Actives hear about event ideas, planning and
            meetings first, in the actives channel on Discord. The board approves actives. It commits
            you to nothing.
          </span>
        </label>

        <label class={bad('message')}>
          Questions or a message to the board
          <textarea name="message" rows="3" maxlength={LIMITS.message}>{values.message ?? ''}</textarea>
        </label>

        <label class={`check check-standalone ${bad('consent') ?? ''}`}>
          <input type="checkbox" name="consent" required />
          <span>
            I allow an authorized member of the board of Lahti Association of Gaming LAG ry to
            handle my information according to the <a href="/privacy">privacy policy</a>. *
          </span>
        </label>

        <button class="btn btn-cta" type="submit">Send application</button>
      </form>
    </>
  )}
</Base>
