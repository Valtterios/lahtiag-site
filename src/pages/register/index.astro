---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import RegisterToolbar from '../../components/RegisterToolbar.astro';
import BoardGate from '../../components/BoardGate.astro';
import { ensureCsrf } from '../../lib/guard';
import { requireBoard, boardStatus } from '../../lib/board';
import {
  listRegister,
  registerCounts,
  registerStats,
  listLinkRequests,
  listActiveRequests,
  listHousekeeping,
  findSimilarEntries,
  HOUSEKEEPING,
  type RegisterRow,
} from '../../lib/db';
import { rolesConfigured, loadRoleConfig, planRoles, type RolePlan } from '../../lib/roles';
import { listGuildRoles, type GuildRole } from '../../lib/discord';
import { DISCORD_GUILD_ID } from '../../lib/config';
import {
  STUDENT_STATUSES,
  STUDENT_STATUS_LABELS,
  MEMBER_TYPES,
  MEMBER_TYPE_LABELS,
  eligibilityWarning,
  sameHandle,
  type RegisterStatus,
} from '../../lib/register';
import { formatHelsinkiDate } from '../../lib/time';

// The board's member register. Top to bottom: what needs a decision
// (applications, link requests, housekeeping), then the list with search
// and a status filter, then the numbers for the annual report. Behind the
// Google step-up (board.ts): the page is full of personal data.

const board = await requireBoard(Astro.request, env);
Astro.response.status = boardStatus(board);
const csrf = ensureCsrf(Astro.cookies);
const now = Math.floor(Date.now() / 1000);

type View = 'all' | RegisterStatus | 'actives';
const VIEWS: { key: View; label: string }[] = [
  { key: 'all', label: 'All' },
  { key: 'member', label: 'Members' },
  { key: 'pending', label: 'Pending' },
  { key: 'former', label: 'Former' },
  { key: 'actives', label: 'Actives' },
];
const viewParam = Astro.url.searchParams.get('view') ?? 'all';
const view: View = VIEWS.some((v) => v.key === viewParam) ? (viewParam as View) : 'all';
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const filter = view === 'actives' ? { status: 'member' as const, activesOnly: true } : { status: view };

const [counts, stats, rows, linkRequests, activeRequests, housekeeping] = board.ok
  ? await Promise.all([
      registerCounts(env.DB),
      registerStats(env.DB),
      listRegister(env.DB, { ...filter, q }),
      view === 'all' ? listLinkRequests(env.DB) : Promise.resolve([] as RegisterRow[]),
      view === 'all' || view === 'actives' ? listActiveRequests(env.DB) : Promise.resolve([] as RegisterRow[]),
      view === 'all' && !q ? listHousekeeping(env.DB, now) : Promise.resolve([] as RegisterRow[]),
    ])
  : [null, null, [], [], [], []];
const roleCfg = board.ok ? await loadRoleConfig(env, env.DB) : {};
const rolesOn = rolesConfigured(roleCfg);
// The server's roles for the picker: only fetched for people who can see
// the page, and only when a token exists to fetch them with.
const guildRoles: GuildRole[] | null =
  board.ok && env.DISCORD_BOT_TOKEN ? await listGuildRoles(env.DISCORD_BOT_TOKEN, DISCORD_GUILD_ID) : null;
// What Sync would change, shown before the button so the board can see
// whether the bot is able to read the server and what it would touch.
const rolePlan: RolePlan | null = board.ok && rolesOn ? await planRoles(roleCfg, env.DB) : null;
const roleName = (id: string) => guildRoles?.find((r) => r.id === id)?.name ?? id;
const linkedNames = new Map<string, string>();
if (rolePlan?.ok && rolePlan.changes.length > 0) {
  const ids = [...new Set(rolePlan.changes.map((c) => c.discordId))].slice(0, 40);
  const { results } = await env.DB
    .prepare(`SELECT discord_id, full_name FROM register WHERE discord_id IN (${ids.map(() => '?').join(',')})`)
    .bind(...ids)
    .all<{ discord_id: string; full_name: string }>();
  for (const r of results) linkedNames.set(r.discord_id, r.full_name);
  const { results: cached } = await env.DB
    .prepare(`SELECT discord_id, username FROM members WHERE discord_id IN (${ids.map(() => '?').join(',')})`)
    .bind(...ids)
    .all<{ discord_id: string; username: string }>();
  for (const r of cached) if (!linkedNames.has(r.discord_id)) linkedNames.set(r.discord_id, r.username);
}
const whoIs = (id: string) => linkedNames.get(id) ?? `Discord id ${id}`;

const pending = view === 'all' || view === 'pending' ? rows.filter((r) => r.status === 'pending') : [];
const hints = new Map<number, { warning: string | null; similar: RegisterRow[] }>();
if (board.ok) {
  for (const r of pending.slice(0, 20)) {
    hints.set(r.id, { warning: eligibilityWarning(r), similar: await findSimilarEntries(env.DB, r) });
  }
}
const stale = new Set(housekeeping.map((r) => r.id));

const FLASH: Record<string, string> = {
  approved: 'Application approved. Welcome them!',
  rejected: 'Application rejected and its data deleted.',
  saved: 'Entry saved.',
  created: 'Entry added.',
  former: 'Marked as a former member.',
  member: 'Membership reinstated.',
  erased: 'Entry erased from the register.',
  linked: 'Discord account linked. They can manage their actives status on the join page now.',
  link_dismissed: 'Link request dismissed.',
  active_approve: 'Approved as an active.',
  active_revoke: 'No longer an active.',
  synced: 'Discord roles synced.',
  roles_saved: 'Role choice saved. Click Sync Discord roles to apply it to everyone.',
  bad_role: 'Pick roles from the list.',
  roles_unconfigured: 'Discord roles are not configured: set the bot token and pick the roles below.',
  roles_intent: 'The bot cannot list the server\'s members: turn on Server Members Intent in the Developer Portal (Bot tab), then try again.',
  roles_error: "Discord didn't answer. Try again in a moment.",
  roles_discord: "Discord didn't answer. Try again in a moment.",
  missing: 'That entry no longer exists.',
  duplicate: 'Another entry already uses that email or Discord account.',
  bad_input: "The entry couldn't be saved from those values.",
  unauthenticated: 'Sign in with your Google account first.',
  unconfigured: 'Register access is not configured on this deployment.',
  csrf: 'The form was stale. Try again.',
};
const okKey = Astro.url.searchParams.get('ok');
let flash: string | null = FLASH[okKey ?? Astro.url.searchParams.get("err") ?? ""] ?? null;
if (okKey === 'synced') {
  const p = Astro.url.searchParams;
  const planned = Number(p.get('planned'));
  flash = planned === 0
    ? 'Discord roles already match the register. Nothing to change.'
    : `Discord roles synced: ${p.get('applied')} of ${planned} changes applied` +
      (Number(p.get('forbidden')) > 0
        ? `, ${p.get('forbidden')} refused by Discord: in Server Settings → Roles drag the bot's role above the Member and Actives roles, then sync again`
        : '') +
      (Number(p.get('failed')) > 0 ? `, ${p.get('failed')} failed (Discord error)` : '') +
      (Number(p.get('remaining')) > 0 ? `, ${p.get('remaining')} left: click again.` : '.');
}
if (Astro.url.searchParams.get('roles') === 'failed') {
  flash = `${flash ?? ''} The Discord role could not be set: check the bot's permissions and role order, then use Sync.`.trim();
}
// Notices about the roles themselves belong next to the roles controls,
// not at the top of the page.
const errKey = Astro.url.searchParams.get('err') ?? '';
const rolesFlash = okKey === 'synced' || okKey === 'roles_saved' || errKey.startsWith('roles_') || errKey === 'bad_role' ? flash : null;
if (rolesFlash) flash = null;

const viewHref = (key: View) => `/register?view=${key}${q ? `&q=${encodeURIComponent(q)}` : ''}`;
const since = (r: RegisterRow) =>
  formatHelsinkiDate(r.status === 'pending' ? r.applied_at : (r.decided_at ?? r.applied_at));
const days = (t: number) => Math.floor((now - t) / 86400);
---
<Base title="Member register" description="Board-only member register of Lahti Association of Gaming LAG ry." wide>
  {!board.ok ? (
    <BoardGate check={board} />
  ) : (
    <>
      <RegisterToolbar email={board.email} csrf={csrf} current="register" />
      <article class="prose"><h1>Member register</h1></article>
      {flash && <p class="flash">{flash}</p>}

      <ul class="stat-tiles">
        <li><a href={viewHref('member')}><strong>{counts!.member}</strong><span>Members</span></a></li>
        <li class={counts!.pending > 0 ? 'stat-attention' : ''}><a href={viewHref('pending')}><strong>{counts!.pending}</strong><span>Pending</span></a></li>
        <li><a href={viewHref('actives')}><strong>{stats!.actives}</strong><span>Actives</span></a></li>
        <li><a href={viewHref('former')}><strong>{counts!.former}</strong><span>Former</span></a></li>
      </ul>

      {pending.length > 0 && (
        <section class="queue">
          <h2 class="section-label">Waiting for a decision</h2>
          {pending.map((r) => {
            const hint = hints.get(r.id);
            return (
              <div class="queue-card">
                <div class="queue-body">
                  <p class="queue-name"><a href={`/register/${r.id}`}>{r.full_name}</a></p>
                  <p class="queue-meta">
                    {r.domicile} · {STUDENT_STATUS_LABELS[r.student_status]}
                    {r.union_member !== 'none' && <>, {r.union_member}</>}
                    {' · '}{MEMBER_TYPE_LABELS[r.member_type].toLowerCase()} on approval
                    {' · '}applied {formatHelsinkiDate(r.applied_at)}
                  </p>
                  <p class="queue-meta">
                    {r.email}
                    {r.discord_name && <> · Discord {r.discord_name}{r.discord_id ? ' (linked)' : ''}</>}
                    {r.telegram && <> · Telegram @{r.telegram}</>}
                    {r.wants_active ? ' · wants to be an active' : ''}
                  </p>
                  {r.games && <p class="queue-meta">Plays: {r.games}</p>}
                  {r.message && <p class="queue-message">“{r.message}”</p>}
                  {hint?.warning && <p class="warn-tag">{hint.warning}</p>}
                  {hint && hint.similar.length > 0 && (
                    <p class="warn-tag warn-soft">
                      Might already be in the register:{' '}
                      {hint.similar.map((s, i) => (
                        <>{i > 0 && ', '}<a href={`/register/${s.id}`}>{s.full_name}</a> ({s.status})</>
                      ))}
                    </p>
                  )}
                </div>
                <form method="post" action={`/register/${r.id}/action`} class="queue-actions">
                  <input type="hidden" name="csrf" value={csrf} />
                  <button class="btn btn-primary" name="action" value="approve" type="submit">Approve</button>
                  <button class="btn btn-ghost" name="action" value="reject" type="submit">Reject</button>
                </form>
              </div>
            );
          })}
        </section>
      )}

      {linkRequests.length > 0 && (
        <section class="queue">
          <h2 class="section-label">Discord link requests</h2>
          {linkRequests.map((r) => (
            <div class="queue-card">
              <div class="queue-body">
                <p class="queue-name"><a href={`/register/${r.id}`}>{r.full_name}</a></p>
                <p class="queue-meta">
                  Discord user <strong>{r.link_discord_name}</strong> says this entry is theirs.
                  The entry says: <strong>{r.discord_name ?? 'no Discord name'}</strong>.
                  {' '}Asked {formatHelsinkiDate(r.link_requested_at ?? r.updated_at)}.
                </p>
                {sameHandle(r.discord_name, r.link_discord_name) ? (
                  <p class="match-tag">Names match</p>
                ) : (
                  <p class="warn-tag warn-soft">
                    {r.discord_name ? 'Names differ: confirm only if you know this is the same person.' : 'The entry has no Discord name to compare: confirm only if you know the person.'}
                  </p>
                )}
              </div>
              <form method="post" action={`/register/${r.id}/action`} class="queue-actions">
                <input type="hidden" name="csrf" value={csrf} />
                <button class="btn btn-primary" name="action" value="link_confirm" type="submit">Confirm link</button>
                <button class="btn btn-ghost" name="action" value="link_dismiss" type="submit">Dismiss</button>
              </form>
            </div>
          ))}
        </section>
      )}

      {activeRequests.length > 0 && (
        <section class="queue">
          <h2 class="section-label">Actives requests</h2>
          <p class="queue-intro">
            Members who asked to be an active. Approving gives them the Actives role on Discord
            {rolesOn ? '' : ' (once roles are configured)'}; declining clears the request.
          </p>
          {activeRequests.map((r) => (
            <div class="queue-card">
              <div class="queue-body">
                <p class="queue-name"><a href={`/register/${r.id}`}>{r.full_name}</a></p>
                <p class="queue-meta">
                  {STUDENT_STATUS_LABELS[r.student_status]}
                  {r.discord_name && <> · Discord {r.discord_name}{r.discord_id ? ' (linked)' : ' (not linked: no role until they link)'}</>}
                  {!r.discord_name && <> · no Discord account linked</>}
                  {r.telegram && <> · Telegram @{r.telegram}</>}
                </p>
              </div>
              <form method="post" action={`/register/${r.id}/action`} class="queue-actions">
                <input type="hidden" name="csrf" value={csrf} />
                <button class="btn btn-primary" name="action" value="active_approve" type="submit">Approve as active</button>
                <button class="btn btn-ghost" name="action" value="active_revoke" type="submit">Decline</button>
              </form>
            </div>
          ))}
        </section>
      )}

      {housekeeping.length > 0 && (
        <section class="queue">
          <h2 class="section-label">Housekeeping</h2>
          <p class="queue-intro">
            Applications older than {HOUSEKEEPING.pendingAfterDays} days and former members after
            {' '}{Math.round(HOUSEKEEPING.formerAfterDays / 365)} years. Nothing is deleted on its own.
          </p>
          {housekeeping.map((r) => (
            <div class="queue-card queue-quiet">
              <div class="queue-body">
                <p class="queue-name"><a href={`/register/${r.id}`}>{r.full_name}</a></p>
                <p class="queue-meta">
                  {r.status === 'pending'
                    ? `Application from ${days(r.applied_at)} days ago, never decided.`
                    : `Former member since ${formatHelsinkiDate(r.updated_at)}.`}
                </p>
              </div>
              <form method="post" action={`/register/${r.id}/action`} class="queue-actions">
                <input type="hidden" name="csrf" value={csrf} />
                {r.status === 'pending' && (
                  <button class="btn btn-ghost" name="action" value="approve" type="submit">Approve</button>
                )}
                <button class="btn btn-danger" name="action" value={r.status === 'pending' ? 'reject' : 'erase'} type="submit">
                  {r.status === 'pending' ? 'Reject' : 'Erase'}
                </button>
              </form>
            </div>
          ))}
        </section>
      )}

      <section class="list">
        <form method="get" action="/register" class="register-search">
          <input type="hidden" name="view" value={view} />
          <input type="search" name="q" value={q} placeholder="Search by name, email, Discord or Telegram" aria-label="Search the register" />
          <button class="btn btn-primary" type="submit">Search</button>
        </form>
        <nav class="segmented" aria-label="Filter">
          {VIEWS.map((v) => (
            <a href={viewHref(v.key)} aria-current={view === v.key ? 'page' : undefined}>{v.label}</a>
          ))}
        </nav>

        {rows.length === 0 ? (
          <p class="app-empty">Nothing matches.</p>
        ) : (
          <div class="table-scroll">
            <table class="register-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Class</th>
                  <th>Studies</th>
                  <th>Discord</th>
                  <th>Active</th>
                  <th>Since</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr class={stale.has(r.id) ? 'row-stale' : undefined}>
                    <td><a href={`/register/${r.id}`}>{r.full_name}</a></td>
                    <td>{r.email}</td>
                    <td>{r.member_type}</td>
                    <td>{r.student_status}</td>
                    <td>{r.discord_name ?? ''}{r.discord_id && <span class="linked-mark" title="Discord account linked">linked</span>}</td>
                    <td>{r.wants_active ? 'yes' : ''}</td>
                    <td>{since(r)}</td>
                    <td><span class={`status-badge status-${r.status}`}>{r.status}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section class="roles" id="roles">
        <h2 class="section-label">Discord roles</h2>
        {!env.DISCORD_BOT_TOKEN && (
          <p class="queue-intro">
            The bot token is not set on this deployment, so no roles are given. See
            docs/register-access-setup.md, step 9.
          </p>
        )}
        {env.DISCORD_BOT_TOKEN && guildRoles === null && (
          <p class="warn-tag">
            The bot can't read the server's roles. Check that it was invited to the LahtiAG server
            with Manage Roles (setup guide, step 9.2) and that the token is current.
          </p>
        )}
        {rolesFlash && <p class="flash">{rolesFlash}</p>}
        {guildRoles && (
          <div class="queue-card queue-quiet">
            <div class="queue-body">
              <p class="queue-meta">
                Bot connected. Linked members get the Member role, approved actives the Actives role,
                as decisions are made here. The bot's own role must sit above both in Server Settings
                → Roles. Sync puts everyone right if something drifted.
              </p>
              <form method="post" action="/register/roles-config" class="role-picker">
                <input type="hidden" name="csrf" value={csrf} />
                <label>
                  Member role
                  <select name="member_role_id">
                    <option value="" selected={!roleCfg.MEMBER_ROLE_ID}>not used</option>
                    {guildRoles.filter((r) => !r.managed).map((r) => (
                      <option value={r.id} selected={roleCfg.MEMBER_ROLE_ID === r.id}>{r.name}</option>
                    ))}
                  </select>
                </label>
                <label>
                  Actives role
                  <select name="actives_role_id">
                    <option value="" selected={!roleCfg.ACTIVES_ROLE_ID}>not used</option>
                    {guildRoles.filter((r) => !r.managed).map((r) => (
                      <option value={r.id} selected={roleCfg.ACTIVES_ROLE_ID === r.id}>{r.name}</option>
                    ))}
                  </select>
                </label>
                <button class="btn btn-ghost" type="submit">Save roles</button>
              </form>
              {rolePlan && !rolePlan.ok && rolePlan.reason === 'intent' && (
                <p class="warn-tag">
                  The bot can't list the server's members, so Sync can't work yet: Developer Portal →
                  the application → Bot → Privileged Gateway Intents → turn on <strong>Server Members
                  Intent</strong>, save, then reload this page.
                </p>
              )}
              {rolePlan && !rolePlan.ok && rolePlan.reason === 'error' && (
                <p class="warn-tag warn-soft">Discord didn't answer while reading the member list. Reload in a moment.</p>
              )}
              {rolePlan?.ok && (
                <div class="role-plan">
                  {rolePlan.changes.length === 0 ? (
                    <p class="match-tag">Discord roles match the register. Nothing to sync.</p>
                  ) : (
                    <>
                      <p class="queue-intro">
                        Sync would make {rolePlan.changes.length} change{rolePlan.changes.length === 1 ? '' : 's'}
                        {rolePlan.changes.length > 40 ? ' (40 per click)' : ''}:
                      </p>
                      <ul class="role-plan-list">
                        {rolePlan.changes.slice(0, 40).map((c) => (
                          <li>
                            <span class={c.on ? 'plan-add' : 'plan-remove'}>{c.on ? 'give' : 'remove'}</span>
                            {' '}<strong>{roleName(c.roleId)}</strong> {c.on ? 'to' : 'from'} {whoIs(c.discordId)}
                          </li>
                        ))}
                        {rolePlan.changes.length > 40 && <li class="queue-meta">and {rolePlan.changes.length - 40} more.</li>}
                      </ul>
                    </>
                  )}
                </div>
              )}
            </div>
            {rolesOn && rolePlan?.ok && rolePlan.changes.length > 0 && (
              <form method="post" action="/register/sync-roles" class="queue-actions">
                <input type="hidden" name="csrf" value={csrf} />
                <button class="btn btn-primary" type="submit">Sync Discord roles</button>
              </form>
            )}
          </div>
        )}
      </section>

      <section class="numbers">
        <h2 class="section-label">Numbers for the annual report</h2>
        <p class="queue-intro">Current members only.</p>
        <div class="numbers-grid">
          <table>
            <caption>By class</caption>
            <tbody>
              {MEMBER_TYPES.map((k) => (
                <tr><th>{MEMBER_TYPE_LABELS[k]}</th><td>{stats!.membersByType[k]}</td></tr>
              ))}
            </tbody>
          </table>
          <table>
            <caption>By school</caption>
            <tbody>
              {STUDENT_STATUSES.map((k) => (
                <tr><th>{STUDENT_STATUS_LABELS[k]}</th><td>{stats!.membersBySchool[k]}</td></tr>
              ))}
            </tbody>
          </table>
          <table>
            <caption>Joined per year</caption>
            <tbody>
              {stats!.joinedByYear.length === 0 && <tr><th>None yet</th><td></td></tr>}
              {stats!.joinedByYear.map((row) => (
                <tr><th>{row.year}</th><td>{row.n}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}
</Base>
