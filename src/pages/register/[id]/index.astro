---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import RegisterToolbar from '../../../components/RegisterToolbar.astro';
import BoardGate from '../../../components/BoardGate.astro';
import { ensureCsrf, currentSession } from '../../../lib/guard';
import { requireBoard, boardStatus } from '../../../lib/board';
import { getRegisterEntry, findSimilarEntries } from '../../../lib/db';
import {
  GAMES,
  STUDENT_STATUSES,
  STUDENT_STATUS_LABELS,
  UNIONS,
  UNION_LABELS,
  MEMBER_TYPES,
  MEMBER_TYPE_LABELS,
  LIMITS,
  sameHandle,
} from '../../../lib/register';
import { formatHelsinkiDate } from '../../../lib/time';

// One register entry: the decision buttons on top, everything the person
// supplied below, editable by the board, and erasure at the very end.

const board = await requireBoard(Astro.request, env);
Astro.response.status = boardStatus(board);
const discordSession = board.ok ? null : await currentSession(Astro.request, env);
const csrf = ensureCsrf(Astro.cookies);
const id = Number(Astro.params.id);
const entry = board.ok && Number.isInteger(id) ? await getRegisterEntry(env.DB, id) : null;
if (board.ok && !entry) Astro.response.status = 404;

const similar = entry && entry.status === 'pending' ? await findSimilarEntries(env.DB, entry) : [];

const gamesList = entry?.games ? entry.games.split(',').map((g) => g.trim()) : [];
const knownGames = gamesList.filter((g) => (GAMES as readonly string[]).includes(g));
const otherGames = gamesList.filter((g) => !(GAMES as readonly string[]).includes(g)).join(', ');

const FLASH: Record<string, string> = {
  saved: 'Entry saved.',
  created: 'Entry added.',
  merged: 'Application merged into this entry.',
  linked: 'Discord account linked.',
  link_dismissed: 'Link request dismissed.',
  former: 'Marked as a former member.',
  member: 'Membership reinstated.',
  approved: 'Application approved.',
  fix_asked: 'Asked, and sent to them on Discord. The entry stays in the queue until they answer.',
  fix_saved: "Saved. They have no Discord account linked, so nobody has told them yet — their email is above.",
  fix_cleared: 'The request is withdrawn.',
  active_approve: 'Approved as an active.',
  active_revoke: 'No longer an active.',
  duplicate: 'Another entry already uses that email or Discord account.',
  bad_input: "The entry couldn't be saved from those values. Check the required fields.",
  missing: 'That action no longer applies to this entry.',
  unauthenticated: 'Sign in with your Google account first.',
  csrf: 'The form was stale. Try again.',
};
let flash =
  FLASH[Astro.url.searchParams.get('ok') ?? Astro.url.searchParams.get('err') ?? ''] ?? null;
if (Astro.url.searchParams.get('roles') === 'failed') {
  flash = `${flash ?? ''} The Discord role could not be set: check the bot's permissions and role order, then use Sync on the register.`.trim();
}
const SOURCE: Record<string, string> = {
  web: 'applied on the site',
  import: 'from the old sheet',
  board: 'added by the board',
};
---
<Base title={entry ? entry.full_name : 'Register entry'} description="Board-only member register entry." wide>
  {!board.ok ? (
    <BoardGate check={board} session={discordSession} />
  ) : !entry ? (
    <>
      <RegisterToolbar email={board.email} csrf={csrf} current="register" />
      <article class="prose">
        <h1>No such entry</h1>
        <p>Nothing lives at this id.</p>
        <p><a class="btn btn-primary" href="/register">Back to the register</a></p>
      </article>
    </>
  ) : (
    <>
      <RegisterToolbar email={board.email} csrf={csrf} current="register" />
      <article class="prose entry-head">
        <h1>{entry.full_name}</h1>
        <p class="entry-badges">
          {entry.status === 'member' && <span class="status-badge status-member">{MEMBER_TYPE_LABELS[entry.member_type]}</span>}
          {entry.status === 'pending' && <span class="status-badge status-pending">Pending application</span>}
          {entry.fix_note !== null && <span class="status-badge status-pending">waiting on the applicant</span>}
          {entry.status === 'former' && <span class="status-badge status-former">Former member</span>}
          {entry.discord_id && <span class="status-badge">Discord linked</span>}
          {entry.founder && <span class="status-badge status-member">founder</span>}
          {entry.is_active && <span class="status-badge status-member">active</span>}
          {!entry.is_active && entry.wants_active && <span class="status-badge status-pending">asked to be an active</span>}
        </p>
        <p class="queue-meta">
          {SOURCE[entry.source]} {formatHelsinkiDate(entry.applied_at)}
          {entry.decided_at !== null && (
            <>, decided {formatHelsinkiDate(entry.decided_at)}{entry.decided_by ? ` by ${entry.decided_by}` : ''}</>
          )}
        </p>
      </article>
      {flash && <p class="flash">{flash}</p>}
      {similar.length > 0 && (
        <div class="warn-tag warn-soft similar-box">
          <p>Might already be in the register:</p>
          <ul class="similar-list">
            {similar.map((s) => (
              <li>
                <a href={`/register/${s.entry.id}`}>{s.entry.full_name}</a> ({s.entry.status}) · <em>{s.reasons.join(', ')}</em>
                <form method="post" action={`/register/${entry.id}/action`} class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="action" value="merge" />
                  <input type="hidden" name="target" value={s.entry.id} />
                  <button class="btn btn-ghost btn-sm" type="submit" data-confirm="Merge this application into the chosen entry and delete this application?">Merge into this entry</button>
                </form>
              </li>
            ))}
          </ul>
          <p class="queue-meta">Merging keeps the existing entry, carries over what this application added, and deletes this application.</p>
        </div>
      )}

      {entry.link_discord_id !== null && (
        <div class="queue-card">
          <div class="queue-body">
            <p class="queue-name">Discord link request</p>
            <p class="queue-meta">
              Discord user <strong>{entry.link_discord_name}</strong> says this entry is theirs. The
              entry says: <strong>{entry.discord_name ?? 'no Discord name'}</strong>.
            </p>
            {sameHandle(entry.discord_name, entry.link_discord_name) ? (
              <p class="match-tag">Names match</p>
            ) : (
              <p class="warn-tag warn-soft">Names differ: confirm only if you know this is the same person.</p>
            )}
          </div>
          <form method="post" action={`/register/${entry.id}/action`} class="queue-actions">
            <input type="hidden" name="csrf" value={csrf} />
            <button class="btn btn-primary" name="action" value="link_confirm" type="submit">Confirm link</button>
            <button class="btn btn-ghost" name="action" value="link_dismiss" type="submit">Dismiss</button>
          </form>
        </div>
      )}

      {entry.status === 'pending' && (
        <section class="entry-fix">
          <h2 class="section-label">Ask them to put something right</h2>
          {entry.fix_note !== null ? (
            <>
              <p class="queue-intro">
                Asked {entry.fix_asked_at !== null ? formatHelsinkiDate(entry.fix_asked_at) : ''}{entry.fix_asked_by ? ` by ${entry.fix_asked_by}` : ''}. It shows on their own
                membership page beside the form that answers it, and clears itself when they save their details.
              </p>
              <blockquote class="entry-fix-note">{entry.fix_note}</blockquote>
              <form method="post" action={`/register/${entry.id}/action`} class="entry-actions">
                <input type="hidden" name="csrf" value={csrf} />
                <button class="btn btn-ghost btn-sm" name="action" value="fix_clear" type="submit">Withdraw the request</button>
              </form>
            </>
          ) : (
            <>
              <p class="queue-intro">
                For an application that is nearly right — a first name where the association needs the full one, an
                address with a typo. The application stays in the queue; they get this on Discord if their account is
                linked, and see it on their membership page either way.
              </p>
              <form method="post" action={`/register/${entry.id}/action`} class="app-form">
                <input type="hidden" name="csrf" value={csrf} />
                <label>
                  What needs fixing (they read this)
                  <textarea name="fix_note" rows="2" maxlength="400" required placeholder="The association needs your full name, first and last — could you add your surname?"></textarea>
                </label>
                <button class="btn btn-ghost" name="action" value="fix" type="submit">Ask for a correction</button>
              </form>
            </>
          )}
        </section>
      )}

      <form method="post" action={`/register/${entry.id}/action`} class="entry-actions">
        <input type="hidden" name="csrf" value={csrf} />
        {entry.status === 'pending' && (
          <>
            <button class="btn btn-primary" name="action" value="approve" type="submit">Approve membership</button>
            <button class="btn btn-ghost" name="action" value="reject" type="submit" data-confirm="Reject this application? Its data is deleted.">Reject and delete</button>
          </>
        )}
        {entry.status === 'member' && !entry.is_active && (
          <button class="btn btn-primary" name="action" value="active_approve" type="submit">
            {entry.wants_active ? 'Approve as active' : 'Make an active'}
          </button>
        )}
        {entry.status === 'member' && entry.is_active && (
          <button class="btn btn-ghost" name="action" value="active_revoke" type="submit" data-confirm="Remove from the actives and take the Discord role away?">Remove from actives</button>
        )}
        {entry.status === 'member' && (
          <button class="btn btn-ghost" name="action" value="former" type="submit" data-confirm="End this membership? The entry stays and can be reinstated.">Mark as former member</button>
        )}
        {entry.status === 'former' && (
          <button class="btn btn-primary" name="action" value="member" type="submit">Reinstate membership</button>
        )}
      </form>

      <section class="entry-details panel-card">
        <h2 class="section-label">Details</h2>
        <form method="post" action={`/register/${entry.id}/action`} class="app-form entry-form">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="update" />
          <div class="form-grid">
            <label>Full name<input name="full_name" required maxlength={LIMITS.full_name} value={entry.full_name} /></label>
            <label>Home municipality<input name="domicile" required maxlength={LIMITS.domicile} value={entry.domicile} /></label>
            <label>Email<input name="email" type="email" required maxlength={LIMITS.email} value={entry.email} /></label>
            <label>
              School
              <select name="student_status">
                {STUDENT_STATUSES.map((s) => (
                  <option value={s} selected={entry.student_status === s}>{STUDENT_STATUS_LABELS[s]}</option>
                ))}
              </select>
            </label>
            <label>
              Student union
              <select name="union_member">
                {UNIONS.map((u) => (
                  <option value={u} selected={entry.union_member === u}>{UNION_LABELS[u]}</option>
                ))}
              </select>
            </label>
            <label>
              Membership type
              <select name="member_type">
                {MEMBER_TYPES.map((t) => (
                  <option value={t} selected={entry.member_type === t}>{MEMBER_TYPE_LABELS[t]}</option>
                ))}
              </select>
            </label>
            <label>Discord username<input name="discord_name" maxlength={LIMITS.discord_name} value={entry.discord_name ?? ''} /></label>
            <label>
              Discord id (links the account)
              <input name="discord_id" pattern="\d{5,25}" value={entry.discord_id ?? ''} placeholder="Developer Mode → Copy ID" />
            </label>
            <label>Telegram username<input name="telegram" maxlength={LIMITS.telegram} value={entry.telegram ?? ''} /></label>
          </div>
          <fieldset class="checkbox-grid">
            <legend>Games</legend>
            {GAMES.map((game) => (
              <label class="check"><input type="checkbox" name="games" value={game} checked={knownGames.includes(game)} /> {game}</label>
            ))}
            <label class="check-other">Other<input name="games_other" maxlength={LIMITS.games_other} value={otherGames} /></label>
          </fieldset>
          <label class="check check-standalone">
            <input type="checkbox" name="wants_active" checked={entry.wants_active} /> <span>Has asked to be an active (approval is the button above)</span>
          </label>
          <label class="check check-standalone">
            <input type="checkbox" name="founder" checked={entry.founder} /> <span>Founded the association — a gold badge on their membership card, in place of the board one</span>
          </label>
          <label>Message from the person<textarea name="message" rows="2" maxlength={LIMITS.message}>{entry.message ?? ''}</textarea></label>
          <label>Board note (never shown to the member)<textarea name="board_note" rows="2" maxlength={LIMITS.board_note}>{entry.board_note ?? ''}</textarea></label>
          <button class="btn btn-primary" type="submit">Save changes</button>
        </form>
      </section>

      <details class="admin-edit admin-danger entry-erase">
        <summary><b>Erase this entry</b><span class="admin-edit-hint">for good, no undo</span></summary>
        <p class="queue-intro">
          Deletes the entry for good: the person's own request to be erased, or cleanup. No undo. To
          keep the record but end the membership, use "Mark as former member" above. Event signups
          are separate; erase those from the Events page if asked.
        </p>
        <form method="post" action={`/register/${entry.id}/action`}>
          <input type="hidden" name="csrf" value={csrf} />
          <button class="btn btn-danger" name="action" value="erase" type="submit" data-confirm="Erase this entry for good? There is no undo.">Erase this entry permanently</button>
        </form>
      </details>
    </>
  )}
</Base>
