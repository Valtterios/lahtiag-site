---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { currentSession, ensureCsrf } from '../../lib/guard';
import { getTicketByCode, listTicketsByPurchase } from '../../lib/db';
import { getPurchase, resumablePurchase } from '../../lib/purchases';
import { normalizeTicketCode, qrSvg, ticketUrl } from '../../lib/qr';
import { formatHelsinkiRange } from '../../lib/time';

// One ticket: the QR the door scans, and its state. Anyone holding the
// code can open it (that is what a ticket is); the code is unguessable.

const code = normalizeTicketCode(Astro.params.code ?? '');
const ticket = code ? await getTicketByCode(env.DB, code) : null;
if (!ticket) Astro.response.status = 404;
const session = await currentSession(Astro.request, env);
const csrf = ensureCsrf(Astro.cookies);
const justPaid = Astro.url.searchParams.get('paid') === '1';
const issued = Astro.url.searchParams.get('ok') === 'issued';
// Stripe sends the buyer back before the webhook may have landed; the
// page says so and refreshes itself once.
const waiting = justPaid && ticket?.status === 'pending';
const purchase = ticket?.purchase_id ? await getPurchase(env.DB, ticket.purchase_id) : null;
const siblings = purchase ? (await listTicketsByPurchase(env.DB, purchase.id)).filter((t) => t.id !== ticket!.id) : [];
const resume = !justPaid ? resumablePurchase(purchase, Math.floor(Date.now() / 1000)) : null;
// Whoever holds the purchase may release it; one on an account, only that account.
const canRelease = Boolean(purchase && purchase.status === 'pending' && !justPaid && (!purchase.discord_id || session?.discordId === purchase.discord_id));
Astro.response.headers.set('cache-control', 'no-store');
---
<Base title={ticket ? `Ticket: ${ticket.event_title}` : 'Ticket'} description="LahtiAG event ticket.">
  {waiting && <meta http-equiv="refresh" content="3" />}
  {!ticket ? (
    <article class="prose">
      <h1>No such ticket</h1>
      <p>That code doesn't match a ticket. Check it and try again, or open <a href="/tickets">your tickets</a>.</p>
    </article>
  ) : (
    <>
      <article class="prose">
        <h1>{ticket.event_title}</h1>
        <p class="queue-meta">{formatHelsinkiRange(ticket.starts_at, null)} · {ticket.type_name}</p>
      </article>
      {issued && <p class="flash">Your ticket is ready. {!ticket.discord_id && 'Keep this link, it is your ticket. '}Show this page at the door.</p>}
      {waiting && <p class="flash">Thanks, payment received. Confirming with Stripe, one moment…</p>}
      {justPaid && ticket.status === 'paid' && <p class="flash">Paid. {!ticket.discord_id && 'Keep this link, it is your ticket. '}Show this page at the door.</p>}
      <section class={`ticket-view ticket-${ticket.status}${ticket.checked_in_at ? ' ticket-used' : ''}`}>
        <div class="ticket-qr" set:html={ticket.status === 'paid' && !ticket.checked_in_at ? qrSvg(ticketUrl(Astro.url.origin, ticket.code), 240) : ''} />
        <div class="ticket-meta">
          <p class="ticket-holder">{ticket.holder_name}</p>
          <p class="ticket-code">{ticket.code}</p>
          <p class="ticket-state">
            {ticket.status === 'paid' && !ticket.checked_in_at && 'Valid ticket'}
            {ticket.status === 'paid' && ticket.checked_in_at && 'Used at the door'}
            {ticket.status === 'pending' && 'Payment not completed'}
            {ticket.status === 'refunded' && 'Refunded'}
            {ticket.status === 'void' && 'Cancelled'}
          </p>
          {ticket.amount_cents > 0 && <p class="queue-meta">{(ticket.amount_cents / 100).toFixed(2)} €</p>}
          {ticket.status === 'pending' && !justPaid && !resume && (
            <p class="queue-meta">The payment window closed. Release it, then buy again from the <a href={`/events/${ticket.event_id}`}>event</a>.</p>
          )}
          {(resume || canRelease) && purchase && (
            <div class="entry-actions">
              {resume && <a class="btn btn-cta" href={resume}>Continue to payment</a>}
              {canRelease && (
                <form method="post" action={`/purchase/${purchase.id}/release`}>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="next" value={`/events/${ticket.event_id}`} />
                  <button class="btn btn-ghost" type="submit">Release</button>
                </form>
              )}
            </div>
          )}
        </div>
      </section>
      {siblings.length > 0 && (
        <p class="queue-meta">
          Bought together with {siblings.map((t, i) => <>{i > 0 && ', '}<a href={`/tickets/${t.code}`}>{t.holder_name}</a></>)}. <a href={`/purchase/${purchase!.id}`}>The whole purchase.</a>
        </p>
      )}
      <p class="queue-meta">
        {session && (ticket.discord_id === session.discordId || ticket.bought_by === session.discordId) ? <a href="/tickets">All my tickets</a> : <a href={`/events/${ticket.event_id}`}>Event page</a>}
      </p>
    </>
  )}
</Base>
