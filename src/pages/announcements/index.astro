---
import { env } from 'cloudflare:workers';
import { Marked } from 'marked';
import Base from '../../layouts/Base.astro';
import SessionBox from '../../components/SessionBox.astro';
import { currentSession, ensureCsrf, viewAs } from '../../lib/guard';
import ViewAs from '../../components/ViewAs.astro';
import { listAnnouncements } from '../../lib/db';
import { formatHelsinki, unixToHelsinkiInputs } from '../../lib/time';
import { listGuildRoles } from '../../lib/discord';
import { DISCORD_GUILD_ID } from '../../lib/config';
import { pingLabel } from '../../lib/news';

const view = viewAs(await currentSession(Astro.request, env), Astro.url);
const session = view.session;
const csrf = ensureCsrf(Astro.cookies);
const announcements = await listAnnouncements(env.DB, 20, session?.isAdmin === true);

// The board picks who a post pings: nobody, everyone, or one of the
// server's roles (the bot lists them; without the bot, everyone only).
const guildRoles = session?.isAdmin && env.DISCORD_BOT_TOKEN ? ((await listGuildRoles(env.DISCORD_BOT_TOKEN, DISCORD_GUILD_ID)) ?? []) : [];
const pingRoles = guildRoles.filter((r) => r.name !== '@everyone' && !r.managed).sort((a, b) => a.name.localeCompare(b.name));
const roleNames = new Map(guildRoles.map((r) => [r.id, r.name]));

// Announcement bodies are Markdown written by admins (web form or the
// admin-gated /announce slash command). Raw HTML inside the Markdown is
// escaped, not passed through: even an admin-only field shouldn't be a
// stored-HTML foothold, and the CSP staying strict shouldn't be what the
// page's safety hinges on. Markdown formatting itself still renders.
const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const markdown = new Marked({
  renderer: { html: ({ text }) => escapeHtml(text) },
});
const rendered = announcements.map((item) => ({
  ...item,
  html: markdown.parse(item.body_md, { async: false }) as string,
}));

const FLASH: Record<string, string> = {
  forbidden: 'That needs the admin role in Discord.',
  discord_down: "Discord didn't answer while re-checking your role. Try again.",
  bad_input: 'An announcement needs a title and a body.',
  csrf: 'The form was stale. Try again.',
  missing: 'No such post.',
  cover_bad: 'The cover must be a JPEG, PNG or WebP under 1.5 MB.',
  cover_missing: 'Pick a picture first.',
};
const OK: Record<string, string> = {
  draft: 'Saved as a draft. Only the board sees it; publish it when it is ready.',
  scheduled: 'Scheduled. It publishes itself and goes to Discord within 15 minutes of that time; Publish sends it now instead.',
  bad_time: "That publish date and time didn't parse.",
  published: 'Published and posted on Discord.',
  published_nodiscord: "Published on the site, but Discord didn't take the post. Post to Discord under it tries again.",
  discord_posted: 'Posted on Discord.',
  discord_failed: "Discord didn't take the post. Try again in a moment.",
  discord_exists: 'That post is on Discord already.',
  unpublished: 'Back to a draft: off the page and off Discord. Publish sends it again, pinging whoever the post pings.',
  cover_saved: 'Cover saved.',
  cover_removed: 'Cover removed.',
  edited: 'Post updated.',
};
const scheduleInputs = (at: number | null) => (at ? unixToHelsinkiInputs(at) : { date: '', time: '' });
const flash = FLASH[Astro.url.searchParams.get('err') ?? ''] ?? OK[Astro.url.searchParams.get('ok') ?? ''] ?? null;
const published = rendered.filter((p) => p.draft !== 1).length;
const draftCount = rendered.filter((p) => p.draft === 1 && !p.publish_at).length;
const scheduled = rendered.filter((p) => p.draft === 1 && p.publish_at).length;
---
<Base title="News" description="LahtiAG announcements, the same news that lands on Discord.">
  <article class="prose">
    <h1>News</h1>
  </article>
  {session && <SessionBox session={session} csrf={csrf} />}
  {flash && <p class="flash">{flash}</p>}

  {rendered.length === 0 ? (
    <p class="app-empty">
      Nothing posted yet. Announcements land on <a href="https://discord.com/invite/u2pcgDhQ7G" rel="noopener">Discord</a> first.
    </p>
  ) : (
    rendered.map((item) => (
      <article class={`news-card prose${item.draft ? ' news-draft' : ''}`} id={`post-${item.id}`}>
        <p class="event-when">
          {item.draft === 1 && <span class="status-badge status-muted">Draft</span>}
          {item.draft === 1 && item.ping && <span class="status-badge status-muted">pings {pingLabel(item.ping, roleNames)}</span>}
          {item.draft === 1 ? (item.publish_at ? ` scheduled for ${formatHelsinki(item.publish_at)}` : ' not published') : formatHelsinki(item.published_at)}
          {item.author_name && `, ${item.author_name}`}
          {item.source === 'discord' && ', via Discord'}
        </p>
        <h2>{item.title}</h2>
        {item.cover_at && (
          <img class="news-cover" src={`/announcements/${item.id}/cover?v=${item.cover_at}`} alt="" loading="lazy" width={item.cover_w ?? undefined} height={item.cover_h ?? undefined} />
        )}
        <div set:html={item.html} />
        {session?.isAdmin && (
          <div class="entry-actions">
            {item.draft === 1 && (
              <form method="post" action="/announcements/publish">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={item.id} />
                <button class="btn btn-cta btn-sm" type="submit" data-confirm="Publish this post? It goes on Discord right away.">Publish</button>
              </form>
            )}
            {item.draft === 0 && (
              <form method="post" action="/announcements/unpublish" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={item.id} />
                <button class="btn btn-ghost btn-sm" type="submit" data-confirm="Take this post off the site and off Discord? It becomes a draft again.">Unpublish</button>
              </form>
            )}
            {item.draft === 0 && !item.discord_message_id && (
              <form method="post" action="/announcements/discord" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={item.id} />
                <button class="btn btn-ghost btn-sm" type="submit" data-confirm="Post this on Discord now?">Post to Discord</button>
              </form>
            )}
            <form method="post" action="/announcements/delete" class="inline-form">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="id" value={item.id} />
              <button class="btn btn-ghost btn-sm" type="submit" data-confirm="Delete this post?">Delete</button>
            </form>
            {item.cover_at && (
              <form method="post" action={`/announcements/${item.id}/cover`} class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="action" value="remove" />
                <button class="btn btn-ghost btn-sm" type="submit">Remove cover</button>
              </form>
            )}
          </div>
        )}
        {session?.isAdmin && (
          <details class="news-edit admin-edit">
            <summary><b>Edit this post</b><span class="admin-edit-hint">title, body, cover, ping, schedule</span></summary>
            <form method="post" action="/announcements/edit" class="app-form" enctype="multipart/form-data">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="id" value={item.id} />
              <label>Title <input name="title" required maxlength="120" value={item.title} /></label>
              <label>Body (Markdown) <textarea name="body" rows="8" required maxlength="4000">{item.body_md}</textarea></label>
              <label>{item.cover_at ? 'Replace the cover picture' : 'Cover picture'} (optional; JPEG, PNG or WebP up to 1.5 MB) <input name="cover" type="file" accept="image/jpeg,image/png,image/webp" /></label>
              {item.draft === 1 && (
                <>
                  <label>Ping on Discord
                    <select name="ping">
                      <option value="" selected={!item.ping}>Nobody</option>
                      <option value="everyone" selected={item.ping === 'everyone'}>@everyone</option>
                      {pingRoles.map((r) => <option value={r.id} selected={item.ping === r.id}>@{r.name}</option>)}
                    </select>
                  </label>
                  <label>Publish on <input name="publish_date" type="date" value={scheduleInputs(item.publish_at).date} /></label>
                  <label>Publish at (Helsinki) <input name="publish_time" type="time" value={scheduleInputs(item.publish_at).time} placeholder="empty = 09:00" /></label>
                  <p class="queue-meta">Without a date it stays a draft until you press Publish. With one it publishes itself within 15 minutes of that time.</p>
                </>
              )}
              <button class="btn btn-primary btn-sm" type="submit">Save changes</button>
              {item.draft === 0 && <p class="queue-meta">The post on Discord is updated too, picture included.</p>}
            </form>
          </details>
        )}
      </article>
    ))
  )}

  <ViewAs mode={view.mode} path="/announcements" />
  {session?.isAdmin && (
    <details class="admin-panel" open={Boolean(Astro.url.searchParams.get('ok') || Astro.url.searchParams.get('err'))}>
      <summary>Board tools · write a post</summary>
      <p class="admin-status">
        <span class="status-badge">{published} posted</span>
        {draftCount > 0 && <span class="status-badge status-muted">{draftCount} draft{draftCount === 1 ? '' : 's'}</span>}
        {scheduled > 0 && <span class="status-badge status-pending">{scheduled} scheduled</span>}
      </p>
      <details class="admin-edit" open>
        <summary><b>Write a post</b><span class="admin-edit-hint">title, body, cover, ping, publish date</span></summary>
      <form method="post" action="/announcements/new" class="app-form" enctype="multipart/form-data">
        <input type="hidden" name="csrf" value={csrf} />
        <label>Title <input name="title" required maxlength="120" /></label>
        <label>Body (Markdown) <textarea name="body" rows="6" required maxlength="4000"></textarea></label>
        <label>Cover picture (optional; JPEG, PNG or WebP up to 1.5 MB, goes to Discord with the post) <input name="cover" type="file" accept="image/jpeg,image/png,image/webp" /></label>
        <label>Ping on Discord
          <select name="ping">
            <option value="">Nobody</option>
            <option value="everyone">@everyone</option>
            {pingRoles.map((r) => <option value={r.id}>@{r.name}</option>)}
          </select>
        </label>
        <label>Publish on <input name="publish_date" type="date" /></label>
        <label>Publish at (Helsinki) <input name="publish_time" type="time" placeholder="empty = 09:00" /></label>
        <button class="btn btn-primary" type="submit">Save</button>
        <p class="queue-meta">Without a date it stays a draft until you press Publish. With one it publishes itself within 15 minutes of that time and goes to Discord, for a general meeting notice written ahead.</p>
      </form>
      </details>
    </details>
  )}
</Base>
