---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { ensureCsrf, requireAdmin } from '../../lib/guard';
import { requireBoard } from '../../lib/board';
import { listUndeliveredItems, listDeliveredItems, listProducts } from '../../lib/purchases';
import { listUnattachedDoorPayments } from '../../lib/db';
import { stripeConfigured } from '../../lib/stripe';
import { formatHelsinki } from '../../lib/time';
import { dailyMark } from '../../lib/stamp';
import TapPayments from '../../components/TapPayments.astro';

// Board: paid shop items waiting to be handed over, and the recent ones
// that were. Board role or register access.

const board = await requireBoard(Astro.request, env);
const admin = board.ok ? null : await requireAdmin(Astro.request, env);
const allowed = board.ok || admin?.ok === true;
Astro.response.status = allowed ? 200 : 401;
const csrf = ensureCsrf(Astro.cookies);
const nowSeconds = Math.floor(Date.now() / 1000);
const [waiting, done, products, payments] = allowed
  ? await Promise.all([listUndeliveredItems(env.DB), listDeliveredItems(env.DB), listProducts(env.DB, nowSeconds), listUnattachedDoorPayments(env.DB, nowSeconds - 12 * 3600)])
  : [[], [], [], []];
const paymentsOn = stripeConfigured(env);
const euro = (cents: number) => `${(cents / 100).toFixed(2)} €`;
const mark = allowed && env.SESSION_SECRET ? await dailyMark(env.SESSION_SECRET, Math.floor(Date.now() / 1000)) : null;
const FLASH: Record<string, string> = {
  delivered: 'Marked as handed over.',
  attached_item: 'Payment attached; sold and handed over:',
  sold_out: 'Not that many left in stock.',
  bad_input: "That didn't parse.",
  undone: 'Undone.',
  missing: 'No such item.',
  csrf: 'The form was stale. Try again.',
  forbidden: 'That needs the Board role in Discord.',
};
// Why the page is quiet, since "Nothing waiting" on its own leaves the
// board guessing. Without the association's Stripe keys nothing can be
// paid for at all, so nothing can ever land here; with nothing in stock
// there is nothing to buy in the first place.
const inStock = products.filter((p) => p.stock === null || p.stock - p.sold > 0).length;
const quiet = !paymentsOn
  ? "Nothing can land here yet either: the association's Stripe keys are not set on this deployment, so neither the shop nor Tap to Pay can take a payment."
  : inStock === 0
    ? 'Nothing is on sale either: every product is off sale or out of stock. Put one back in stock on the shop page.'
    : 'Everything bought so far has been handed over.';

const okKey = Astro.url.searchParams.get('ok');
const flash = FLASH[okKey ?? Astro.url.searchParams.get('err') ?? ''] ?? null;
const flashName = (Astro.url.searchParams.get('who') ?? '').slice(0, 120);
Astro.response.headers.set('cache-control', 'no-store');
---
<Base title="Items to hand over" description="Board-only list of paid shop items." wide>
  {!allowed ? (
    <article class="prose">
      <h1>Items to hand over</h1>
      <p>Board members sign in with Discord to see this.</p>
      <p class="entry-actions"><a class="btn btn-primary" href="/login?next=/shop/orders">Sign in with Discord</a></p>
    </article>
  ) : (
    <>
      <article class="prose entry-head">
        <p class="hero-eyebrow"><a href="/shop">Shop</a></p>
        <h1>Items to hand over</h1>
        <p class="queue-meta">{waiting.length} waiting. Tick each one off when the buyer collects it; they show this on their purchase page.</p>
      </article>
      {flash && <p class={`flash${okKey ? ' flash-good' : ''}`}>{flash}{flashName && <> <strong>{flashName}</strong></>}</p>}
      {mark && (
        <p class="daily-mark">
          <span class="daily-mark-icon" aria-hidden="true">{mark.icon}</span>
          <span>Today's mark is <strong>{mark.name}</strong>. When a buyer presses "Mark as collected" in front of you, their page shows this mark; a screenshot from another day shows a different one.</span>
        </p>
      )}
      {paymentsOn && products.length > 0 && (
        <TapPayments mode="shop" payments={payments} products={products} action="/shop/attach" csrf={csrf} refresh="/shop/orders" />
      )}

      {waiting.length === 0 ? (
        <p class="app-empty">Nothing waiting. {quiet}</p>
      ) : (
        <ul class="door-list">
          {waiting.map((it) => (
            <li class="door-row">
              <div>
                <p class="door-name">{it.buyer_name}</p>
                <p class="queue-meta">{it.quantity} × {it.name} · {euro(it.unit_cents * it.quantity)} · paid {it.paid_at ? formatHelsinki(it.paid_at) : '–'}{it.discord_id ? '' : ' · no Discord'}</p>
              </div>
              <form method="post" action="/shop/deliver">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={it.id} />
                <button class="btn btn-primary btn-sm" type="submit">Handed over</button>
              </form>
            </li>
          ))}
        </ul>
      )}
      {done.length > 0 && (
        <section class="list">
          <h2 class="section-label">Handed over</h2>
          <ul class="door-list">
            {done.map((it) => (
              <li class="door-row door-in">
                <div>
                  <p class="door-name">{it.buyer_name}</p>
                  <p class="queue-meta">{it.quantity} × {it.name} · {it.delivered_at ? formatHelsinki(it.delivered_at) : ''} · {it.delivered_by === 'buyer' ? 'marked by the buyer' : `by ${it.delivered_by}`}</p>
                </div>
                <form method="post" action="/shop/deliver">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={it.id} />
                  <button class="btn btn-ghost btn-sm" name="undo" value="1" type="submit">Undo</button>
                </form>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}
</Base>
