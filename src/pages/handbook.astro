---
import { env } from 'cloudflare:workers';
import { Marked } from 'marked';
import Base from '../layouts/Base.astro';
import { requireAdmin } from '../lib/guard';
import { requireBoard } from '../lib/board';
import handbook from '../../docs/OPERATIONS.md?raw';

// The operations handbook (docs/OPERATIONS.md), rendered for the board:
// Board role on Discord or register access. The Markdown is the source;
// pictures live in docs/images and a copy in public/handbook/images.

const board = await requireBoard(Astro.request, env);
const admin = board.ok ? null : await requireAdmin(Astro.request, env);
const allowed = board.ok || admin?.ok === true;
Astro.response.status = allowed ? 200 : 401;

const slug = (text: string) =>
  text
    .toLowerCase()
    .replace(/<[^>]+>/g, '')
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
const escapeHtml = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const markdown = new Marked({
  renderer: {
    html: ({ text }) => escapeHtml(text),
    heading({ tokens, depth }) {
      const text = this.parser.parseInline(tokens);
      return `<h${depth} id="${slug(text)}">${text}</h${depth}>\n`;
    },
    image({ href, text }) {
      return `<img src="${href.replace(/^images\//, '/handbook/images/')}" alt="${escapeHtml(text)}" loading="lazy" />`;
    },
  },
});
const html = allowed ? (markdown.parse(handbook.replace(/^# .*\n/, ''), { async: false }) as string) : '';
Astro.response.headers.set('cache-control', 'no-store');
---
<Base title="Handbook" description="How the board runs lahtiag.fi." wide>
  {!allowed ? (
    <article class="prose">
      <h1>Handbook</h1>
      <p>The board's operations handbook. Sign in with Discord (Board role) or the register login to read it.</p>
      <p class="entry-actions"><a class="btn btn-primary" href="/login?next=/handbook">Sign in with Discord</a> <a class="btn btn-ghost" href="/register">Register login</a></p>
    </article>
  ) : (
    <article class="prose handbook">
      <p class="hero-eyebrow">Board</p>
      <h1>Running lahtiag.fi</h1>
      <p class="queue-meta">The same text as <code>docs/OPERATIONS.md</code> in the repository; edit it there.</p>
      <div set:html={html} />
    </article>
  )}
</Base>
