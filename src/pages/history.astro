---
import { env } from 'cloudflare:workers';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { listResults, leaderboard, listPhotoAlbums, listPastEvents, coverVersions, type ResultRow, type EventWithCounts } from '../lib/db';
import { avatarUrl } from '../lib/discord';
import { formatHelsinki, formatHelsinkiRange } from '../lib/time';

// This file takes the /history path over from the generic [id].astro: the
// Markdown is only the intro; the page itself is the archive. Every decided
// bracket final lands in the Hall of Fame, and every past event is a tile
// with its cover (or its first photo), its champion and its pictures.

const entry = await getEntry('pages', 'history');
if (!entry) {
  throw new Error('src/content/pages/history.md is required by this page.');
}
const { Content } = await render(entry);

const now = Math.floor(Date.now() / 1000);
let results: ResultRow[] = [];
let board: Awaited<ReturnType<typeof leaderboard>> = { events: [], wins: [] };
let past: EventWithCounts[] = [];
let covers = new Map<number, number>();
const albums = new Map<number, Awaited<ReturnType<typeof listPhotoAlbums>>[number]>();
try {
  results = await listResults(env.DB);
  board = await leaderboard(env.DB, now);
  past = await listPastEvents(env.DB, now, 100);
  covers = await coverVersions(env.DB, past.map((e) => e.id));
  for (const a of await listPhotoAlbums(env.DB, 200)) albums.set(a.event_id, a);
} catch {
  // the archive stays empty; the intro stays up
}
const champions = new Map(results.map((r) => [r.event_id, r.champion_name]));
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <Content />

    {results.length > 0 && (
      <>
        <h2>Hall of fame</h2>
        <ul class="results-list">
          {results.map((result) => (
            <li>
              <span class="results-avatars">
                {result.avatars.slice(0, 4).map((a) => (
                  <img src={avatarUrl(a.discord_id, a.avatar_hash)} alt="" width="28" height="28" loading="lazy" />
                ))}
              </span>
              <span>
                🏆 <strong>{result.champion_name}</strong> won
                <a href={`/events/${result.event_id}/bracket${result.bracket_name ? `?b=${result.bracket_id}` : ''}`}> {result.title}</a>
                {result.bracket_name && <span class="event-meta"> · {result.bracket_name}</span>}
                <span class="event-meta"> ({formatHelsinki(result.starts_at)})</span>
              </span>
              <a class="results-picture" href={`/events/${result.event_id}/bracket${result.bracket_name ? `?b=${result.bracket_id}` : ''}`}>
                <img src={`/events/${result.event_id}/bracket.png${result.bracket_name ? `?b=${result.bracket_id}` : ''}`} alt={`Final bracket of ${result.title}`} loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    {(board.events.length > 0 || board.wins.length > 0) && (
      <>
        <h2>Leaderboard</h2>
        <p class="event-meta">Every member is on it; hide yourself on your membership page.</p>
        <div class="leaderboard">
          {board.events.length > 0 && (
            <div>
              <h3>Most events</h3>
              <ol>
                {board.events.map((r) => (
                  <li><img src={avatarUrl(r.discord_id, r.avatar_hash)} alt="" width="24" height="24" loading="lazy" /> {r.username} <span class="event-meta">{r.attended}</span></li>
                ))}
              </ol>
            </div>
          )}
          {board.wins.length > 0 && (
            <div>
              <h3>Most wins</h3>
              <ol>
                {board.wins.map((r) => (
                  <li><img src={avatarUrl(r.discord_id, r.avatar_hash)} alt="" width="24" height="24" loading="lazy" /> {r.username} <span class="event-meta">{r.wins}</span></li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </>
    )}

    {past.length > 0 && <h2>Past events</h2>}
  </article>
  {past.length > 0 && (
    <ul class="event-grid">
      {past.map((event) => {
        const album = albums.get(event.id);
        return (
          <li class="event-tile">
            <a class="event-tile-cover" href={`/events/${event.id}`} tabindex="-1" aria-hidden="true">
              {covers.has(event.id) ? (
                <img src={`/events/${event.id}/cover?t=${covers.get(event.id)}`} alt="" loading="lazy" />
              ) : album ? (
                <img src={`/events/${event.id}/photos/${album.first_id}`} alt="" loading="lazy" />
              ) : (
                <span class="event-tile-empty"><img src="/brand/mark-blue.png" alt="" width="512" height="443" /></span>
              )}
            </a>
            <div class="event-tile-body">
              <p class="event-when">{formatHelsinkiRange(event.starts_at, event.ends_at)}</p>
              <h2><a href={`/events/${event.id}`}>{event.title}</a></h2>
              <p class="event-meta">
                {champions.has(event.id) && <span>🏆 {champions.get(event.id)} · </span>}
                {event.organizers && <span>By {event.organizers} · </span>}
                {event.team_size !== null ? <span>{event.teams_count} teams</span> : <span>{event.yes_count} went</span>}
                {album && <span> · {album.photos} {album.photos === 1 ? 'photo' : 'photos'}{album.photo_credit ? ` (${album.photo_credit})` : ''}</span>}
              </p>
              <p class="event-tile-actions"><a class="btn btn-primary btn-sm" href={`/events/${event.id}`}>Open</a></p>
            </div>
          </li>
        );
      })}
    </ul>
  )}
</Base>

<style is:global>
  .results-list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .results-list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: var(--surface);
    border: 1px solid var(--line);
    clip-path: var(--cut-s);
    padding: 0.55rem 0.9rem;
  }
  .results-avatars {
    display: flex;
    flex-shrink: 0;
  }
  .results-avatars img {
    border-radius: 50%;
    border: 2px solid var(--surface);
    margin-right: -8px;
  }
  .results-avatars img:last-child {
    margin-right: 0;
  }
</style>
