---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import { currentSession, ensureCsrf } from '../../../lib/guard';
import { getEvent, getBracket, listBrackets, listSignups, listEventTeams } from '../../../lib/db';
import { avatarUrl } from '../../../lib/discord';
import { formatHelsinki } from '../../../lib/time';
import { bestOfFor, scorelines, BEST_OF_CHOICES } from '../../../lib/scores';
import { isBronzeMatch, podiumOf, GOLD, SILVER, BRONZE } from '../../../lib/podium';
import { activeCS2Matches, CS2_SERVER_IDS, type CS2MatchRow } from '../../../lib/cs2';

const id = Number(Astro.params.id);
const event = Number.isInteger(id) ? await getEvent(env.DB, id) : null;
if (!event) {
  Astro.response.status = 404;
}

const session = await currentSession(Astro.request, env);
const csrf = ensureCsrf(Astro.cookies);
// An event runs one bracket, usually; when it runs several they sit side
// by side under their names, and ?b= says which one is on show. A draft
// is the board's until they put it live, so everyone else picks from the
// live ones — and an event whose only draw is still a draft says so.
const brackets = event ? await listBrackets(env.DB, event.id) : [];
const visible = session?.isAdmin ? brackets : brackets.filter((b) => b.live_at !== null);
const askedRaw = Astro.url.searchParams.get('b');
const asked = askedRaw === null || askedRaw.trim() === '' ? null : Number(askedRaw);
const bracket = (asked !== null ? visible.find((b) => b.id === asked) : undefined) ?? visible[0] ?? null;
const many = brackets.length > 1;
const drafting = bracket === null && brackets.length > 0;
const matches = bracket ? await getBracket(env.DB, bracket.id) : [];
const draftBracket = bracket !== null && bracket.live_at === null;
const signups = event ? await listSignups(env.DB, event.id) : [];
const eventTeams = event?.team_size != null ? await listEventTeams(env.DB, event.id) : [];
// Resolve participant keys to names and avatar stacks.
interface Participant {
  name: string;
  avatars: string[];
}
const participants = new Map<string, Participant>();
for (const signup of signups) {
  participants.set(`u:${signup.discord_id}`, {
    name: signup.username,
    avatars: [avatarUrl(signup.discord_id, signup.avatar_hash)],
  });
}
for (const team of eventTeams) {
  const members = signups.filter((s) => s.event_team_id === team.id);
  participants.set(`t:${team.id}`, {
    name: team.name,
    avatars: members.map((m) => avatarUrl(m.discord_id, m.avatar_hash)),
  });
}
const nameOf = (key: string | null) =>
  key === null ? null : (participants.get(key) ?? { name: 'Unknown', avatars: [] });

const totalRounds = matches.reduce((max, m) => Math.max(max, m.round), 0);
const rounds = Array.from({ length: totalRounds }, (_, i) =>
  matches.filter((m) => m.round === i + 1),
);
// Matches paired two-and-two: each pair feeds one next-round match, and the
// CSS draws the connector bracket around the pair.
const pairedRounds = rounds.map((roundMatches) => {
  const pairs = [];
  for (let i = 0; i < roundMatches.length; i += 2) {
    pairs.push(roundMatches.slice(i, i + 2));
  }
  return pairs;
});
function roundLabel(round: number): string {
  const fromEnd = totalRounds - round;
  if (fromEnd === 0) return 'Final';
  if (fromEnd === 1) return 'Semifinals';
  if (fromEnd === 2) return 'Quarterfinals';
  return `Round ${round}`;
}
const final = matches.find((m) => m.round === totalRounds && m.slot === 0);
const champion = final?.winner ? nameOf(final.winner) : null;
// First, second and third once the final is played; third only when it
// was played for.
const standings = podiumOf(matches);
const podium = standings
  ? [
      { medal: GOLD, place: 'Champion', side: nameOf(standings.gold) },
      { medal: SILVER, place: 'Runner-up', side: nameOf(standings.silver) },
      ...(standings.bronze ? [{ medal: BRONZE, place: 'Third', side: nameOf(standings.bronze) }] : []),
    ]
  : [];
// How long a match in this round is: the final may run longer than the rest.
const bestOfIn = (round: number): number => (bracket ? bestOfFor(bracket, round, totalRounds) : 1);

// What the Counter-Strike servers are running right now. At most one match
// per server, so this is two rows at the very most. It is read for everyone,
// not just the board: a match being played is worth showing on the bracket.
const cs2Running: CS2MatchRow[] = bracket ? await activeCS2Matches(env.DB) : [];
const cs2Here = new Map(
  cs2Running.filter((r) => r.bracket_id === bracket?.id).map((r) => [`${r.round}:${r.slot}`, r]),
);
const cs2BusyServers = new Set(cs2Running.map((r) => r.server));
const cs2Of = (match: { round: number; slot: number }) => cs2Here.get(`${match.round}:${match.slot}`) ?? null;

const FLASH: Record<string, string> = {
  bad_input: "That didn't go through: a substitute must be on the roster and not in the bracket yet, and a bracket name is 1 to 40 characters.",
  missing: 'No such match, participant or bracket.',
  bad_score: 'That score does not fit how long these matches are played. Set the format below first.',
  bad_seeding: 'That seeding could not be saved: every participant exactly once, and the same number of byes.',
  bracket_live: 'The bracket is live; regenerate to start over with a new draft.',
  dup_name: 'This event already has a bracket by that name.',
  too_few: 'A bracket needs at least two teams or players. Tick more entrants, or add them to the roster first.',
  forbidden: 'That needs the admin role in Discord.',
  discord_down: "Discord didn't answer while re-checking your role. Try again.",
  csrf: 'The form was stale. Try again.',
};
const OK: Record<string, string> = {
  drafted: 'Bracket drawn as a draft. Only the board sees it: rearrange round one below if you like, then go live.',
  added: 'Bracket added as a draft. Only the board sees it: rearrange round one below if you like, then go live.',
  seeded: 'Seeding saved.',
  live: "The bracket is live for everyone and posted to the event's Discord channel.",
  replaced: 'Substitute in place.',
  renamed: 'Bracket renamed.',
  format: 'Match length saved.',
  bronze_on: 'Third-place match added, beside the final.',
  bronze_off: 'Third-place match removed.',
  bracket_deleted: 'Bracket deleted.',
  cs2_sent: 'Sent to the server. It loads the match itself; the captains ban maps in game with .ban, and the score appears here as the maps are played.',
  cs2_cancelled: 'Taken off the server here. The server was NOT told: if people are playing, stop the match in game.',
};
const flash = FLASH[Astro.url.searchParams.get('err') ?? ''] ?? OK[Astro.url.searchParams.get('ok') ?? ''] ?? null;
// For the board's seeding and substitute forms.
const roundOne = matches.filter((m) => m.round === 1);
const drawKeys = roundOne.flatMap((m) => [m.side_a, m.side_b]).filter((k): k is string => k !== null);
const inDraw = new Set(matches.flatMap((m) => [m.side_a, m.side_b, m.winner]).filter((k): k is string => k !== null));
const poolKeys = event?.team_size != null ? eventTeams.map((t) => `t:${t.id}`) : signups.filter((s) => s.status === 'yes').map((s) => `u:${s.discord_id}`);
const benchKeys = poolKeys.filter((k) => !inDraw.has(k));
const title = event ? (many && bracket ? `${event.title}: ${bracket.name}` : `${event.title}: bracket`) : 'Event not found';
---
<Base
  title={title}
  description={event ? `Tournament bracket for ${event.title}` : undefined}
  image={event && bracket && bracket.live_at !== null && matches.length > 0 ? `${Astro.url.origin}/events/${event.id}/bracket.png?b=${bracket.id}&t=${Math.floor(Date.now() / 600)}` : undefined}
>
  {!event ? (
    <article class="prose">
      <h1>No such event</h1>
      <p>Nothing lives at this id. Back to <a href="/events">events</a>.</p>
    </article>
  ) : (
    <>
      <article class="prose">
        <p class="hero-eyebrow">{formatHelsinki(event.starts_at)}</p>
        <h1>{title}</h1>
        <p class="event-meta">
          <a href={`/events/${event.id}`}>Back to the event page</a>
          {session?.isAdmin && bracket && (
            <>
              {' · '}
              <a href={`/events/${event.id}/bracket?display${many ? `&b=${bracket.id}` : ''}`}>Open presenter mode</a>
            </>
          )}
        </p>
      </article>
      {flash && <p class="flash">{flash}</p>}

      {visible.length > 1 && (
        <nav class="bracket-tabs" aria-label="Brackets">
          {visible.map((b) => (
            <a
              class={`bracket-tab${bracket?.id === b.id ? ' is-on' : ''}`}
              href={`/events/${event.id}/bracket?b=${b.id}`}
              aria-current={bracket?.id === b.id ? 'page' : undefined}
            >
              {b.name}
              {b.live_at === null && <span class="bracket-tab-draft" title="A draft only the board sees">draft</span>}
            </a>
          ))}
        </nav>
      )}

      <div id="bracket-live">
      {event.display_note && <p class="display-note">{event.display_note}</p>}
      {champion && (
        <p class="champion">
          🏆 <strong>{champion.name}</strong> takes it{many && bracket ? ` in ${bracket.name}` : ''}!
          {champion.avatars.map((src) => (
            <img src={src} alt="" width="28" height="28" loading="lazy" />
          ))}
        </p>
      )}
      {podium.length > 0 && (
        <ol class="podium">
          {podium.map((p) => (
            <li class="podium-place">
              <span class="podium-medal">{p.medal}</span>
              <span class="podium-side">
                <strong>{p.side?.name ?? 'Unknown'}</strong>
                <span class="member-meta">{p.place}</span>
              </span>
              <span class="podium-faces">
                {(p.side?.avatars ?? []).slice(0, 5).map((src) => (
                  <img src={src} alt="" width="24" height="24" loading="lazy" />
                ))}
              </span>
            </li>
          ))}
        </ol>
      )}

      {matches.length === 0 ? (
        <p class="app-empty">
          {drafting
            ? 'The organizers are finalizing the bracket. It appears here shortly.'
            : <>No bracket yet. {session?.isAdmin ? 'Generate one from the event page once signups are in.' : 'It appears here once the organizers generate it.'}</>}
        </p>
      ) : (
        <div class="bracket-scroll">
          <div class="bracket">
            {pairedRounds.map((pairs, roundIndex) => (
              <div class="bracket-round">
                <p class="bracket-round-label">{roundLabel(roundIndex + 1)}</p>
                {pairs.map((pair) => (
                <div class={`bracket-pair${pair.length === 2 && !pair.some((x) => isBronzeMatch(x, totalRounds)) ? ' pair-linked' : ''}`}>
                {pair.map((match) => (
                  <div class={`bracket-match${isBronzeMatch(match, totalRounds) ? ' bracket-bronze' : ''}`}>
                    {isBronzeMatch(match, totalRounds) && <p class="bracket-bronze-label">{BRONZE} Third place</p>}
                    {(['side_a', 'side_b'] as const).map((sideName) => {
                      const key = match[sideName];
                      const side = nameOf(key);
                      const won = match.winner !== null && match.winner === key;
                      const decided = match.winner !== null;
                      const clickable =
                        session?.isAdmin && key !== null && match.side_a !== null && match.side_b !== null;
                      const bestOf = bestOfIn(match.round);
                      const games = sideName === 'side_a' ? match.score_a : match.score_b;
                      return (
                        <div class={`bracket-side${won ? ' won' : ''}${decided && !won ? ' lost' : ''}`}>
                          {side ? (
                            <>
                              <span class="bracket-avatars">
                                {side.avatars.slice(0, 4).map((src) => (
                                  <img src={src} alt="" width="24" height="24" loading="lazy" />
                                ))}
                              </span>
                              <span class="bracket-name">{side.name}</span>
                              {games !== null && <span class={`bracket-games${!decided ? ' bracket-games-live' : ''}`}>{games}</span>}
                              {clickable && bestOf > 1 && !decided && (
                                <form method="post" action={`/events/${event.id}/bracket-action`} class="inline-form">
                                  <input type="hidden" name="csrf" value={csrf} />
                                  <input type="hidden" name="bracket_id" value={bracket!.id} />
                                  <input type="hidden" name="action" value="games" />
                                  <input type="hidden" name="round" value={match.round} />
                                  <input type="hidden" name="slot" value={match.slot} />
                                  <input type="hidden" name="games_a" value={(match.score_a ?? 0) + (sideName === 'side_a' ? 1 : 0)} />
                                  <input type="hidden" name="games_b" value={(match.score_b ?? 0) + (sideName === 'side_b' ? 1 : 0)} />
                                  <button class="bracket-win-btn bracket-game-btn" type="submit" title={`${side.name} won a game`}>+1</button>
                                </form>
                              )}
                              {clickable && bestOf > 1 &&
                                scorelines(bestOf).map(([w, l]) => (
                                  <form method="post" action={`/events/${event.id}/bracket-action`} class="inline-form">
                                    <input type="hidden" name="csrf" value={csrf} />
                                    <input type="hidden" name="bracket_id" value={bracket!.id} />
                                    <input type="hidden" name="action" value="winner" />
                                    <input type="hidden" name="round" value={match.round} />
                                    <input type="hidden" name="slot" value={match.slot} />
                                    <input type="hidden" name="winner" value={key} />
                                    <input type="hidden" name="score" value={`${w}-${l}`} />
                                    <button
                                      class={`bracket-win-btn${won && games === w ? ' is-recorded' : ''}`}
                                      type="submit"
                                      title={won && games === w ? `Recorded: ${side.name} wins ${w}–${l}` : `${side.name} wins ${w}–${l}`}
                                    >
                                      {w}–{l}
                                    </button>
                                  </form>
                                ))}
                              {clickable && (bestOf === 1 || won) && (
                                <form method="post" action={`/events/${event.id}/bracket-action`} class="inline-form">
                                  <input type="hidden" name="csrf" value={csrf} />
                                  <input type="hidden" name="bracket_id" value={bracket!.id} />
                                  <input type="hidden" name="action" value={won ? 'undo' : 'winner'} />
                                  <input type="hidden" name="round" value={match.round} />
                                  <input type="hidden" name="slot" value={match.slot} />
                                  {!won && <input type="hidden" name="winner" value={key} />}
                                  <button
                                    class="bracket-win-btn"
                                    type="submit"
                                    title={won ? 'Undo this result' : 'Mark as winner'}
                                  >
                                    {won ? '↺' : 'W'}
                                  </button>
                                </form>
                              )}
                            </>
                          ) : (
                            <span class="bracket-name bracket-tbd">
                              {match.round === 1 ? 'Bye' : 'TBD'}
                            </span>
                          )}
                        </div>
                      );
                    })}
                    {(() => {
                      // The Counter-Strike servers. A match can be handed to
                      // one; the server then loads it, runs the veto in game
                      // and reports the maps back here as they are played.
                      const running = cs2Of(match);
                      const playable =
                        session?.isAdmin && match.winner === null &&
                        match.side_a !== null && match.side_b !== null;
                      if (!running && !playable) return null;
                      return (
                        <p class="bracket-cs2">
                          {running ? (
                            <>
                              <span class={`bracket-cs2-badge${running.status === 'live' ? ' is-live' : ''}`}>
                                {running.status === 'live' ? 'Live' : 'Sent'} · Server {running.server}
                              </span>
                              {running.status === 'live' && running.rounds_a !== null && (
                                <span class="bracket-cs2-rounds">{running.rounds_a}–{running.rounds_b}</span>
                              )}
                              <a class="bracket-cs2-watch" href="/cs">Join or watch</a>
                              {session?.isAdmin && (
                                <form method="post" action={`/events/${event.id}/cs2`} class="inline-form">
                                  <input type="hidden" name="csrf" value={csrf} />
                                  <input type="hidden" name="bracket" value={bracket!.id} />
                                  <input type="hidden" name="action" value="cancel" />
                                  <input type="hidden" name="match" value={running.id} />
                                  <button
                                    class="bracket-win-btn"
                                    type="submit"
                                    title="Stop following this match here. The server is not told."
                                    data-confirm="Take this match off the server list? The server is NOT told — if people are playing, stop the match in game."
                                  >×</button>
                                </form>
                              )}
                            </>
                          ) : (
                            CS2_SERVER_IDS.map((id) => (
                              <form method="post" action={`/events/${event.id}/cs2`} class="inline-form">
                                <input type="hidden" name="csrf" value={csrf} />
                                <input type="hidden" name="bracket" value={bracket!.id} />
                                <input type="hidden" name="action" value="send" />
                                <input type="hidden" name="round" value={match.round} />
                                <input type="hidden" name="slot" value={match.slot} />
                                <input type="hidden" name="server" value={id} />
                                <button
                                  class="bracket-win-btn"
                                  type="submit"
                                  disabled={cs2BusyServers.has(id)}
                                  title={cs2BusyServers.has(id)
                                    ? `Server ${id} already has a match on it`
                                    : `Play this match on server ${id}`}
                                >CS{id}</button>
                              </form>
                            ))
                          )}
                        </p>
                      );
                    })()}
                  </div>
                ))}
                </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      )}

      </div>

      {session?.isAdmin && (
        <section class="admin-panel">
          <h2>Board tools</h2>
          {bracket && matches.length > 0 && (
            <>
              <p class="admin-status">
                {many && <span class="status-badge status-member">{bracket.name}</span>}
                <span class={`status-badge${draftBracket ? ' status-muted' : ' status-member'}`}>{draftBracket ? 'Bracket: draft' : 'Bracket: live'}</span>
                <span class="status-badge">{matches.length} matches</span>
                {bracket.best_of > 1 && (
                  <span class="status-badge">
                    Best of {bracket.best_of}{bracket.final_best_of !== null ? `, final best of ${bracket.final_best_of}` : ''}
                  </span>
                )}
              </p>
              {draftBracket ? (
                <>
                  <p class="event-meta">
                    Only the board sees this draw. Rearrange round one below (a bye is an empty second side), save, and
                    press Go live: everyone sees it and the event's Discord channel gets it.
                  </p>
                  <form method="post" action={`/events/${event.id}/bracket-action`} class="seeding">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="bracket_id" value={bracket.id} />
                    <input type="hidden" name="action" value="seed" />
                    {roundOne.map((m) => (
                      <div class="seeding-match">
                        <span class="queue-meta">Match {m.slot + 1}</span>
                        {(['a', 'b'] as const).map((side) => (
                          <select name={`${side}${m.slot}`} aria-label={`Match ${m.slot + 1}, side ${side.toUpperCase()}`}>
                            <option value="">bye</option>
                            {drawKeys.map((key) => (
                              <option value={key} selected={(side === 'a' ? m.side_a : m.side_b) === key}>{nameOf(key)?.name ?? 'Unknown'}</option>
                            ))}
                          </select>
                        ))}
                      </div>
                    ))}
                    <div class="entry-actions">
                      <button class="btn btn-ghost" type="submit">Save seeding</button>
                    </div>
                  </form>
                  <form method="post" action={`/events/${event.id}/bracket-action`}>
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="bracket_id" value={bracket.id} />
                    <input type="hidden" name="action" value="live" />
                    <button class="btn btn-cta" type="submit" data-confirm="Go live? Everyone sees the bracket and it is posted to the event's Discord channel.">Go live</button>
                  </form>
                </>
              ) : (
                <p class="event-meta">
                  {bracket.best_of > 1
                    ? 'Click +1 on a side as it wins a game and the bracket follows the match live — 1–0, 2–1 — recording the win by itself when a side reaches the games it needs. The scoreline buttons record a finished match in one click instead; ↺ reverts a result.'
                    : 'Click W on a side to record the winner, or ↺ on the recorded winner to revert the result.'}
                  {' '}Changing or reverting an earlier result clears everything that followed from it.
                </p>
              )}
              <h3>Match length</h3>
              <p class="event-meta">
                Best-of-one records a winner alone; anything longer records the games too, and the
                bracket shows them. Changing the format drops the scores it can no longer explain — a 3–1 is
                neither a best-of-three nor a best-of-seven result. The winners stand.
              </p>
              <form method="post" action={`/events/${event.id}/bracket-action`} class="participant-row">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="bracket_id" value={bracket.id} />
                <input type="hidden" name="action" value="format" />
                <label>
                  Matches
                  <select name="best_of">
                    {BEST_OF_CHOICES.map((n) => (
                      <option value={n} selected={bracket.best_of === n}>{n === 1 ? 'Best of 1' : `Best of ${n}`}</option>
                    ))}
                  </select>
                </label>
                <label>
                  Final
                  <select name="final_best_of">
                    <option value="" selected={bracket.final_best_of === null}>same as the rest</option>
                    {BEST_OF_CHOICES.map((n) => (
                      <option value={n} selected={bracket.final_best_of === n}>{n === 1 ? 'Best of 1' : `Best of ${n}`}</option>
                    ))}
                  </select>
                </label>
                <button class="btn btn-ghost" type="submit">Save</button>
              </form>
              <h3>Third place</h3>
              <p class="event-meta">
                {totalRounds < 2
                  ? 'A bracket needs semifinals before it can have a third-place match.'
                  : bracket.bronze
                    ? 'The beaten semifinalists play for third. The match sits beside the final and seats them as the semifinals are decided.'
                    : 'Off: the two beaten semifinalists both finish without a place, and the podium names first and second only.'}
              </p>
              {totalRounds >= 2 && (
                <form method="post" action={`/events/${event.id}/bracket-action`}>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="bracket_id" value={bracket.id} />
                  <input type="hidden" name="action" value="bronze" />
                  <input type="hidden" name="on" value={bracket.bronze ? '0' : '1'} />
                  <button
                    class="btn btn-ghost"
                    type="submit"
                    data-confirm={bracket.bronze ? 'Remove the third-place match? Its result goes with it.' : undefined}
                  >
                    {bracket.bronze ? 'Remove the third-place match' : 'Add a third-place match'}
                  </button>
                </form>
              )}
              <h3>Substitute</h3>
              {benchKeys.length === 0 ? (
                <p class="event-meta">
                  Everyone on the roster is in the draw. Add the substitute first ({event.team_size != null ? 'a team under Manage participants' : 'a walk-in, or their own signup'}), then pick them here.
                </p>
              ) : (
                <form method="post" action={`/events/${event.id}/bracket-action`} class="participant-row">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="bracket_id" value={bracket.id} />
                  <input type="hidden" name="action" value="replace" />
                  <label>
                    Out
                    <select name="from">
                      {drawKeys.map((key) => <option value={key}>{nameOf(key)?.name ?? 'Unknown'}</option>)}
                    </select>
                  </label>
                  <label>
                    In
                    <select name="to">
                      {benchKeys.map((key) => <option value={key}>{nameOf(key)?.name ?? 'Unknown'}</option>)}
                    </select>
                  </label>
                  <button class="btn btn-ghost btn-sm" type="submit">Replace</button>
                </form>
              )}
              <p class="event-meta">A substitute takes over the place and any results; team names change under Manage participants on the event page.</p>

              <h3>This bracket</h3>
              <form method="post" action={`/events/${event.id}/bracket-action`} class="participant-row">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="bracket_id" value={bracket.id} />
                <input type="hidden" name="action" value="rename" />
                <label>
                  Name
                  <input name="name" value={bracket.name} maxlength="40" required />
                </label>
                <button class="btn btn-ghost btn-sm" type="submit">Rename</button>
              </form>
              <form method="post" action={`/events/${event.id}/bracket-action`}>
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="bracket_id" value={bracket.id} />
                <input type="hidden" name="action" value="regenerate" />
                <details class="entrant-pick">
                  <summary>Choose who is drawn (everyone on the roster by default)</summary>
                  <label class="check check-standalone">
                    <input type="checkbox" name="pick_entrants" /> <span>Draw only the ones ticked below</span>
                  </label>
                  <div class="entrant-list">
                    {poolKeys.map((key) => (
                      <label class="check">
                        <input type="checkbox" name="entrant" value={key} checked={inDraw.has(key)} />
                        <span>{nameOf(key)?.name ?? 'Unknown'}</span>
                      </label>
                    ))}
                  </div>
                </details>
                <button class="btn btn-ghost" type="submit" data-confirm="Redraw this bracket from scratch? Results are lost and it becomes a draft again.">
                  Regenerate this bracket (new random seeding, results reset)
                </button>
              </form>
              <form method="post" action={`/events/${event.id}/bracket-action`}>
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="bracket_id" value={bracket.id} />
                <input type="hidden" name="action" value="delete" />
                <button class="btn btn-danger btn-sm" type="submit" data-confirm="Delete this bracket, with its results? The event's other brackets stay.">Delete this bracket</button>
              </form>
            </>
          )}

          <h3>Another bracket</h3>
          <p class="event-meta">
            An event can run more than one: a main draw and a plate, a bracket per game, a group each. Each is
            named, drawn and put live on its own, and gets its own pinned message in Discord.
          </p>
          <form method="post" action={`/events/${event.id}/bracket-action`}>
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="action" value="add" />
            <label>
              Name
              <input name="name" maxlength="40" placeholder={brackets.length === 0 ? 'Main bracket' : `Bracket ${brackets.length + 1}`} />
            </label>
            <details class="entrant-pick">
              <summary>Choose who is in it (everyone on the roster by default)</summary>
              <label class="check check-standalone">
                <input type="checkbox" name="pick_entrants" /> <span>Draw only the ones ticked below</span>
              </label>
              <div class="entrant-list">
                {poolKeys.map((key) => (
                  <label class="check">
                    <input type="checkbox" name="entrant" value={key} checked />
                    <span>{nameOf(key)?.name ?? 'Unknown'}</span>
                  </label>
                ))}
              </div>
            </details>
            <button class="btn btn-ghost" type="submit">Add a bracket</button>
          </form>
        </section>
      )}
    </>
  )}
</Base>

<script>
  // Display mode (?display): hide the site chrome, scale the chart to fill
  // the screen, and refresh it every 10 seconds by fetching this same page
  // and swapping the bracket region in place — no flicker, no full reload.
  // Same-origin fetch, so the CSP connect-src 'self' covers it.
  if (new URLSearchParams(location.search).has('display')) {
    document.documentElement.classList.add('display-mode');

    // CSS zoom, not transform: zoom takes part in layout, so the scroll
    // container and centering behave without any manual geometry. Never
    // shrinks below natural size (min 1).
    const fit = () => {
      const chart = document.querySelector<HTMLElement>('.bracket');
      if (!chart) return;
      chart.style.zoom = '';
      const width = chart.offsetWidth;
      const height = chart.offsetHeight;
      if (!width || !height) return;
      // Fit to the scroll box, not the window: the page padding around it
      // would otherwise let the zoomed chart overflow by a few pixels, and
      // centring then hides the first letter of the round label.
      const box = chart.parentElement as HTMLElement;
      const availWidth = box.clientWidth - 4;
      const availHeight = window.innerHeight - chart.getBoundingClientRect().top - 32;
      const scale = Math.max(1, Math.min(availWidth / width, availHeight / height, 4));
      chart.style.zoom = String(scale);
    };

    const refresh = async () => {
      try {
        const response = await fetch(location.href);
        if (!response.ok) return;
        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
        const fresh = doc.querySelector('#bracket-live');
        const current = document.querySelector('#bracket-live');
        if (fresh && current && fresh.innerHTML !== current.innerHTML) {
          current.innerHTML = fresh.innerHTML;
          fit();
        }
      } catch {
        // transient network errors: keep showing the last good chart
      }
    };

    window.addEventListener('resize', fit);
    window.addEventListener('load', fit);
    // fonts settle a beat after load; fit repeatedly to land on final size
    fit();
    setTimeout(fit, 400);
    setTimeout(fit, 1500);
    setInterval(refresh, 10_000);
  }
</script>
