                {signups.map((s) => (
                  <li>
                    <form method="post" action={`/events/${event.id}/edit-signup`} class="participant-row">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <span class="participant-name">{s.username}{questions.length > 0 && answerLine(s.discord_id) && <small class="participant-answers">{answerLine(s.discord_id)}</small>}</span>
                      <select name="status">
                        <option value="yes" selected={s.status === 'yes'}>Going</option>
                        <option value="maybe" selected={s.status === 'maybe'}>Maybe</option>
                      </select>
                      {isTeamEvent && (
                        <select name="event_team_id">
                          <option value="" selected={s.event_team_id === null}>No team</option>
                          {eventTeams.map((team) => (
                            <option value={team.id} selected={s.event_team_id === team.id}>{team.name}</option>
                          ))}
                        </select>
                      )}
                      {isTeamEvent && event.team_reserves > 0 && (
                        <>
                          <input type="hidden" name="reserve_set" value="1" />
                          <label class="check">
                            <input type="checkbox" name="reserve" checked={s.reserve === 1} /> <span>reserve</span>
                          </label>
                        </>
                      )}
                      <button class="btn btn-ghost" type="submit">Save</button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
            <div class="add-forms">
            {tickMembers.length > 0 && (() => {
              const linked = tickMembers.filter((m) => m.discord_id !== null);
              const here = new Set(signups.map((sg) => sg.discord_id));
              const away = linked.filter((m) => !here.has(m.discord_id!));
              return linked.length > 0 ? (
                <form method="post" action={`/events/${event.id}/add-participant`} class="participant-row">
                  <input type="hidden" name="csrf" value={csrf} />
                  <label>Member
                    <select name="register_id" required>
                      {away.length > 0 && (
                        <optgroup label="Not on the roster">
                          {away.map((m) => <option value={m.register_id}>{m.full_name}{m.discord_name ? ` (${m.discord_name})` : ''}</option>)}
                        </optgroup>
                      )}
                      {away.length < linked.length && (
                        <optgroup label="Already here — pick to move them">
                          {linked.filter((m) => here.has(m.discord_id!)).map((m) => (
                            <option value={m.register_id}>{m.full_name}{m.discord_name ? ` (${m.discord_name})` : ''}</option>
                          ))}
                        </optgroup>
                      )}
                    </select>
                  </label>
                  <select name="status">
                    <option value="yes">Going</option>
                    <option value="maybe">Maybe</option>
                  </select>
                  {isTeamEvent && eventTeams.length > 0 && (
                    <select name="event_team_id">
                      <option value="">No team</option>
                      {eventTeams.map((team) => (
                        <option value={team.id}>{team.name}</option>
                      ))}
                    </select>
                  )}
                  <button class="btn btn-primary" type="submit">Add member</button>
                </form>
              ) : null;
            })()}
            <form method="post" action={`/events/${event.id}/add-participant`} class="participant-row">
              <input type="hidden" name="csrf" value={csrf} />
              <label>Name <input name="name" required maxlength="60" placeholder="Walk-in participant" /></label>
              <select name="status">
                <option value="yes">Going</option>
                <option value="maybe">Maybe</option>
              </select>
              {isTeamEvent && eventTeams.length > 0 && (
                <select name="event_team_id">
                  <option value="">No team</option>
                  {eventTeams.map((team) => (
                    <option value={team.id}>{team.name}</option>
                  ))}
                </select>
              )}
              <button class="btn btn-primary" type="submit">Add participant</button>
            </form>
            </div>
            <div class="ticks-box" id="ticks">
              <h3 class="section-label">Ticks</h3>
              <p class="event-meta">
                A tick is what the board notes by hand for the season pass: helping at this event, for one. Members only, each tick once per event.
                The whole season's ticks and the list of kinds are on the <a href="/board/season#ticks">season page</a>.
              </p>
              {eventTicks.length > 0 && (
                <ul class="tick-list">
                  {eventTicks.map((t) => (
                    <li>
                      <span><strong>{t.member}</strong> · {t.kind}{t.note ? ` · ${t.note}` : ''}{t.xp > 0 ? ` · ${t.xp} XP` : ''} <small class="queue-meta">by {t.given_by}</small></span>
                      <form method="post" action="/board/ticks" class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="tick_id" value={t.id} />
                        <input type="hidden" name="back" value={`/events/${event.id}`} />
                        <button class="btn btn-ghost btn-sm" type="submit" data-confirm={`Remove ${t.member}'s tick "${t.kind}"?`}>Remove</button>
                      </form>
                    </li>
                  ))}
                </ul>
              )}
              {tickKinds.length > 0 && tickMembers.length > 0 && (() => {
                const here = new Set(signups.map((s) => s.discord_id));
                const atEvent = tickMembers.filter((m) => m.discord_id !== null && here.has(m.discord_id));
                const others = tickMembers.filter((m) => !atEvent.includes(m));
                return (
                  <form method="post" action="/board/ticks" class="participant-row tick-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="give" />
                    <input type="hidden" name="event_id" value={event.id} />
                    <input type="hidden" name="back" value={`/events/${event.id}`} />
                    <label>Tick
                      <select name="kind_id" required>
                        {tickKinds.map((k) => <option value={k.id}>{k.name} · {kindWorth(k)}</option>)}
                      </select>
                    </label>
                    <label>To
                      <select name="register_id" required>
                        {atEvent.length > 0 && (
                          <optgroup label="At this event">
                            {atEvent.map((m) => <option value={m.register_id}>{m.full_name}{m.discord_name ? ` (${m.discord_name})` : ''}</option>)}
                          </optgroup>
                        )}
                        <optgroup label={atEvent.length > 0 ? 'Other members' : 'Members'}>
                          {others.map((m) => <option value={m.register_id}>{m.full_name}{m.discord_name ? ` (${m.discord_name})` : ''}</option>)}
                        </optgroup>
                      </select>
                    </label>
                    <label>Note <input name="note" maxlength="200" placeholder="optional" /></label>
                    <button class="btn btn-primary btn-sm" type="submit">Give tick</button>
                  </form>
                );
              })()}
            </div>
          </details>
          <details class="admin-edit" id="photos-admin" open={['photos_added', 'photo_removed', 'credit_saved'].includes(okKey) || ['photo_missing', 'photo_bad'].includes(errKey)}>
            <summary><b>Photos</b><span class="admin-edit-meta">{photos.length === 0 ? 'none' : photos.length}</span><span class="admin-edit-hint">upload afterwards, and the credit</span></summary>
            <form method="post" action={`/events/${event.id}/photos`} enctype="multipart/form-data" class="app-form" id="photo-form">
              <input type="hidden" name="csrf" value={csrf} />
              <label>Add photos <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required id="photo-input" /></label>
              <p class="queue-meta">Pick several at once. The page shrinks them to 1600 px and makes thumbnails before uploading, so phone photos are fine. Shown on this page and on the history page; up to 60 per event.</p>
              <button class="btn btn-primary" type="submit" id="photo-submit">Upload</button>
            </form>
            <form method="post" action={`/events/${event.id}/photos`} class="app-form-row">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value="credit" />
              <label>Photo credit <input type="text" name="credit" value={event.photo_credit ?? ''} maxlength="120" placeholder="Photos: Firstname Lastname" /></label>
              <button class="btn btn-ghost btn-sm" type="submit">Save</button>
            </form>
            <p class="queue-meta">Shown under the pictures here and on the history page. Empty to clear.</p>
            {photos.length > 0 && (
              <ul class="photo-grid photo-grid-admin">
                {photos.map((p) => (
                  <li>
                    <img src={`/events/${event.id}/photos/${p.id}?thumb`} alt="" loading="lazy" />
                    <form method="post" action={`/events/${event.id}/photos`} class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="action" value="remove" />
                      <input type="hidden" name="photo_id" value={p.id} />
                      <button class="chip-remove" type="submit" title="Remove photo" data-confirm="Remove this photo?">×</button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
          </details>
          <details class="admin-edit admin-danger">
            <summary><b>Danger zone</b><span class="admin-edit-hint">cancel the event, delete it for good</span></summary>
            <p class="event-meta">
              Deleting erases the event with its signups, teams and bracket,
              and removes the Discord announcement. Cancelling (above) is the
              right call for a real event that fell through.
            </p>
            <form method="post" action={`/events/${event.id}/delete`}>
              <input type="hidden" name="csrf" value={csrf} />
              <button class="btn btn-danger" type="submit" data-confirm="Delete this event for good, with its signups, teams, bracket and tickets? This cannot be undone.">Delete this event permanently</button>
            </form>
          </details>
        </details>
      )}
      </div>
      </div>
    </>
  )}
</Base>

<script>
  // Photos: shrink in the browser before upload, a 1600 px picture and a
  // 480 px thumbnail each, both JPEG. The server takes them as they come
  // when this doesn't run, up to its size limit.
  const photoForm = document.getElementById('photo-form') as HTMLFormElement | null;
  const photoInput = document.getElementById('photo-input') as HTMLInputElement | null;
  if (photoForm && photoInput && 'createImageBitmap' in window) {
    const shrink = async (file: File, max: number, quality: number): Promise<Blob> => {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(bitmap.width * scale));
      canvas.height = Math.max(1, Math.round(bitmap.height * scale));
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      return new Promise((resolve) => canvas.toBlob((b) => resolve(b!), 'image/jpeg', quality));
    };
    photoForm.addEventListener('submit', async (event) => {
      if (photoForm.dataset.ready === '1') return;
      event.preventDefault();
      const submit = document.getElementById('photo-submit') as HTMLButtonElement;
      submit.disabled = true;
      submit.textContent = 'Shrinking…';
      const body = new FormData(photoForm);
      body.delete('photos');
      body.delete('thumbs');
      for (const file of Array.from(photoInput.files ?? [])) {
        try {
          body.append('photos', await shrink(file, 1600, 0.85), file.name.replace(/\.[^.]+$/, '') + '.jpg');
          body.append('thumbs', await shrink(file, 480, 0.8), 'thumb.jpg');
        } catch {
          body.append('photos', file, file.name);
        }
      }
      submit.textContent = 'Uploading…';
      const response = await fetch(photoForm.action, { method: 'POST', body, redirect: 'follow' });
      location.href = response.url || location.href;
    });
  }

  // Share: the system share sheet where there is one, the clipboard
  // elsewhere. Hidden until this runs, so without JS there is no dead button.
  const share = document.getElementById('share-event') as HTMLButtonElement | null;
  if (share && (navigator.share || navigator.clipboard)) {
    share.hidden = false;
    share.addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}`;
      const title = share.dataset.title ?? document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {
          /* dismissed */
        }
        return;
      }
      await navigator.clipboard.writeText(url);
      share.textContent = 'Link copied';
    });
  }
</script>
