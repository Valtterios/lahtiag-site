                  <a class="btn btn-primary" href={`/events/${event.id}/bracket?b=${b.id}`}>{b.name}</a>
                ))}
                {event.link_url && <a class="btn btn-ghost" href={event.link_url} rel="noopener">Stream / info link</a>}
              </p>
            )}
          </section>
        )}
        {photos.length > 0 && (
          <section class="event-card" id="photos">
            <h2 class="section-label">Photos</h2>
            <ul class="photo-grid">
              {photos.map((p) => (
                <li>
                  <a href={`/events/${event.id}/photos/${p.id}`} target="_blank" rel="noopener">
                    <img src={`/events/${event.id}/photos/${p.id}?thumb`} alt="" loading="lazy" />
                  </a>
                </li>
              ))}
            </ul>
            {event.photo_credit && <p class="queue-meta">{event.photo_credit}</p>}
          </section>
        )}
      {!isTeamEvent && (signups.length > 0 || waitlist.length > 0) && (
        <section class="event-card" id="who">
          <div class="roster-head">
            <h2 class="section-label">Who's coming</h2>
            <p class="roster-count">
              {going.length} going{event.capacity !== null ? ` of ${event.capacity}` : ''}
              {maybe.length > 0 && <> · {maybe.length} maybe</>}
              {waitlist.length > 0 && <> · {waitlist.length} waiting</>}
            </p>
          </div>
          {going.length > 0 && (
            <ul class="roster">
              {going.map((s) => (
                <li class="person">
                  <img class="person-face" src={avatarUrl(s.discord_id, s.avatar_hash)} width="28" height="28" alt="" loading="lazy" />
                  <span class="person-name">{s.username}</span>
                  {session?.isAdmin && s.is_member !== 1 && <span class="member-mark member-mark-guest" title="Not in the member register">guest</span>}
                  {session?.isAdmin && (
                    <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <button class="chip-remove" type="submit" title="Remove signup">×</button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
          )}
          {maybe.length > 0 && (
            <>
              <h3 class="roster-label">Maybe</h3>
              <ul class="roster">
                {maybe.map((s) => (
                  <li class="person person-maybe">
                    <img class="person-face" src={avatarUrl(s.discord_id, s.avatar_hash)} width="28" height="28" alt="" loading="lazy" />
                    <span class="person-name">{s.username}</span>
                    {session?.isAdmin && s.is_member !== 1 && <span class="member-mark member-mark-guest" title="Not in the member register">guest</span>}
                    {session?.isAdmin && (
                      <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="discord_id" value={s.discord_id} />
                        <button class="chip-remove" type="submit" title="Remove signup">×</button>
                      </form>
                    )}
                  </li>
                ))}
              </ul>
            </>
          )}
          {waitlist.length > 0 && (
            <>
              <h3 class="roster-label">Waitlist</h3>
              {session?.isAdmin ? (
                <ul class="roster">
                  {waitlist.map((w, i) => (
                    <li class="person person-wait">
                      <span class="person-place">{i + 1}</span>
                      <img class="person-face" src={avatarUrl(w.discord_id, w.avatar_hash)} width="28" height="28" alt="" loading="lazy" />
                      <span class="person-name">{w.username}</span>
                      <form method="post" action={`/events/${event.id}/waitlist`} class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="action" value="admit" />
                        <input type="hidden" name="discord_id" value={w.discord_id} />
                        <button class="chip-remove chip-admit" type="submit" title="Let in: they go to Going, whatever the capacity">✓</button>
                      </form>
                      <form method="post" action={`/events/${event.id}/waitlist`} class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="action" value="leave" />
                        <input type="hidden" name="discord_id" value={w.discord_id} />
                        <button class="chip-remove" type="submit" title="Take off the waitlist">×</button>
                      </form>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="queue-meta">
                  {waitlist.length} waiting for a seat{myPlace !== null ? <>, you at <strong>#{myPlace}</strong></> : ''}. A freed seat goes to the first in line.
                </p>
              )}
            </>
          )}
        </section>
      )}

      {isTeamEvent && (
        <section class="event-card" id="teams">
          <h2 class="section-label">Teams</h2>
          {eventTeams.length === 0 && (
            <p class="app-empty">No teams yet. Start the first one!</p>
          )}
          {eventTeams.map((team) => {
            const members = teamMembers(team.id);
            // A team is its starting line-up plus whatever bench the event
            // allows; it is full only when both are.
            const lineUp = members.filter((m) => m.reserve !== 1);
            const bench = members.filter((m) => m.reserve === 1);
            const slotsLeft = event.team_size! + event.team_reserves - members.length;
            const inThisTeam = mine?.event_team_id === team.id;
            const captain = session !== null && !session.isAdmin && team.created_by === session.discordId && open;
            return (
              <div class="team-card">
                <h3>
                  {team.name}
                  <span class="event-meta"> {lineUp.length} / {event.team_size}{event.team_reserves > 0 ? `, ${bench.length} / ${event.team_reserves} on the bench` : ''}</span>
                </h3>
                <ul class="roster">
                  {members.length === 0 && <li class="queue-meta">Empty</li>}
                  {session?.isAdmin
                    ? members.map((m) => (
                        <li class="person">
                          <img class="person-face" src={avatarUrl(m.discord_id, m.avatar_hash)} width="28" height="28" alt="" loading="lazy" />
                          <span class="person-name">{m.username}</span>
                          {m.discord_id === team.created_by && <span class="member-mark captain-mark" title="Founded the team">captain</span>}
                          {m.reserve === 1 && <span class="member-mark reserve-mark" title="On the bench, not in the starting line-up">reserve</span>}
                          {m.is_member !== 1 && <span class="member-mark member-mark-guest" title="Not in the member register">guest</span>}
                          {event.team_reserves > 0 && (
                            <form method="post" action={`/events/${event.id}/admin-team`} class="inline-form">
                              <input type="hidden" name="csrf" value={csrf} />
                              <input type="hidden" name="action" value="place" />
                              <input type="hidden" name="discord_id" value={m.discord_id} />
                              <input type="hidden" name="reserve" value={m.reserve === 1 ? '0' : '1'} />
                              <button class="chip-remove chip-swap" type="submit" title={m.reserve === 1 ? 'Into the starting line-up' : 'Onto the bench'}>{m.reserve === 1 ? '↑' : '↓'}</button>
                            </form>
                          )}
                          <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                            <input type="hidden" name="csrf" value={csrf} />
                            <input type="hidden" name="discord_id" value={m.discord_id} />
                            <button class="chip-remove" type="submit" title="Remove signup">×</button>
                          </form>
                        </li>
                      ))
                    : captain
                      ? members.map((m) => (
                          <li class="person">
                            <img class="person-face" src={avatarUrl(m.discord_id, m.avatar_hash)} width="28" height="28" alt="" loading="lazy" />
                            <span class="person-name">{m.username}</span>
                            {m.discord_id === team.created_by && <span class="member-mark captain-mark" title="Founded the team">captain</span>}
                            {m.reserve === 1 && <span class="member-mark reserve-mark" title="On the bench, not in the starting line-up">reserve</span>}
                            {event.team_reserves > 0 && (
                              <form method="post" action={`/events/${event.id}/team-captain`} class="inline-form">
                                <input type="hidden" name="csrf" value={csrf} />
                                <input type="hidden" name="action" value="place" />
                                <input type="hidden" name="event_team_id" value={team.id} />
                                <input type="hidden" name="discord_id" value={m.discord_id} />
                                <input type="hidden" name="reserve" value={m.reserve === 1 ? '0' : '1'} />
                                <button class="chip-remove chip-swap" type="submit" title={m.reserve === 1 ? 'Into the starting line-up' : 'Onto the bench'}>{m.reserve === 1 ? '↑' : '↓'}</button>
                              </form>
                            )}
                            {m.discord_id !== session!.discordId && (
                              <form method="post" action={`/events/${event.id}/team-captain`} class="inline-form">
                                <input type="hidden" name="csrf" value={csrf} />
                                <input type="hidden" name="action" value="kick" />
                                <input type="hidden" name="event_team_id" value={team.id} />
                                <input type="hidden" name="discord_id" value={m.discord_id} />
                                <button class="chip-remove" type="submit" title="Take out of the team">×</button>
                              </form>
                            )}
                          </li>
                        ))
                      : members.map((m) => (
                          <li class="person">
                            <img class="person-face" src={avatarUrl(m.discord_id, m.avatar_hash)} width="28" height="28" alt="" loading="lazy" />
                            <span class="person-name">{m.username}</span>
                            {m.discord_id === team.created_by && <span class="member-mark captain-mark" title="Founded the team">captain</span>}
                            {m.reserve === 1 && <span class="member-mark reserve-mark" title="On the bench, not in the starting line-up">reserve</span>}
                          </li>
                        ))}
                </ul>
                {captain && slotsLeft > 0 && freeAgents.length > 0 && (
                  <form method="post" action={`/events/${event.id}/team-captain`} class="participant-row">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="add" />
                    <input type="hidden" name="event_team_id" value={team.id} />
                    <label>
                      Add to the team
                      <select name="discord_id">
                        {freeAgents.map((s) => <option value={s.discord_id}>{s.username}</option>)}
                      </select>
                    </label>
                    <button class="btn btn-ghost btn-sm" type="submit">Add</button>
                  </form>
                )}
                {session && open && !inThisTeam && slotsLeft > 0 && (!ticketed || hasTicket) && (
                  <form method="post" action={`/events/${event.id}/team`} class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="join" />
                    <input type="hidden" name="event_team_id" value={team.id} />
                    <button class="btn btn-ghost" type="submit">
                      {lineUp.length >= event.team_size! ? 'Join as a reserve' : 'Join this team'}
                    </button>
                  </form>
                )}
                {inThisTeam && open && (
                  <form method="post" action={`/events/${event.id}/team`} class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="leave" />
                    <button class="btn-link" type="submit">Leave team</button>
                  </form>
                )}
              </div>
            );
          })}

          {freeAgents.length > 0 && (
            <>
              <h3 class="roster-label">Looking for a team</h3>
              <ul class="roster">
                {freeAgents.map((s) => (
                  <li class="person">
                    <img class="person-face" src={avatarUrl(s.discord_id, s.avatar_hash)} width="28" height="28" alt="" loading="lazy" />
                    <span class="person-name">{s.username}</span>
                    {session?.isAdmin && s.is_member !== 1 && <span class="member-mark member-mark-guest" title="Not in the member register">guest</span>}
                    {session?.isAdmin && (
                      <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="discord_id" value={s.discord_id} />
                        <button class="chip-remove" type="submit" title="Remove signup">×</button>
                      </form>
                    )}
                  </li>
                ))}
              </ul>
            </>
          )}

          {session && open && (!ticketed || hasTicket) && (
            <div class="team-actions">
              {!isFull && (
                <form method="post" action={`/events/${event.id}/team`} class="app-form app-form-row">
