---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import SessionBox from '../../../components/SessionBox.astro';
import { currentSession, ensureCsrf, viewAs } from '../../../lib/guard';
import ViewAs from '../../../components/ViewAs.astro';
import {
  getEvent,
  listSignups,
  listEventTeams,
  getBracket,
  coverVersion,
  listTicketTypes,
  signupAccess,
  getTicketForHolder,
  repairTicketSignups,
  salesSummary,
  listEventQuestions,
  getAnswers,
  listAllAnswers,
  type TicketTypeWithSales,
} from '../../../lib/db';
import { questionOptions, answersComplete, QUESTION_KINDS } from '../../../lib/questions';
import { purchaseOffer, pendingPurchaseFor, resumablePurchase } from '../../../lib/purchases';
import { readBasket, basketCount } from '../../../lib/basket';
import { stripeConfigured } from '../../../lib/stripe';
import { formatHelsinkiRange, unixToHelsinkiInputs, formatHelsinki } from '../../../lib/time';

const nowSeconds = Math.floor(Date.now() / 1000);

const id = Number(Astro.params.id);
const event = Number.isInteger(id) ? await getEvent(env.DB, id) : null;

if (!event) {
  Astro.response.status = 404;
}

const view = viewAs(await currentSession(Astro.request, env), Astro.url);
const session = view.session;
const csrf = ensureCsrf(Astro.cookies);


const eventTeams = event?.team_size != null ? await listEventTeams(env.DB, event.id) : [];
const hasBracket = event ? (await getBracket(env.DB, event.id)).length > 0 : false;
const coverAt = event ? await coverVersion(env.DB, event.id) : null;
// Blank lines split the description into paragraphs; single line breaks stay.
const paragraphs = event?.description ? event.description.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];

// Tickets: an event with active ticket types sells tickets instead of
// taking plain signups; a paid ticket is the signup. Membership gating
// (members-only, reserved seats) applies to both paths.
const types: TicketTypeWithSales[] = event ? await listTicketTypes(env.DB, event.id) : [];
const activeTypes = types.filter((t) => t.active === 1);
// Team events sell tickets too: the paid ticket is the entry, and
// forming a team needs one.
const ticketed = activeTypes.length > 0;
// A paid ticket on an account is a signup; put back any that went missing.
if (event && ticketed) await repairTicketSignups(env.DB, event.id, nowSeconds);
const signups = event ? await listSignups(env.DB, event.id) : [];
const offers = new Map<number, Awaited<ReturnType<typeof purchaseOffer>>>();
if (event && ticketed) {
  for (const t of activeTypes) offers.set(t.id, await purchaseOffer(env.DB, event, t, session?.discordId ?? null, nowSeconds));
}
const myTicket = event && session ? await getTicketForHolder(env.DB, event.id, session.discordId) : null;
const access = event && session ? await signupAccess(env.DB, event, session.discordId, true) : null;
const sales = event && session?.isAdmin && types.length > 0 ? await salesSummary(env.DB, event.id) : null;
const hasTicket = myTicket?.status === 'paid';
const pendingPurchase = event && session ? await pendingPurchaseFor(env.DB, session.discordId, nowSeconds) : null;
const resume = resumablePurchase(pendingPurchase, nowSeconds);
const basket = readBasket(Astro.cookies);
const inBasket = (typeId: number) => basket.find((l) => l.kind === 'ticket' && l.id === typeId)?.count ?? 0;
const basketTotal = basketCount(basket);

// Questions the board asks on this event, and what the viewer answered.
const questions = event ? await listEventQuestions(env.DB, event.id) : [];
const myAnswers = event && session ? await getAnswers(env.DB, event.id, { discordId: session.discordId }) : new Map<number, string>();
const answersOk = answersComplete(questions, myAnswers);
const allAnswers = event && session?.isAdmin && questions.length > 0 ? await listAllAnswers(env.DB, event.id) : new Map<string, Map<number, string>>();
const answerLine = (discordId: string) =>
  questions
    .map((q) => ({ label: q.label, value: allAnswers.get(`u:${discordId}`)?.get(q.id) ?? '' }))
    .filter((a) => a.value !== '')
    .map((a) => `${a.label}: ${a.value}`)
    .join(' · ');
const paymentsOn = stripeConfigured(env);
const euro = (cents: number) => `${(cents / 100).toFixed(2)} €`;
const closeInputs = (t: TicketTypeWithSales) => (t.sales_close_at === null ? { date: '', time: '' } : unixToHelsinkiInputs(t.sales_close_at));

const going = signups.filter((signup) => signup.status === 'yes');
const maybe = signups.filter((signup) => signup.status === 'maybe');
const mine = session ? signups.find((signup) => signup.discord_id === session.discordId) : undefined;

// Solo events: capacity counts people. Team events: capacity counts teams.
const isTeamEvent = event?.team_size != null;
const teamMembers = (teamId: number) => signups.filter((s) => s.event_team_id === teamId);
const freeAgents = going.filter((s) => s.event_team_id === null);
const isFull = !isTeamEvent
  ? event?.capacity != null &&
    going.filter((s) => s.discord_id !== session?.discordId).length >= event.capacity
  : event?.capacity != null && eventTeams.length >= event.capacity;
const signupsClosed = event?.signups_closed_at != null;
const open = event ? event.cancelled_at === null && !signupsClosed : false;

// Flashes from board actions open the (otherwise folded) board tools.
const ADMIN_OPEN = new Set(['cover_saved', 'cover_removed', 'cover_missing', 'cover_bad', 'type_saved', 'type_deleted', 'question_saved', 'reinstated', 'ticket_holder', 'bad_time', 'forbidden', 'discord_down']);
const FLASH: Record<string, string> = {
  full: 'This event is full.',
  team_full: 'That team is already full.',
  dup_name: 'A team with that name already exists.',
  not_team_event: 'This event does not take team signups.',
  cancelled: 'This event has been cancelled and signups are closed.',
  closed: 'Signups are closed for this event.',
  bad_time: "That date and time didn't parse.",
  signin: 'Sign in with Discord first.',
  csrf: 'The form was stale. Try again.',
  bad_input: "That didn't save. Check the values: reserved seats can't exceed the capacity, a team name is 1 to 40 characters.",
  missing: 'No such team on this event.',
  forbidden: 'That needs the admin role in Discord.',
  discord_down: "Discord didn't answer while re-checking your role. Try again.",
  members_only: 'This event is for members. Link your membership on the join page, or apply.',
  reserved: 'The remaining seats are reserved for members.',
  sold_out: 'That ticket type is sold out.',
  sales_closed: 'Sales for that ticket have closed.',
  has_ticket: 'You already have a ticket for this event.',
  payments_off: 'Card payments are not set up yet. Free tickets work; paid ones at the door.',
  stripe_down: "The payment page didn't open. Try again in a moment.",
  cancelled_checkout: 'Payment cancelled. Nothing was charged. Continue below, or release the seat to pick another ticket.',
  answers: 'Please answer the required questions.',
  needs_ticket: 'This event needs a ticket first. Buy one above, then form or join a team.',
  cover_missing: 'Pick an image file first.',
  cover_bad: 'The cover must be a JPEG, PNG or WebP under 1.5 MB.',
  ticket_holder: 'That person holds a paid ticket, so they are going. Refund it in Stripe to remove them.',
};
// Short tags on ticket rows for why a type is not open to this person.
const TYPE_TAGS: Record<string, string> = {
  sold_out: 'Sold out',
  full: 'Full',
  reserved: 'Members only now',
  sales_closed: 'Sales closed',
  cancelled: 'Cancelled',
  has_ticket: 'Yours',
};
const OK: Record<string, string> = {
  reinstated: 'The event is back on. The Discord cancellation line was removed.',
  released: 'Released. Nothing was charged.',
  added: 'Added to your basket.',
  type_saved: 'Ticket type saved.',
  type_deleted: 'Ticket type removed (or retired, if tickets were sold on it).',
  question_saved: 'Questions saved.',
  answers_saved: 'Your details are saved.',
  cover_saved: 'Cover image saved.',
  cover_removed: 'Cover image removed.',
};
const flash = FLASH[Astro.url.searchParams.get('err') ?? ''] ?? OK[Astro.url.searchParams.get('ok') ?? ''] ?? null;
---
<Base
  title={event ? event.title : 'Event not found'}
  description={event ? `${event.title}, ${formatHelsinkiRange(event.starts_at, event.ends_at)}` : undefined}
  image={event && coverAt !== null ? `${Astro.url.origin}/events/${event.id}/cover?v=${coverAt}` : undefined}
  wide
>
  {!event ? (
    <article class="prose">
      <h1>No such event</h1>
      <p>Nothing lives at this id. Back to <a href="/events">events</a>.</p>
    </article>
  ) : (
    <>
      <div class="event-layout">
      <header class="event-head">
        {coverAt !== null && <img class="event-cover" src={`/events/${event.id}/cover?v=${coverAt}`} alt="" width="1200" height="630" />}
        <div class="event-head-body">
          <h1>{event.title}</h1>
          {event.organizers && <p class="event-by">by {event.organizers}</p>}
          <p class="event-actions">
            <a class="btn btn-ghost btn-sm" href={`/events/${event.id}/event.ics`}>Add to calendar</a>
            <button class="btn btn-ghost btn-sm" type="button" id="share-event" data-title={event.title} hidden>Share</button>
          </p>
          <ul class="event-facts">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
              <span>
                {formatHelsinkiRange(event.starts_at, event.ends_at)}
                {event.starts_at <= nowSeconds && event.ends_at !== null && event.ends_at > nowSeconds && <> <span class="live-badge">Happening now</span></>}
              </span>
            </li>
            {event.location && (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                <span>{event.location}</span>
              </li>
            )}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
              <span>
                {isTeamEvent
                  ? `Teams of ${event.team_size}: ${eventTeams.length}${event.capacity !== null ? ` / ${event.capacity}` : ''} teams, ${going.length} players in`
                  : `${going.length}${event.capacity !== null ? ` / ${event.capacity}` : ''} going${maybe.length > 0 ? `, ${maybe.length} maybe` : ''}`}
                {ticketed && event.capacity !== null && going.length >= event.capacity && <> <span class="status-badge status-muted">Sold out</span></>}
              </span>
            </li>
            {hasTicket && myTicket && (
              <li class="event-fact-mine">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3a3 3 0 0 1 0-6V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z" /><path d="M13 5v2" /><path d="M13 17v2" /><path d="M13 11v2" /></svg>
                <span>You have a ticket · {myTicket.type_name}{myTicket.checked_in_at ? ' · checked in' : ''} · <a href={`/tickets/${myTicket.code}`}>Show ticket</a></span>
              </li>
            )}
          </ul>
          {(event.cancelled_at !== null || (signupsClosed && event.cancelled_at === null) || event.members_only === 1 || event.member_slots !== null) && (
            <p class="event-gating">
              {event.cancelled_at !== null && <span class="status-badge status-danger">Cancelled</span>}
              {signupsClosed && event.cancelled_at === null && <span class="status-badge status-muted">Signups closed</span>}
              {event.members_only === 1 && <span class="status-badge status-member">Members only</span>}
              {event.member_slots !== null && event.members_only !== 1 && (
                <span class="status-badge">{event.member_slots} of {event.capacity} seats reserved for members{access && access.openSeatsLeft !== null && !access.member ? `, ${access.openSeatsLeft} open to everyone` : ''}</span>
              )}
            </p>
          )}
        </div>
      </header>
      <ViewAs mode={view.mode} path={`/events/${event.id}`} />
      <aside class="event-side">
      <SessionBox session={session} csrf={csrf} />
      {flash && <p class="flash">{flash}</p>}

      {ticketed && (
        <section class="tickets-box" id="buy">
          <h2 class="section-label">Tickets</h2>
          {pendingPurchase && (
            <div class="queue-card">
              <div class="queue-body">
                <p class="queue-name">Your payment is not finished</p>
                <p class="queue-meta">{resume ? 'Its seats are held for a while. Continue it, or release it and start over.' : 'Its payment window closed. Release it to start over.'}</p>
              </div>
              <div class="entry-actions">
                {resume && <a class="btn btn-cta" href={resume}>Continue to payment</a>}
                <form method="post" action={`/purchase/${pendingPurchase.id}/release`}>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="next" value={`/events/${event.id}`} />
                  <button class="btn btn-ghost" type="submit">Release</button>
                </form>
              </div>
            </div>
          )}
          <ul class="ticket-types">
            {activeTypes.map((t) => {
              const offer = offers.get(t.id)!;
              const left = t.quantity === null ? null : Math.max(0, t.quantity - t.sold);
              const max = offer.ok ? (offer.own ? 1 : 0) + offer.max_extras : 0;
              const canPay = t.price_cents === 0 || paymentsOn;
              const have = inBasket(t.id);
              return (
                <li class="ticket-type">
                  <div class="ticket-type-main">
                    <p class="ticket-type-name">{t.name}</p>
                    <p class="ticket-type-tags">
                      <span class="ticket-type-price">
                        {t.member_price_cents !== null && t.member_price_cents !== t.price_cents
                          ? `${euro(t.price_cents)} · members ${euro(t.member_price_cents)}`
                          : t.price_cents === 0 ? 'Free' : euro(t.price_cents)}
                      </span>
                      {t.members_only === 1 && <span class="status-badge status-member">Members only</span>}
                      {!offer.ok && offer.reason !== 'members_only' && (
                        <span class="status-badge status-muted">{TYPE_TAGS[offer.reason] ?? offer.reason}</span>
                      )}
                      {offer.ok && max === 0 && <span class="status-badge status-muted">Sold out</span>}
                      {offer.ok && max > 0 && !canPay && <span class="status-badge status-muted">At the door</span>}
                      {offer.ok && max > 0 && left !== null && left <= 10 && <span class="queue-meta">{left} left</span>}
                      {t.sales_close_at !== null && offer.ok && <span class="queue-meta">until {formatHelsinki(t.sales_close_at)}</span>}
                    </p>
                  </div>
                  {offer.ok && max > 0 && canPay ? (
                    <form method="post" action="/basket/add" class="basket-add">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="kind" value="ticket" />
                      <input type="hidden" name="id" value={t.id} />
                      <input type="hidden" name="next" value={`/events/${event.id}`} />
                      {max > 1 && (
                        <select name="count" aria-label="How many tickets">
                          {Array.from({ length: max }, (_, i) => i + 1).map((n) => <option value={n}>{n}</option>)}
                        </select>
                      )}
                      <button class="btn btn-cta" type="submit">{have > 0 ? `In basket (${have}) · Add more` : hasTicket ? 'Add for a friend' : 'Add to basket'}</button>
                    </form>
                  ) : null}
                </li>
              );
            })}
          </ul>
          {basketTotal > 0 && (
            <p class="basket-bar"><strong>{basketTotal} in your basket.</strong> <a class="btn btn-primary btn-sm" href="/checkout">Go to checkout</a></p>
          )}
          <p class="queue-meta">
            {session
              ? 'Tickets are personal and shown as a QR code. You can buy tickets for friends by name at the checkout.'
              : 'Sign in with Discord for member prices and to keep tickets on your account; without Discord, tickets are links you keep.'}{' '}
            <a href="/terms">Terms of sale.</a>
          </p>
        </section>
      )}

      {!ticketed && !isTeamEvent && session && open && access && !access.allowed && (
        <p class="flash">{FLASH[access.reason!]}{access.reason === 'members_only' && <> <a href="/join">Link or apply</a>.</>}</p>
      )}

      {!ticketed && !isTeamEvent && session && open && (!access || access.allowed) && (
        <form method="post" action={`/events/${event.id}/signup`} class={questions.length > 0 ? 'app-form signup-with-questions' : 'signup-bar'} id="signup">
          <input type="hidden" name="csrf" value={csrf} />
          {questions.length > 0 && !mine && <p class="queue-meta">A couple of questions before you sign up:</p>}
          {questions.length > 0 && !mine && questions.map((q) => {
                const value = myAnswers.get(q.id) ?? '';
                return q.kind === 'checkbox' ? (
                  <label class="check check-standalone">
                    <input type="checkbox" name={`q${q.id}`} checked={value === 'yes'} /> <span>{q.label}{q.required ? ' *' : ''}</span>
                  </label>
                ) : q.kind === 'choice' ? (
                  <label>
                    {q.label}{q.required ? ' *' : ''}
                    <select name={`q${q.id}`} required={q.required === 1}>
                      <option value="" selected={value === ''}>Choose…</option>
                      {questionOptions(q).map((o) => <option value={o} selected={value === o}>{o}</option>)}
                    </select>
                  </label>
                ) : (
                  <label>
                    {q.label}{q.required ? ' *' : ''}
                    <input name={`q${q.id}`} maxlength="300" value={value} required={q.required === 1} />
                  </label>
                );
              })}
          <button
            class={`btn ${mine?.status === 'yes' ? 'btn-primary' : 'btn-ghost'}`}
            name="status"
            value="yes"
            disabled={isFull && mine?.status !== 'yes'}
            type="submit"
          >
            {isFull && mine?.status !== 'yes' ? 'Full' : "I'm going"}
          </button>
          <button
            class={`btn ${mine?.status === 'maybe' ? 'btn-primary' : 'btn-ghost'}`}
            name="status"
            value="maybe"
            type="submit"
          >Maybe</button>
          {mine && (
            <button class="btn btn-ghost" name="status" value="remove" type="submit">
              Remove my signup
            </button>
          )}
        </form>
      )}

      {questions.length > 0 && session && open && (mine || hasTicket || (isTeamEvent && !ticketed)) && (
        <section class="self-panel" id="details">
          <h2 class="section-label">Your details for this event</h2>
          {isTeamEvent && !answersOk && <p class="flash">Answer the required questions before forming or joining a team.</p>}
          <form method="post" action={`/events/${event.id}/answers`} class="app-form">
            <input type="hidden" name="csrf" value={csrf} />
            {questions.map((q) => {
                const value = myAnswers.get(q.id) ?? '';
                return q.kind === 'checkbox' ? (
                  <label class="check check-standalone">
                    <input type="checkbox" name={`q${q.id}`} checked={value === 'yes'} /> <span>{q.label}{q.required ? ' *' : ''}</span>
                  </label>
                ) : q.kind === 'choice' ? (
                  <label>
                    {q.label}{q.required ? ' *' : ''}
                    <select name={`q${q.id}`} required={q.required === 1}>
                      <option value="" selected={value === ''}>Choose…</option>
                      {questionOptions(q).map((o) => <option value={o} selected={value === o}>{o}</option>)}
                    </select>
                  </label>
                ) : (
                  <label>
                    {q.label}{q.required ? ' *' : ''}
                    <input name={`q${q.id}`} maxlength="300" value={value} required={q.required === 1} />
                  </label>
                );
              })}
            <button class="btn btn-primary" type="submit">Save</button>
          </form>
        </section>
      )}

      {isTeamEvent && ticketed && session && open && !hasTicket && (
        <p class="flash">Teams are formed by ticket holders: get your ticket above first.</p>
      )}

      </aside>
      <div class="event-body">
        {(event.description || hasBracket || event.link_url) && (
          <section class="event-card">
            <h2 class="section-label">Description</h2>
            {paragraphs.map((para) => <p>{para}</p>)}
            {(hasBracket || event.link_url) && (
              <p class="entry-actions">
                {hasBracket && <a class="btn btn-primary" href={`/events/${event.id}/bracket`}>View the bracket</a>}
                {event.link_url && <a class="btn btn-ghost" href={event.link_url} rel="noopener">Stream / info link</a>}
              </p>
            )}
          </section>
        )}
      {!isTeamEvent && signups.length > 0 && (
        <section class="prose">
          <h2>Who's coming</h2>
          {going.length > 0 && (
            <div class="member-line"><strong>Going:</strong> {session?.isAdmin
              ? going.map((s) => (
                  <span class="member-chip">
                    {s.username}
                    {s.is_member === 1 && <span class="member-mark" title="In the member register">member</span>}
                    <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <button class="chip-remove" type="submit" title="Remove signup">×</button>
                    </form>
                  </span>
                ))
              : going.map((s) => s.username).join(', ')}</div>
          )}
          {maybe.length > 0 && (
            <div class="member-line"><strong>Maybe:</strong> {session?.isAdmin
              ? maybe.map((s) => (
                  <span class="member-chip">
                    {s.username}
                    {s.is_member === 1 && <span class="member-mark" title="In the member register">member</span>}
                    <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <button class="chip-remove" type="submit" title="Remove signup">×</button>
                    </form>
                  </span>
                ))
              : maybe.map((s) => s.username).join(', ')}</div>
          )}
        </section>
      )}

      {isTeamEvent && (
        <section class="prose">
          <h2>Teams</h2>
          {eventTeams.length === 0 && (
            <p class="app-empty">No teams yet. Start the first one!</p>
          )}
          {eventTeams.map((team) => {
            const members = teamMembers(team.id);
            const slotsLeft = event.team_size! - members.length;
            const inThisTeam = mine?.event_team_id === team.id;
            return (
              <div class="team-card">
                <h3>
                  {team.name}
                  <span class="event-meta"> {members.length} / {event.team_size}</span>
                </h3>
                <div class="member-line">
                  {members.length === 0 && 'Empty'}
                  {session?.isAdmin
                    ? members.map((m) => (
                        <span class="member-chip">
                          {m.username}
                          {m.is_member === 1 && <span class="member-mark" title="In the member register">member</span>}
                          <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                            <input type="hidden" name="csrf" value={csrf} />
                            <input type="hidden" name="discord_id" value={m.discord_id} />
                            <button class="chip-remove" type="submit" title="Remove signup">×</button>
                          </form>
                        </span>
                      ))
                    : members.map((m) => m.username).join(', ')}
                </div>
                {session && open && !inThisTeam && slotsLeft > 0 && (!ticketed || hasTicket) && (
                  <form method="post" action={`/events/${event.id}/team`} class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="join" />
                    <input type="hidden" name="event_team_id" value={team.id} />
                    <button class="btn btn-ghost" type="submit">Join this team</button>
                  </form>
                )}
                {inThisTeam && open && (
                  <form method="post" action={`/events/${event.id}/team`} class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="leave" />
                    <button class="btn-link" type="submit">Leave team</button>
                  </form>
                )}
              </div>
            );
          })}

          {freeAgents.length > 0 && (
            <div class="member-line"><strong>Looking for a team:</strong> {session?.isAdmin
              ? freeAgents.map((s) => (
                  <span class="member-chip">
                    {s.username}
                    {s.is_member === 1 && <span class="member-mark" title="In the member register">member</span>}
                    <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <button class="chip-remove" type="submit" title="Remove signup">×</button>
                    </form>
                  </span>
                ))
              : freeAgents.map((s) => s.username).join(', ')}</div>
          )}

          {session && open && (!ticketed || hasTicket) && (
            <div class="team-actions">
              {!isFull && (
                <form method="post" action={`/events/${event.id}/team`} class="app-form app-form-row">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="action" value="create" />
                  <label>New team name <input name="name" required maxlength="40" /></label>
                  <button class="btn btn-primary" type="submit">Create a team</button>
                </form>
              )}
              <form method="post" action={`/events/${event.id}/signup`} class="signup-bar" hidden={ticketed}>
                <input type="hidden" name="csrf" value={csrf} />
                {mine?.event_team_id == null && mine?.status === 'yes' ? (
                  <button class="btn btn-primary" type="button" disabled>
                    You're listed as looking for a team
                  </button>
                ) : (
                  <button class="btn btn-ghost" name="status" value="yes" type="submit">
                    Sign up without a team
                  </button>
                )}
                {mine && (
                  <button class="btn btn-ghost" name="status" value="remove" type="submit">
                    Remove my signup
                  </button>
                )}
              </form>
            </div>
          )}
        </section>
      )}

      </div>
      <div class="event-admin">
      {session?.isAdmin && (
        <details class="admin-panel" open={ADMIN_OPEN.has(Astro.url.searchParams.get('ok') ?? '') || ADMIN_OPEN.has(Astro.url.searchParams.get('err') ?? '')}>
          <summary>Board tools · sales, roster, questions, settings</summary>
          <h2>Admin</h2>
          <form method="post" action={`/events/${event.id}/cover`} enctype="multipart/form-data" class="signup-bar cover-form">
            <input type="hidden" name="csrf" value={csrf} />
            <label class="cover-pick">Cover image <input type="file" name="cover" accept="image/jpeg,image/png,image/webp" /></label>
            <button class="btn btn-ghost" type="submit">{coverAt !== null ? 'Replace cover' : 'Upload cover'}</button>
            {coverAt !== null && <button class="btn btn-ghost" name="action" value="remove" type="submit" formnovalidate data-confirm="Remove the cover image?">Remove</button>}
            <span class="queue-meta">JPEG, PNG or WebP, up to 1.5 MB; about 1200 × 630 looks best.</span>
          </form>
          {event.cancelled_at !== null && (
            <form method="post" action={`/events/${event.id}/cancel`} class="signup-bar">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value="uncancel" />
              <button class="btn btn-primary" type="submit">Reinstate this event</button>
            </form>
          )}
          {event.cancelled_at === null && (
          <div class="signup-bar">
            <form method="post" action={`/events/${event.id}/close`}>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value={signupsClosed ? 'reopen' : 'close'} />
              <button class="btn btn-ghost" type="submit">
                {signupsClosed ? 'Reopen signups' : 'Close signups'}
              </button>
            </form>
            <form method="post" action={`/events/${event.id}/bracket-action`}>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value="generate" />
              <button class="btn btn-ghost" type="submit" data-confirm={hasBracket ? 'Regenerate the bracket from scratch? Recorded results are lost.' : undefined}>
                {hasBracket ? 'Regenerate bracket' : 'Generate bracket'}
              </button>
            </form>
            <form method="post" action={`/events/${event.id}/cancel`}>
              <input type="hidden" name="csrf" value={csrf} />
              <button class="btn btn-ghost" type="submit" data-confirm="Cancel this event? It stays listed as cancelled and can be reinstated.">Cancel this event</button>
            </form>
          </div>
          )}
          {event.cancelled_at === null && (
          <details class="admin-edit">
            <summary>Edit this event</summary>
            <form method="post" action={`/events/${event.id}/edit`} class="app-form">
              <input type="hidden" name="csrf" value={csrf} />
              <label>Title <input name="title" required maxlength="120" value={event.title} /></label>
              <label>Date <input name="date" type="date" required value={unixToHelsinkiInputs(event.starts_at).date} /></label>
              <label>Starts (Helsinki) <input name="time" type="time" required value={unixToHelsinkiInputs(event.starts_at).time} /></label>
              <label>Ends <input name="end_time" type="time" required value={event.ends_at !== null ? unixToHelsinkiInputs(event.ends_at).time : ''} /></label>
              <label>
                Capacity
                <input name="capacity" type="number" min="1" value={event.capacity ?? ''} placeholder="unlimited" />
              </label>
              <label>
                Organizers
                <input name="organizers" maxlength="120" value={event.organizers ?? ''} placeholder="LahtiAG, Kapital" />
              </label>
              <label>
                Location
                <input name="location" maxlength="120" value={event.location ?? ''} placeholder="Mukkulankatu 19, Lahti" />
              </label>
              <label>
                Link
                <input name="link_url" type="url" maxlength="300" value={event.link_url ?? ''} placeholder="https:// stream, rules, venue…" />
              </label>
              <label class="check check-standalone">
                <input type="checkbox" name="members_only" checked={event.members_only === 1} /> <span>Members only</span>
              </label>
              <label>
                Seats reserved for members
                <input name="member_slots" type="number" min="1" value={event.member_slots ?? ''} placeholder="empty = none; only with a capacity" />
              </label>
              <label>Description <textarea name="description" rows="3">{event.description ?? ''}</textarea></label>
              {event.team_size !== null && (
                <p class="event-meta">Team size ({event.team_size}) can't change once teams exist.</p>
              )}
              <button class="btn btn-primary" type="submit">Save changes</button>
            </form>
          </details>
          )}
          <details class="admin-edit" id="tickets" open={types.length > 0}>
            <summary>Tickets</summary>
            <p class="event-meta">
              Add a ticket type and the event sells tickets instead of taking plain signups (team
              events keep signups). A price of 0 is a free ticket. Member price applies to linked
              members. Quantity limits the type; the event's capacity limits everything.
            </p>
            {sales && (
              <p class="event-meta">
                <strong>{sales.tickets}</strong> tickets sold, <strong>{sales.checked_in}</strong> checked in,
                {' '}<strong>{euro(sales.revenue_cents)}</strong> taken.
                {' '}<a class="btn btn-ghost btn-sm" href={`/events/${event.id}/door`}>Door page</a>
                {' '}<a class="btn btn-ghost btn-sm" href={`/events/${event.id}/tickets.csv`}>Export CSV</a>
              </p>
            )}
            {types.map((t) => (
              <form method="post" action={`/events/${event.id}/ticket-types`} class="type-row">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="ticket_type_id" value={t.id} />
                <label>Name <input name="name" required maxlength="60" value={t.name} /></label>
                <label>Price € <input name="price" type="text" inputmode="decimal" value={(t.price_cents / 100).toFixed(2)} /></label>
                <label>Member € <input name="member_price" type="text" inputmode="decimal" value={t.member_price_cents === null ? '' : (t.member_price_cents / 100).toFixed(2)} placeholder="same" /></label>
                <label>Qty <input name="quantity" type="number" min="1" value={t.quantity ?? ''} placeholder="∞" /></label>
                <label>Sales close <input name="close_date" type="date" value={closeInputs(t).date} /></label>
                <label>at <input name="close_time" type="time" value={closeInputs(t).time} /></label>
                <label class="check"><input type="checkbox" name="members_only" checked={t.members_only === 1} /> members only</label>
                <label class="check"><input type="checkbox" name="active" checked={t.active === 1} /> on sale</label>
                <span class="event-meta">{t.sold} sold · {euro(t.revenue_cents)}</span>
                <button class="btn btn-ghost btn-sm" type="submit">Save</button>
                <button class="btn btn-ghost btn-sm" type="submit" name="action" value="delete" data-confirm="Remove this ticket type? If tickets were sold on it, it is retired instead.">Remove</button>
              </form>
            ))}
            <form method="post" action={`/events/${event.id}/ticket-types`} class="type-row type-new">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value="create" />
              <label>Name <input name="name" required maxlength="60" placeholder="Standard" /></label>
              <label>Price € <input name="price" type="text" inputmode="decimal" placeholder="10.00" required /></label>
              <label>Member € <input name="member_price" type="text" inputmode="decimal" placeholder="same" /></label>
              <label>Qty <input name="quantity" type="number" min="1" placeholder="∞" /></label>
              <label>Sales close <input name="close_date" type="date" /></label>
              <label>at <input name="close_time" type="time" /></label>
              <label class="check"><input type="checkbox" name="members_only" /> members only</label>
              <button class="btn btn-primary btn-sm" type="submit">Add ticket type</button>
            </form>
          </details>
          <details class="admin-edit" id="questions" open={questions.length > 0}>
            <summary>Questions</summary>
            <p class="event-meta">
              Asked when someone signs up or buys a ticket. Answers show on the roster below, on the
              door page, and in the exports. Up to eight; a choice question lists its options one per line.
            </p>
            {questions.map((q) => (
              <form method="post" action={`/events/${event.id}/questions`} class="type-row">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="question_id" value={q.id} />
                <label>Question <input name="label" required maxlength="80" value={q.label} /></label>
                <label>
                  Type
                  <select name="kind">
                    {QUESTION_KINDS.map((k) => <option value={k} selected={q.kind === k}>{k}</option>)}
                  </select>
                </label>
                <label>Options (one per line) <textarea name="options" rows="2">{q.options ?? ''}</textarea></label>
                <label class="check"><input type="checkbox" name="required" checked={q.required === 1} /> required</label>
                <button class="btn btn-ghost btn-sm" type="submit">Save</button>
                <button class="btn btn-ghost btn-sm" type="submit" name="action" value="delete" data-confirm="Remove this question and everyone's answers to it?">Remove</button>
              </form>
            ))}
            <form method="post" action={`/events/${event.id}/questions`} class="type-row type-new">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value="create" />
              <label>Question <input name="label" required maxlength="80" placeholder="In-game name" /></label>
              <label>
                Type
                <select name="kind">
                  {QUESTION_KINDS.map((k) => <option value={k}>{k}</option>)}
                </select>
              </label>
              <label>Options (one per line) <textarea name="options" rows="2" placeholder="Only for choice"></textarea></label>
              <label class="check"><input type="checkbox" name="required" /> required</label>
              <button class="btn btn-primary btn-sm" type="submit">Add question</button>
            </form>
            {questions.length > 0 && <p><a class="btn btn-ghost btn-sm" href={`/events/${event.id}/roster.csv`}>Export roster with answers</a></p>}
          </details>
          <details class="admin-edit">
            <summary>Manage participants</summary>
            <p class="event-meta">
              Changes here skip the signup rules: closed signups and capacity
              don't apply. Picking a team sets the answer to Going. Adding by
              name is for walk-ins without Discord; their signup can be
              edited and removed like any other.
            </p>
            {signups.length > 0 && (
              <ul class="participant-admin">
                {signups.map((s) => (
                  <li>
                    <form method="post" action={`/events/${event.id}/edit-signup`} class="participant-row">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <span class="participant-name">{s.username}{questions.length > 0 && answerLine(s.discord_id) && <small class="participant-answers">{answerLine(s.discord_id)}</small>}</span>
                      <select name="status">
                        <option value="yes" selected={s.status === 'yes'}>Going</option>
                        <option value="maybe" selected={s.status === 'maybe'}>Maybe</option>
                      </select>
                      {isTeamEvent && (
                        <select name="event_team_id">
                          <option value="" selected={s.event_team_id === null}>No team</option>
                          {eventTeams.map((team) => (
                            <option value={team.id} selected={s.event_team_id === team.id}>{team.name}</option>
                          ))}
                        </select>
                      )}
                      <button class="btn btn-ghost" type="submit">Save</button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
            <form method="post" action={`/events/${event.id}/add-participant`} class="participant-row">
              <input type="hidden" name="csrf" value={csrf} />
              <label>Name <input name="name" required maxlength="60" placeholder="Walk-in participant" /></label>
              <select name="status">
                <option value="yes">Going</option>
                <option value="maybe">Maybe</option>
              </select>
              {isTeamEvent && eventTeams.length > 0 && (
                <select name="event_team_id">
                  <option value="">No team</option>
                  {eventTeams.map((team) => (
                    <option value={team.id}>{team.name}</option>
                  ))}
                </select>
              )}
              <button class="btn btn-primary" type="submit">Add participant</button>
            </form>
          </details>
          <details class="admin-edit">
            <summary>Danger zone</summary>
            <p class="event-meta">
              Deleting erases the event with its signups, teams and bracket,
              and removes the Discord announcement. Cancelling (above) is the
              right call for a real event that fell through.
            </p>
            <form method="post" action={`/events/${event.id}/delete`}>
              <input type="hidden" name="csrf" value={csrf} />
              <button class="btn btn-danger" type="submit" data-confirm="Delete this event for good, with its signups, teams, bracket and tickets? This cannot be undone.">Delete this event permanently</button>
            </form>
          </details>
        </details>
      )}
      </div>
      </div>
    </>
  )}
</Base>

<script>
  // Share: the system share sheet where there is one, the clipboard
  // elsewhere. Hidden until this runs, so without JS there is no dead button.
  const share = document.getElementById('share-event') as HTMLButtonElement | null;
  if (share && (navigator.share || navigator.clipboard)) {
    share.hidden = false;
    share.addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}`;
      const title = share.dataset.title ?? document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {
          /* dismissed */
        }
        return;
      }
      await navigator.clipboard.writeText(url);
      share.textContent = 'Link copied';
    });
  }
</script>
