---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import SessionBox from '../../../components/SessionBox.astro';
import { currentSession, ensureCsrf } from '../../../lib/guard';
import {
  getEvent,
  listSignups,
  listEventTeams,
  getBracket,
  listTicketTypes,
  ticketOffer,
  signupAccess,
  getTicketForHolder,
  salesSummary,
  type TicketTypeWithSales,
} from '../../../lib/db';
import { stripeConfigured } from '../../../lib/stripe';
import { formatHelsinkiRange, unixToHelsinkiInputs, formatHelsinki } from '../../../lib/time';

const nowSeconds = Math.floor(Date.now() / 1000);

const id = Number(Astro.params.id);
const event = Number.isInteger(id) ? await getEvent(env.DB, id) : null;

if (!event) {
  Astro.response.status = 404;
}

const session = await currentSession(Astro.request, env);
const csrf = ensureCsrf(Astro.cookies);

const signups = event ? await listSignups(env.DB, event.id) : [];
const eventTeams = event?.team_size != null ? await listEventTeams(env.DB, event.id) : [];
const hasBracket = event ? (await getBracket(env.DB, event.id)).length > 0 : false;

// Tickets: an event with active ticket types sells tickets instead of
// taking plain signups; a paid ticket is the signup. Membership gating
// (members-only, reserved seats) applies to both paths.
const types: TicketTypeWithSales[] = event ? await listTicketTypes(env.DB, event.id) : [];
const activeTypes = types.filter((t) => t.active === 1);
const ticketed = activeTypes.length > 0 && event?.team_size == null;
const offers = new Map<number, Awaited<ReturnType<typeof ticketOffer>>>();
if (event && ticketed) {
  for (const t of activeTypes) offers.set(t.id, await ticketOffer(env.DB, event, t, session?.discordId ?? null, nowSeconds));
}
const myTicket = event && session ? await getTicketForHolder(env.DB, event.id, session.discordId) : null;
const access = event && session ? await signupAccess(env.DB, event, session.discordId, true) : null;
const sales = event && session?.isAdmin && types.length > 0 ? await salesSummary(env.DB, event.id) : null;
const paymentsOn = stripeConfigured(env);
const euro = (cents: number) => `${(cents / 100).toFixed(2)} €`;
const closeInputs = (t: TicketTypeWithSales) => (t.sales_close_at === null ? { date: '', time: '' } : unixToHelsinkiInputs(t.sales_close_at));

const going = signups.filter((signup) => signup.status === 'yes');
const maybe = signups.filter((signup) => signup.status === 'maybe');
const mine = session ? signups.find((signup) => signup.discord_id === session.discordId) : undefined;

// Solo events: capacity counts people. Team events: capacity counts teams.
const isTeamEvent = event?.team_size != null;
const teamMembers = (teamId: number) => signups.filter((s) => s.event_team_id === teamId);
const freeAgents = going.filter((s) => s.event_team_id === null);
const isFull = !isTeamEvent
  ? event?.capacity != null &&
    going.filter((s) => s.discord_id !== session?.discordId).length >= event.capacity
  : event?.capacity != null && eventTeams.length >= event.capacity;
const signupsClosed = event?.signups_closed_at != null;
const open = event ? event.cancelled_at === null && !signupsClosed : false;

const FLASH: Record<string, string> = {
  full: 'This event is full.',
  team_full: 'That team is already full.',
  dup_name: 'A team with that name already exists.',
  not_team_event: 'This event does not take team signups.',
  cancelled: 'This event has been cancelled and signups are closed.',
  closed: 'Signups are closed for this event.',
  bad_time: "That date and time didn't parse.",
  signin: 'Sign in with Discord first.',
  csrf: 'The form was stale. Try again.',
  bad_input: "That didn't work. A team name is 1 to 40 characters.",
  missing: 'No such team on this event.',
  forbidden: 'That needs the admin role in Discord.',
  discord_down: "Discord didn't answer while re-checking your role. Try again.",
  members_only: 'This event is for members. Link your membership on the join page, or apply.',
  reserved: 'The remaining seats are reserved for members.',
  sold_out: 'That ticket type is sold out.',
  sales_closed: 'Sales for that ticket have closed.',
  has_ticket: 'You already have a ticket for this event.',
  payments_off: 'Card payments are not set up yet. Free tickets work; paid ones at the door.',
  stripe_down: "The payment page didn't open. Try again in a moment.",
  cancelled_checkout: 'Payment cancelled. Nothing was charged; the seat is released shortly.',
};
const OK: Record<string, string> = {
  type_saved: 'Ticket type saved.',
  type_deleted: 'Ticket type removed (or retired, if tickets were sold on it).',
};
const flash = FLASH[Astro.url.searchParams.get('err') ?? ''] ?? OK[Astro.url.searchParams.get('ok') ?? ''] ?? null;
---
<Base
  title={event ? event.title : 'Event not found'}
  description={event ? `${event.title}, ${formatHelsinkiRange(event.starts_at, event.ends_at)}` : undefined}
>
  {!event ? (
    <article class="prose">
      <h1>No such event</h1>
      <p>Nothing lives at this id. Back to <a href="/events">events</a>.</p>
    </article>
  ) : (
    <>
      <article class="prose">
        <p class="hero-eyebrow">
          {event.starts_at <= nowSeconds && event.ends_at !== null && event.ends_at > nowSeconds && (
            <span class="live-badge">Happening now</span>
          )}
          {formatHelsinkiRange(event.starts_at, event.ends_at)}
        </p>
        <h1>{event.title}</h1>
        {event.cancelled_at !== null && <p class="flash">This event is cancelled.</p>}
        {signupsClosed && event.cancelled_at === null && (
          <p class="flash">Signups are closed.</p>
        )}
        {hasBracket && (
          <p><a class="btn btn-primary" href={`/events/${event.id}/bracket`}>View the bracket</a></p>
        )}
        {(event.members_only === 1 || event.member_slots !== null) && (
          <p class="event-gating">
            {event.members_only === 1 && <span class="status-badge status-member">Members only</span>}
            {event.member_slots !== null && event.members_only !== 1 && (
              <span class="status-badge">{event.member_slots} of {event.capacity} seats reserved for members{access && access.openSeatsLeft !== null && !access.member ? `, ${access.openSeatsLeft} open to everyone` : ''}</span>
            )}
          </p>
        )}
        {event.organizers && <p class="event-meta">Organized by {event.organizers}</p>}
        {event.link_url && (
          <p><a class="btn btn-ghost" href={event.link_url} rel="noopener">Stream / info link</a></p>
        )}
        {event.description && <p>{event.description}</p>}
        <p class="event-meta">
          {isTeamEvent ? (
            <>
              Teams of {event.team_size}: {eventTeams.length}
              {event.capacity !== null ? ` / ${event.capacity}` : ''} teams,
              {' '}{going.length} players in
            </>
          ) : (
            <>
              {going.length}{event.capacity !== null ? ` / ${event.capacity}` : ''} going
              {maybe.length > 0 ? `, ${maybe.length} maybe` : ''}
            </>
          )}
        </p>
      </article>

      <SessionBox session={session} csrf={csrf} />
      {flash && <p class="flash">{flash}</p>}

      {ticketed && (
        <section class="tickets-box" id="buy">
          <h2 class="section-label">Tickets</h2>
          {myTicket ? (
            <div class="queue-card">
              <div class="queue-body">
                <p class="queue-name">{myTicket.status === 'paid' ? 'You have a ticket' : 'Your payment is not finished'}</p>
                <p class="queue-meta">{myTicket.type_name} · {myTicket.holder_name}{myTicket.checked_in_at ? ' · checked in' : ''}</p>
              </div>
              <a class="btn btn-primary" href={`/tickets/${myTicket.code}`}>{myTicket.status === 'paid' ? 'Show ticket' : 'Open ticket'}</a>
            </div>
          ) : (
            <ul class="ticket-types">
              {activeTypes.map((t) => {
                const offer = offers.get(t.id)!;
                const left = t.quantity === null ? null : Math.max(0, t.quantity - t.sold);
                return (
                  <li class="ticket-type">
                    <div>
                      <p class="ticket-type-name">{t.name}</p>
                      <p class="queue-meta">
                        {t.member_price_cents !== null && t.member_price_cents !== t.price_cents
                          ? `${euro(t.price_cents)}, members ${euro(t.member_price_cents)}`
                          : t.price_cents === 0 ? 'Free' : euro(t.price_cents)}
                        {t.members_only === 1 ? ' · members only' : ''}
                        {left !== null ? ` · ${left} left` : ''}
                        {t.sales_close_at !== null ? ` · sales close ${formatHelsinki(t.sales_close_at)}` : ''}
                      </p>
                    </div>
                    {!session ? (
                      <a class="btn btn-primary" href={`/login?next=/events/${event.id}`}>Sign in to buy</a>
                    ) : offer.ok ? (
                      <form method="post" action={`/events/${event.id}/buy`}>
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="ticket_type_id" value={t.id} />
                        <button class="btn btn-cta" type="submit" disabled={offer.amount_cents > 0 && !paymentsOn}>
                          {offer.amount_cents === 0 ? 'Get ticket' : `Buy · ${euro(offer.amount_cents)}`}
                        </button>
                      </form>
                    ) : (
                      <span class="ticket-why">{FLASH[offer.reason] ?? offer.reason}</span>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
          {!myTicket && session && !paymentsOn && activeTypes.some((t) => t.price_cents > 0) && (
            <p class="queue-meta">Card payments aren't set up yet; paid tickets are sold at the door.</p>
          )}
          <p class="queue-meta">Tickets are personal and shown as a QR code. <a href="/terms">Terms of sale.</a></p>
        </section>
      )}

      {!ticketed && !isTeamEvent && session && open && access && !access.allowed && (
        <p class="flash">{FLASH[access.reason!]}{access.reason === 'members_only' && <> <a href="/join">Link or apply</a>.</>}</p>
      )}

      {!ticketed && !isTeamEvent && session && open && (!access || access.allowed) && (
        <form method="post" action={`/events/${event.id}/signup`} class="signup-bar">
          <input type="hidden" name="csrf" value={csrf} />
          <button
            class={`btn ${mine?.status === 'yes' ? 'btn-primary' : 'btn-ghost'}`}
            name="status"
            value="yes"
            disabled={isFull && mine?.status !== 'yes'}
            type="submit"
          >
            {isFull && mine?.status !== 'yes' ? 'Full' : "I'm going"}
          </button>
          <button
            class={`btn ${mine?.status === 'maybe' ? 'btn-primary' : 'btn-ghost'}`}
            name="status"
            value="maybe"
            type="submit"
          >Maybe</button>
          {mine && (
            <button class="btn btn-ghost" name="status" value="remove" type="submit">
              Remove my signup
            </button>
          )}
        </form>
      )}

      {!isTeamEvent && signups.length > 0 && (
        <section class="prose">
          <h2>Who's coming</h2>
          {going.length > 0 && (
            <div class="member-line"><strong>Going:</strong> {session?.isAdmin
              ? going.map((s) => (
                  <span class="member-chip">
                    {s.username}
                    {s.is_member === 1 && <span class="member-mark" title="In the member register">member</span>}
                    <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <button class="chip-remove" type="submit" title="Remove signup">×</button>
                    </form>
                  </span>
                ))
              : going.map((s) => s.username).join(', ')}</div>
          )}
          {maybe.length > 0 && (
            <div class="member-line"><strong>Maybe:</strong> {session?.isAdmin
              ? maybe.map((s) => (
                  <span class="member-chip">
                    {s.username}
                    {s.is_member === 1 && <span class="member-mark" title="In the member register">member</span>}
                    <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <button class="chip-remove" type="submit" title="Remove signup">×</button>
                    </form>
                  </span>
                ))
              : maybe.map((s) => s.username).join(', ')}</div>
          )}
        </section>
      )}

      {isTeamEvent && (
        <section class="prose">
          <h2>Teams</h2>
          {eventTeams.length === 0 && (
            <p class="app-empty">No teams yet. Start the first one!</p>
          )}
          {eventTeams.map((team) => {
            const members = teamMembers(team.id);
            const slotsLeft = event.team_size! - members.length;
            const inThisTeam = mine?.event_team_id === team.id;
            return (
              <div class="team-card">
                <h3>
                  {team.name}
                  <span class="event-meta"> {members.length} / {event.team_size}</span>
                </h3>
                <div class="member-line">
                  {members.length === 0 && 'Empty'}
                  {session?.isAdmin
                    ? members.map((m) => (
                        <span class="member-chip">
                          {m.username}
                          {m.is_member === 1 && <span class="member-mark" title="In the member register">member</span>}
                          <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                            <input type="hidden" name="csrf" value={csrf} />
                            <input type="hidden" name="discord_id" value={m.discord_id} />
                            <button class="chip-remove" type="submit" title="Remove signup">×</button>
                          </form>
                        </span>
                      ))
                    : members.map((m) => m.username).join(', ')}
                </div>
                {session && open && !inThisTeam && slotsLeft > 0 && (
                  <form method="post" action={`/events/${event.id}/team`} class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="join" />
                    <input type="hidden" name="event_team_id" value={team.id} />
                    <button class="btn btn-ghost" type="submit">Join this team</button>
                  </form>
                )}
                {inThisTeam && open && (
                  <form method="post" action={`/events/${event.id}/team`} class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="leave" />
                    <button class="btn-link" type="submit">Leave team</button>
                  </form>
                )}
              </div>
            );
          })}

          {freeAgents.length > 0 && (
            <div class="member-line"><strong>Looking for a team:</strong> {session?.isAdmin
              ? freeAgents.map((s) => (
                  <span class="member-chip">
                    {s.username}
                    {s.is_member === 1 && <span class="member-mark" title="In the member register">member</span>}
                    <form method="post" action={`/events/${event.id}/remove-signup`} class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <button class="chip-remove" type="submit" title="Remove signup">×</button>
                    </form>
                  </span>
                ))
              : freeAgents.map((s) => s.username).join(', ')}</div>
          )}

          {session && open && (
            <div class="team-actions">
              {!isFull && (
                <form method="post" action={`/events/${event.id}/team`} class="app-form app-form-row">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="action" value="create" />
                  <label>New team name <input name="name" required maxlength="40" /></label>
                  <button class="btn btn-primary" type="submit">Create a team</button>
                </form>
              )}
              <form method="post" action={`/events/${event.id}/signup`} class="signup-bar">
                <input type="hidden" name="csrf" value={csrf} />
                {mine?.event_team_id == null && mine?.status === 'yes' ? (
                  <button class="btn btn-primary" type="button" disabled>
                    You're listed as looking for a team
                  </button>
                ) : (
                  <button class="btn btn-ghost" name="status" value="yes" type="submit">
                    Sign up without a team
                  </button>
                )}
                {mine && (
                  <button class="btn btn-ghost" name="status" value="remove" type="submit">
                    Remove my signup
                  </button>
                )}
              </form>
            </div>
          )}
        </section>
      )}

      {session?.isAdmin && (
        <section class="admin-panel">
          <h2>Admin</h2>
          {event.cancelled_at === null && (
          <div class="signup-bar">
            <form method="post" action={`/events/${event.id}/close`}>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value={signupsClosed ? 'reopen' : 'close'} />
              <button class="btn btn-ghost" type="submit">
                {signupsClosed ? 'Reopen signups' : 'Close signups'}
              </button>
            </form>
            <form method="post" action={`/events/${event.id}/bracket-action`}>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value="generate" />
              <button class="btn btn-ghost" type="submit">
                {hasBracket ? 'Regenerate bracket' : 'Generate bracket'}
              </button>
            </form>
            <form method="post" action={`/events/${event.id}/cancel`}>
              <input type="hidden" name="csrf" value={csrf} />
              <button class="btn btn-ghost" type="submit">Cancel this event</button>
            </form>
          </div>
          )}
          {event.cancelled_at === null && (
          <details class="admin-edit">
            <summary>Edit this event</summary>
            <form method="post" action={`/events/${event.id}/edit`} class="app-form">
              <input type="hidden" name="csrf" value={csrf} />
              <label>Title <input name="title" required maxlength="120" value={event.title} /></label>
              <label>Date <input name="date" type="date" required value={unixToHelsinkiInputs(event.starts_at).date} /></label>
              <label>Starts (Helsinki) <input name="time" type="time" required value={unixToHelsinkiInputs(event.starts_at).time} /></label>
              <label>Ends <input name="end_time" type="time" required value={event.ends_at !== null ? unixToHelsinkiInputs(event.ends_at).time : ''} /></label>
              <label>
                Capacity
                <input name="capacity" type="number" min="1" value={event.capacity ?? ''} placeholder="unlimited" />
              </label>
              <label>
                Organizers
                <input name="organizers" maxlength="120" value={event.organizers ?? ''} placeholder="LahtiAG, Kapital" />
              </label>
              <label>
                Link
                <input name="link_url" type="url" maxlength="300" value={event.link_url ?? ''} placeholder="https:// stream, rules, venue…" />
              </label>
              <label class="check check-standalone">
                <input type="checkbox" name="members_only" checked={event.members_only === 1} /> <span>Members only</span>
              </label>
              <label>
                Seats reserved for members
                <input name="member_slots" type="number" min="1" value={event.member_slots ?? ''} placeholder="empty = none; needs a capacity" />
              </label>
              <label>Description <textarea name="description" rows="3">{event.description ?? ''}</textarea></label>
              {event.team_size !== null && (
                <p class="event-meta">Team size ({event.team_size}) can't change once teams exist.</p>
              )}
              <button class="btn btn-primary" type="submit">Save changes</button>
            </form>
          </details>
          )}
          <details class="admin-edit" id="tickets" open={types.length > 0}>
            <summary>Tickets</summary>
            <p class="event-meta">
              Add a ticket type and the event sells tickets instead of taking plain signups (team
              events keep signups). A price of 0 is a free ticket. Member price applies to linked
              members. Quantity limits the type; the event's capacity limits everything.
            </p>
            {sales && (
              <p class="event-meta">
                <strong>{sales.tickets}</strong> tickets sold, <strong>{sales.checked_in}</strong> checked in,
                {' '}<strong>{euro(sales.revenue_cents)}</strong> taken.
                {' '}<a class="btn btn-ghost btn-sm" href={`/events/${event.id}/door`}>Door page</a>
                {' '}<a class="btn btn-ghost btn-sm" href={`/events/${event.id}/tickets.csv`}>Export CSV</a>
              </p>
            )}
            {types.map((t) => (
              <form method="post" action={`/events/${event.id}/ticket-types`} class="type-row">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="ticket_type_id" value={t.id} />
                <label>Name <input name="name" required maxlength="60" value={t.name} /></label>
                <label>Price € <input name="price" type="text" inputmode="decimal" value={(t.price_cents / 100).toFixed(2)} /></label>
                <label>Member € <input name="member_price" type="text" inputmode="decimal" value={t.member_price_cents === null ? '' : (t.member_price_cents / 100).toFixed(2)} placeholder="same" /></label>
                <label>Qty <input name="quantity" type="number" min="1" value={t.quantity ?? ''} placeholder="∞" /></label>
                <label>Sales close <input name="close_date" type="date" value={closeInputs(t).date} /></label>
                <label>at <input name="close_time" type="time" value={closeInputs(t).time} /></label>
                <label class="check"><input type="checkbox" name="members_only" checked={t.members_only === 1} /> members only</label>
                <label class="check"><input type="checkbox" name="active" checked={t.active === 1} /> on sale</label>
                <span class="event-meta">{t.sold} sold · {euro(t.revenue_cents)}</span>
                <button class="btn btn-ghost btn-sm" type="submit">Save</button>
                <button class="btn btn-ghost btn-sm" type="submit" name="action" value="delete">Remove</button>
              </form>
            ))}
            <form method="post" action={`/events/${event.id}/ticket-types`} class="type-row type-new">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value="create" />
              <label>Name <input name="name" required maxlength="60" placeholder="Standard" /></label>
              <label>Price € <input name="price" type="text" inputmode="decimal" placeholder="10.00" required /></label>
              <label>Member € <input name="member_price" type="text" inputmode="decimal" placeholder="same" /></label>
              <label>Qty <input name="quantity" type="number" min="1" placeholder="∞" /></label>
              <label>Sales close <input name="close_date" type="date" /></label>
              <label>at <input name="close_time" type="time" /></label>
              <label class="check"><input type="checkbox" name="members_only" /> members only</label>
              <button class="btn btn-primary btn-sm" type="submit">Add ticket type</button>
            </form>
          </details>
          <details class="admin-edit">
            <summary>Manage participants</summary>
            <p class="event-meta">
              Changes here skip the signup rules: closed signups and capacity
              don't apply. Picking a team sets the answer to Going. Adding by
              name is for walk-ins without Discord; their signup can be
              edited and removed like any other.
            </p>
            {signups.length > 0 && (
              <ul class="participant-admin">
                {signups.map((s) => (
                  <li>
                    <form method="post" action={`/events/${event.id}/edit-signup`} class="participant-row">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="discord_id" value={s.discord_id} />
                      <span class="participant-name">{s.username}</span>
                      <select name="status">
                        <option value="yes" selected={s.status === 'yes'}>Going</option>
                        <option value="maybe" selected={s.status === 'maybe'}>Maybe</option>
                      </select>
                      {isTeamEvent && (
                        <select name="event_team_id">
                          <option value="" selected={s.event_team_id === null}>No team</option>
                          {eventTeams.map((team) => (
                            <option value={team.id} selected={s.event_team_id === team.id}>{team.name}</option>
                          ))}
                        </select>
                      )}
                      <button class="btn btn-ghost" type="submit">Save</button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
            <form method="post" action={`/events/${event.id}/add-participant`} class="participant-row">
              <input type="hidden" name="csrf" value={csrf} />
              <label>Name <input name="name" required maxlength="60" placeholder="Walk-in participant" /></label>
              <select name="status">
                <option value="yes">Going</option>
                <option value="maybe">Maybe</option>
              </select>
              {isTeamEvent && eventTeams.length > 0 && (
                <select name="event_team_id">
                  <option value="">No team</option>
                  {eventTeams.map((team) => (
                    <option value={team.id}>{team.name}</option>
                  ))}
                </select>
              )}
              <button class="btn btn-primary" type="submit">Add participant</button>
            </form>
          </details>
          <details class="admin-edit">
            <summary>Danger zone</summary>
            <p class="event-meta">
              Deleting erases the event with its signups, teams and bracket,
              and removes the Discord announcement. Cancelling (above) is the
              right call for a real event that fell through.
            </p>
            <form method="post" action={`/events/${event.id}/delete`}>
              <input type="hidden" name="csrf" value={csrf} />
              <button class="btn btn-ghost" type="submit">Delete this event permanently</button>
            </form>
          </details>
        </section>
      )}
    </>
  )}
</Base>
