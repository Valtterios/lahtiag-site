---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import SessionBox from '../../../components/SessionBox.astro';
import { currentSession, ensureCsrf } from '../../../lib/guard';
import { getEvent, listSignups, listEventTeams, getBracket } from '../../../lib/db';
import { formatHelsinkiRange, unixToHelsinkiInputs } from '../../../lib/time';

const nowSeconds = Math.floor(Date.now() / 1000);

const id = Number(Astro.params.id);
const event = Number.isInteger(id) ? await getEvent(env.DB, id) : null;

if (!event) {
  Astro.response.status = 404;
}

const session = await currentSession(Astro.request, env);
const csrf = ensureCsrf(Astro.cookies);

const signups = event ? await listSignups(env.DB, event.id) : [];
const eventTeams = event?.team_size != null ? await listEventTeams(env.DB, event.id) : [];
const hasBracket = event ? (await getBracket(env.DB, event.id)).length > 0 : false;

const going = signups.filter((signup) => signup.status === 'yes');
const maybe = signups.filter((signup) => signup.status === 'maybe');
const mine = session ? signups.find((signup) => signup.discord_id === session.discordId) : undefined;

// Solo events: capacity counts people. Team events: capacity counts teams.
const isTeamEvent = event?.team_size != null;
const teamMembers = (teamId: number) => signups.filter((s) => s.event_team_id === teamId);
const freeAgents = going.filter((s) => s.event_team_id === null);
const isFull = !isTeamEvent
  ? event?.capacity != null &&
    going.filter((s) => s.discord_id !== session?.discordId).length >= event.capacity
  : event?.capacity != null && eventTeams.length >= event.capacity;
const signupsClosed = event?.signups_closed_at != null;
const open = event ? event.cancelled_at === null && !signupsClosed : false;

const FLASH: Record<string, string> = {
  full: 'This event is full.',
  team_full: 'That team is already full.',
  dup_name: 'A team with that name already exists.',
  not_team_event: 'This event does not take team signups.',
  cancelled: 'This event has been cancelled and signups are closed.',
  closed: 'Signups are closed for this event.',
  bad_time: "That date and time didn't parse.",
  signin: 'Sign in with Discord first.',
  csrf: 'The form was stale. Try again.',
  bad_input: "That didn't work. A team name is 1 to 40 characters.",
  missing: 'No such team on this event.',
  forbidden: 'That needs the admin role in Discord.',
  discord_down: "Discord didn't answer while re-checking your role. Try again.",
};
const flash = FLASH[Astro.url.searchParams.get('err') ?? ''] ?? null;
---
<Base
  title={event ? event.title : 'Event not found'}
  description={event ? `${event.title}, ${formatHelsinkiRange(event.starts_at, event.ends_at)}` : undefined}
>
  {!event ? (
    <article class="prose">
      <h1>No such event</h1>
      <p>Nothing lives at this id. Back to <a href="/events">events</a>.</p>
    </article>
  ) : (
    <>
      <article class="prose">
        <p class="hero-eyebrow">
          {event.starts_at <= nowSeconds && event.ends_at !== null && event.ends_at > nowSeconds && (
            <span class="live-badge">Happening now</span>
          )}
          {formatHelsinkiRange(event.starts_at, event.ends_at)}
        </p>
        <h1>{event.title}</h1>
        {event.cancelled_at !== null && <p class="flash">This event is cancelled.</p>}
        {signupsClosed && event.cancelled_at === null && (
          <p class="flash">Signups are closed.</p>
        )}
        {hasBracket && (
          <p><a class="btn btn-primary" href={`/events/${event.id}/bracket`}>View the bracket</a></p>
        )}
        {event.organizers && <p class="event-meta">Organized by {event.organizers}</p>}
        {event.link_url && (
          <p><a class="btn btn-ghost" href={event.link_url} rel="noopener">Stream / info link</a></p>
        )}
        {event.description && <p>{event.description}</p>}
        <p class="event-meta">
          {isTeamEvent ? (
            <>
              Teams of {event.team_size}: {eventTeams.length}
              {event.capacity !== null ? ` / ${event.capacity}` : ''} teams,
              {' '}{going.length} players in
            </>
          ) : (
            <>
              {going.length}{event.capacity !== null ? ` / ${event.capacity}` : ''} going
              {maybe.length > 0 ? `, ${maybe.length} maybe` : ''}
            </>
          )}
        </p>
      </article>

      <SessionBox session={session} csrf={csrf} />
      {flash && <p class="flash">{flash}</p>}

      {!isTeamEvent && session && open && (
        <form method="post" action={`/events/${event.id}/signup`} class="signup-bar">
          <input type="hidden" name="csrf" value={csrf} />
          <button
            class={`btn ${mine?.status === 'yes' ? 'btn-primary' : 'btn-ghost'}`}
            name="status"
            value="yes"
            disabled={isFull && mine?.status !== 'yes'}
            type="submit"
          >
            {isFull && mine?.status !== 'yes' ? 'Full' : "I'm going"}
          </button>
          <button
            class={`btn ${mine?.status === 'maybe' ? 'btn-primary' : 'btn-ghost'}`}
            name="status"
            value="maybe"
            type="submit"
          >Maybe</button>
          {mine && (
            <button class="btn btn-ghost" name="status" value="remove" type="submit">
              Remove my signup
            </button>
          )}
        </form>
      )}

      {!isTeamEvent && signups.length > 0 && (
        <section class="prose">
          <h2>Who's coming</h2>
          {going.length > 0 && (
            <p><strong>Going:</strong> {going.map((s) => s.username).join(', ')}</p>
          )}
          {maybe.length > 0 && (
            <p><strong>Maybe:</strong> {maybe.map((s) => s.username).join(', ')}</p>
          )}
        </section>
      )}

      {isTeamEvent && (
        <section class="prose">
          <h2>Teams</h2>
          {eventTeams.length === 0 && (
            <p class="app-empty">No teams yet. Start the first one!</p>
          )}
          {eventTeams.map((team) => {
            const members = teamMembers(team.id);
            const slotsLeft = event.team_size! - members.length;
            const inThisTeam = mine?.event_team_id === team.id;
            return (
              <div class="team-card">
                <h3>
                  {team.name}
                  <span class="event-meta"> {members.length} / {event.team_size}</span>
                </h3>
                <p>{members.map((m) => m.username).join(', ') || 'Empty'}</p>
                {session && open && !inThisTeam && slotsLeft > 0 && (
                  <form method="post" action={`/events/${event.id}/team`} class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="join" />
                    <input type="hidden" name="event_team_id" value={team.id} />
                    <button class="btn btn-ghost" type="submit">Join this team</button>
                  </form>
                )}
                {inThisTeam && open && (
                  <form method="post" action={`/events/${event.id}/team`} class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="action" value="leave" />
                    <button class="btn-link" type="submit">Leave team</button>
                  </form>
                )}
              </div>
            );
          })}

          {freeAgents.length > 0 && (
            <p><strong>Looking for a team:</strong> {freeAgents.map((s) => s.username).join(', ')}</p>
          )}

          {session && open && (
            <div class="team-actions">
              {!isFull && (
                <form method="post" action={`/events/${event.id}/team`} class="app-form app-form-row">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="action" value="create" />
                  <label>New team name <input name="name" required maxlength="40" /></label>
                  <button class="btn btn-primary" type="submit">Create a team</button>
                </form>
              )}
              <form method="post" action={`/events/${event.id}/signup`} class="signup-bar">
                <input type="hidden" name="csrf" value={csrf} />
                {mine?.event_team_id == null && mine?.status === 'yes' ? (
                  <button class="btn btn-primary" type="button" disabled>
                    You're listed as looking for a team
                  </button>
                ) : (
                  <button class="btn btn-ghost" name="status" value="yes" type="submit">
                    Sign up without a team
                  </button>
                )}
                {mine && (
                  <button class="btn btn-ghost" name="status" value="remove" type="submit">
                    Remove my signup
                  </button>
                )}
              </form>
            </div>
          )}
        </section>
      )}

      {session?.isAdmin && (
        <section class="admin-panel">
          <h2>Admin</h2>
          {event.cancelled_at === null && (
          <div class="signup-bar">
            <form method="post" action={`/events/${event.id}/close`}>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value={signupsClosed ? 'reopen' : 'close'} />
              <button class="btn btn-ghost" type="submit">
                {signupsClosed ? 'Reopen signups' : 'Close signups'}
              </button>
            </form>
            <form method="post" action={`/events/${event.id}/bracket-action`}>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="action" value="generate" />
              <button class="btn btn-ghost" type="submit">
                {hasBracket ? 'Regenerate bracket' : 'Generate bracket'}
              </button>
            </form>
            <form method="post" action={`/events/${event.id}/cancel`}>
              <input type="hidden" name="csrf" value={csrf} />
              <button class="btn btn-ghost" type="submit">Cancel this event</button>
            </form>
          </div>
          )}
          {event.cancelled_at === null && (
          <details class="admin-edit">
            <summary>Edit this event</summary>
            <form method="post" action={`/events/${event.id}/edit`} class="app-form">
              <input type="hidden" name="csrf" value={csrf} />
              <label>Title <input name="title" required maxlength="120" value={event.title} /></label>
              <label>Date <input name="date" type="date" required value={unixToHelsinkiInputs(event.starts_at).date} /></label>
              <label>Starts (Helsinki) <input name="time" type="time" required value={unixToHelsinkiInputs(event.starts_at).time} /></label>
              <label>Ends <input name="end_time" type="time" required value={event.ends_at !== null ? unixToHelsinkiInputs(event.ends_at).time : ''} /></label>
              <label>
                Capacity
                <input name="capacity" type="number" min="1" value={event.capacity ?? ''} placeholder="unlimited" />
              </label>
              <label>
                Organizers
                <input name="organizers" maxlength="120" value={event.organizers ?? ''} placeholder="LahtiAG, Kapital" />
              </label>
              <label>
                Link
                <input name="link_url" type="url" maxlength="300" value={event.link_url ?? ''} placeholder="https:// stream, rules, venue…" />
              </label>
              <label>Description <textarea name="description" rows="3">{event.description ?? ''}</textarea></label>
              {event.team_size !== null && (
                <p class="event-meta">Team size ({event.team_size}) can't change once teams exist.</p>
              )}
              <button class="btn btn-primary" type="submit">Save changes</button>
            </form>
          </details>
          )}
          <details class="admin-edit">
            <summary>Danger zone</summary>
            <p class="event-meta">
              Deleting erases the event with its signups, teams and bracket,
              and removes the Discord announcement. Cancelling (above) is the
              right call for a real event that fell through.
            </p>
            <form method="post" action={`/events/${event.id}/delete`}>
              <input type="hidden" name="csrf" value={csrf} />
              <button class="btn btn-ghost" type="submit">Delete this event permanently</button>
            </form>
          </details>
        </section>
      )}
    </>
  )}
</Base>
