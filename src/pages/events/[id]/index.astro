---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import SessionBox from '../../../components/SessionBox.astro';
import { currentSession, ensureCsrf, viewAs } from '../../../lib/guard';
import ViewAs from '../../../components/ViewAs.astro';
import {
  getEvent,
  listSignups,
  listEventTeams,
  listBrackets,
  coverInfo,
  listTicketTypes,
  signupAccess,
  getTicketForHolder,
  repairTicketSignups,
  salesSummary,
  listEventQuestions,
  getAnswers,
  listAllAnswers,
  listEventPhotos,
  isInterested,
  signupsOpen,
  listWaitlist,
  waitlistPosition,
  type TicketTypeWithSales,
} from '../../../lib/db';
import { channelUrl, scheduledEventUrl, countGrants, participantIds, listEventChannels, syncInterestInBackground, EVENT_CATEGORY_NAME } from '../../../lib/event-discord';
import { avatarUrl, listGuildRoles } from '../../../lib/discord';
import { DISCORD_GUILD_ID } from '../../../lib/config';
import { questionOptions, answersComplete, QUESTION_KINDS } from '../../../lib/questions';
import { purchaseOffer, pendingPurchaseFor, resumablePurchase } from '../../../lib/purchases';
import { readBasket, basketCount } from '../../../lib/basket';
import { stripeConfigured } from '../../../lib/stripe';
import { formatHelsinkiRange, unixToHelsinkiInputs, formatHelsinki } from '../../../lib/time';
import { kindWorth, listTickKinds, listTickableMembers, listTicks } from '../../../lib/ticks';
import { seasonStartYear } from '../../../lib/activity';

const nowSeconds = Math.floor(Date.now() / 1000);

const id = Number(Astro.params.id);
const event = Number.isInteger(id) ? await getEvent(env.DB, id) : null;
// A draft exists for the board only; everyone else gets "no such event".
const draft = event?.published_at === null;

if (!event) {
  Astro.response.status = 404;
}

const view = viewAs(await currentSession(Astro.request, env), Astro.url);
const session = view.session;
if (draft && !session?.isAdmin) Astro.response.status = 404;
const csrf = ensureCsrf(Astro.cookies);


const eventTeams = event?.team_size != null ? await listEventTeams(env.DB, event.id) : [];
// An event's draws: usually one, sometimes several under their own
// names. The page says "the bracket" while there is one of them.
const brackets = event ? await listBrackets(env.DB, event.id) : [];
const hasBracket = brackets.length > 0;
const liveBrackets = brackets.filter((b) => b.live_at !== null);
const cover = event ? await coverInfo(env.DB, event.id) : null;
const coverAt = cover?.updated_at ?? null;
// Blank lines split the description into paragraphs; single line breaks stay.
const paragraphs = event?.description ? event.description.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];

// Tickets: an event with active ticket types sells tickets instead of
// taking plain signups; a paid ticket is the signup. Membership gating
// (members-only, reserved seats) applies to both paths.
const types: TicketTypeWithSales[] = event ? await listTicketTypes(env.DB, event.id) : [];
const activeTypes = types.filter((t) => t.active === 1);
// Team events sell tickets too: the paid ticket is the entry, and
// forming a team needs one.
const ticketed = activeTypes.length > 0;
// A paid ticket on an account is a signup; put back any that went missing.
if (event && ticketed) await repairTicketSignups(env.DB, event.id, nowSeconds);
const signups = event ? await listSignups(env.DB, event.id) : [];
const offers = new Map<number, Awaited<ReturnType<typeof purchaseOffer>>>();
if (event && ticketed) {
  for (const t of activeTypes) offers.set(t.id, await purchaseOffer(env.DB, event, t, session?.discordId ?? null, nowSeconds));
}
const myTicket = event && session ? await getTicketForHolder(env.DB, event.id, session.discordId) : null;
const access = event && session ? await signupAccess(env.DB, event, session.discordId, true) : null;
const sales = event && session?.isAdmin && types.length > 0 ? await salesSummary(env.DB, event.id) : null;
// The event's own Discord role and channel (board tools): who holds the role.
const botOn = Boolean(env.DISCORD_BOT_TOKEN);
// Who the announcement may ping, asked for only on the Publish card of a
// draft — the one moment the choice is made, and the only page render
// worth a round trip to Discord for the role list.
const pingRoles = draft && session?.isAdmin && env.DISCORD_BOT_TOKEN
  ? ((await listGuildRoles(env.DISCORD_BOT_TOKEN, DISCORD_GUILD_ID)) ?? [])
      .filter((r) => r.name !== '@everyone' && !r.managed)
      .sort((a, b) => a.name.localeCompare(b.name))
  : [];
const discordParticipants = event ? participantIds(signups).length : 0;
const discordGrants = event && session?.isAdmin && event.discord_role_id ? await countGrants(env.DB, event.id) : 0;
const eventChannels = event && session?.isAdmin && (event.discord_category_id || event.discord_channel_id) ? await listEventChannels(env.DB, event.id) : [];
const teamVoiceCount = eventChannels.filter((c) => c.kind === 'team').length;
const teamsWithoutVoice = event?.discord_category_id ? eventTeams.filter((t) => !eventChannels.some((c) => c.kind === 'team' && c.event_team_id === t.id)).length : 0;
const archived = Boolean(event && !event.discord_role_id && (event.discord_category_id || event.discord_channel_id));
const photos = event ? await listEventPhotos(env.DB, event.id) : [];
const hasTicket = myTicket?.status === 'paid';
const pendingPurchase = event && session ? await pendingPurchaseFor(env.DB, session.discordId, nowSeconds) : null;
const resume = resumablePurchase(pendingPurchase, nowSeconds);
const basket = readBasket(Astro.cookies);
const inBasket = (typeId: number) => basket.find((l) => l.kind === 'ticket' && l.id === typeId)?.count ?? 0;
const basketTotal = basketCount(basket);

// Questions the board asks on this event, and what the viewer answered.
const questions = event ? await listEventQuestions(env.DB, event.id) : [];
const myAnswers = event && session ? await getAnswers(env.DB, event.id, { discordId: session.discordId }) : new Map<number, string>();
const answersOk = answersComplete(questions, myAnswers);
const allAnswers = event && session?.isAdmin && questions.length > 0 ? await listAllAnswers(env.DB, event.id) : new Map<string, Map<number, string>>();
// Ticks (src/lib/ticks.ts): what the board notes by hand for the season pass, given here for this event.
const [tickKinds, tickMembers, eventTicks] = event && session?.isAdmin
  ? await Promise.all([listTickKinds(env.DB), listTickableMembers(env.DB), listTicks(env.DB, seasonStartYear(nowSeconds), { eventId: event.id })])
  : [[], [], []];
const answerLine = (discordId: string) =>
  questions
    .map((q) => ({ label: q.label, value: allAnswers.get(`u:${discordId}`)?.get(q.id) ?? '' }))
    .filter((a) => a.value !== '')
    .map((a) => `${a.label}: ${a.value}`)
    .join(' · ');
const paymentsOn = stripeConfigured(env);
const euro = (cents: number) => `${(cents / 100).toFixed(2)} €`;
const closeInputs = (t: TicketTypeWithSales) => (t.sales_close_at === null ? { date: '', time: '' } : unixToHelsinkiInputs(t.sales_close_at));

const going = signups.filter((signup) => signup.status === 'yes');
const maybe = signups.filter((signup) => signup.status === 'maybe');
const mine = session ? signups.find((signup) => signup.discord_id === session.discordId) : undefined;

// Solo events: capacity counts people. Team events: capacity counts teams.
const isTeamEvent = event?.team_size != null;
const teamMembers = (teamId: number) => signups.filter((s) => s.event_team_id === teamId);
const freeAgents = going.filter((s) => s.event_team_id === null);
const isFull = !isTeamEvent
  ? event?.capacity != null &&
    going.filter((s) => s.discord_id !== session?.discordId).length >= event.capacity
  : event?.capacity != null && eventTeams.length >= event.capacity;
const signupsClosed = event?.signups_closed_at != null;
// Signups can wait for an opening moment; until then only the heart works.
const opensLater = event ? !signupsOpen(event, nowSeconds) : false;
const open = event ? event.cancelled_at === null && !signupsClosed && !opensLater : false;
const interested = event && session ? await isInterested(env.DB, event.id, session.discordId) : false;
// The waitlist: solo, capped, no tickets.
const hasWaitlist = event ? !isTeamEvent && event.capacity !== null && !ticketed : false;
const waitlist = event && hasWaitlist ? await listWaitlist(env.DB, event.id) : [];
const myPlace = event && hasWaitlist && session ? await waitlistPosition(env.DB, event.id, session.discordId) : null;
if (event && !draft && event.cancelled_at === null) syncInterestInBackground(Astro.locals.cfContext, env.DB, env, event, nowSeconds);

// Flashes from board actions open the (otherwise folded) board tools.
const DISCORD_OPEN = new Set(['discord_reannounced', 'discord_created', 'discord_synced', 'discord_removed', 'discord_upgraded', 'discord_archived', 'discord_team_voice', 'discord_needs_category', 'discord_no_teams', 'discord_event_created', 'discord_event_removed', 'discord_event_skipped', 'discord_unconfigured', 'discord_forbidden', 'discord_error', 'discord_exists', 'discord_partial', 'discord_missing']);
const TICK_KEYS = new Set(['tick_given', 'tick_removed', 'tick_duplicate', 'tick_not_member', 'tick_missing', 'tick_bad_input']);
// Everything done from Participants comes back to Participants: the board
// edits a roster a row at a time, and being thrown to the top of the page
// with the panel shut after each one makes that miserable.
const PARTICIPANT_KEYS = new Set([
  ...TICK_KEYS,
  'signup_saved',
  'signup_removed',
  'member_added',
  'added',
  'not_linked',
  'team_renamed',
  'team_saved',
  'placed',
  'grouped',
  'team_full',
  'not_team_event',
  'dup_name',
]);
const ADMIN_OPEN = new Set(['team_size', ...PARTICIPANT_KEYS, 'cover_saved', 'cover_removed', 'cover_missing', 'cover_bad', 'photos_added', 'photo_removed', 'credit_saved', 'photo_missing', 'photo_bad', 'type_saved', 'type_deleted', 'question_saved', 'reinstated', 'ticket_holder', 'bad_time', 'forbidden', 'discord_down', ...DISCORD_OPEN]);
const okKey = Astro.url.searchParams.get('ok') ?? '';
const errKey = Astro.url.searchParams.get('err') ?? '';
const FLASH: Record<string, string> = {
  full: 'This event is full.',
  team_full: 'That team is already full.',
  dup_name: 'A team with that name already exists.',
  not_team_event: 'This event does not take team signups.',
  not_linked: 'That member has no Discord account linked yet, so there is nothing to add them as. Link it on their register entry first.',
  member_added: 'Added, against their own Discord account: the event role, their ticks and their stats all follow.',
  added: 'Walk-in added.',
  signup_saved: 'Saved.',
  signup_removed: 'Taken off the roster.',
  team_renamed: 'Team renamed.',
  team_saved: 'Team created.',
  grouped: 'Players without a team grouped into teams.',
  cancelled: 'This event has been cancelled and signups are closed.',
  closed: 'Signups are closed for this event.',
  bad_time: "That date and time didn't parse.",
  signin: 'Sign in with Discord first.',
  csrf: 'The form was stale. Try again.',
  bad_input: "That didn't save. Check the values: reserved seats can't exceed the capacity, a team name is 1 to 40 characters, a team size is a whole number.",
  team_reserves: "The reserves didn't change: a team already has more of them than that. Move those players into the line-up, or off the team, first.",
  team_size: "The team size didn't change: a team already has more members than that, or teams exist and the event can't go individual. Move people first.",
  missing: 'No such team on this event.',
  forbidden: 'That needs the admin role in Discord.',
  discord_down: "Discord didn't answer while re-checking your role. Try again.",
  members_only: 'This event is for members. Link your membership on the join page, or apply.',
  reserved: 'The remaining seats are reserved for members.',
  sold_out: 'That ticket type is sold out.',
  sales_closed: 'Sales for that ticket have closed.',
  has_ticket: 'You already have a ticket for this event.',
  payments_off: 'Card payments are not set up yet. Free tickets work; paid ones at the door.',
  stripe_down: "The payment page didn't open. Try again in a moment.",
  cancelled_checkout: 'Payment cancelled. Nothing was charged. Continue below, or release the seat to pick another ticket.',
  answers: 'Please answer the required questions.',
  needs_ticket: 'This event needs a ticket first. Buy one above, then form or join a team.',
  cover_missing: 'Pick an image file first.',
  cover_bad: 'The cover must be a JPEG, PNG or WebP under 1.5 MB.',
  photo_missing: 'Pick one or more pictures first.',
  photo_bad: 'A picture was refused: JPEG, PNG or WebP, and the page shrinks them before upload when JavaScript is on. At most 60 per event.',
  ticket_holder: 'That person holds a paid ticket, so they are going. Refund it in Stripe to remove them.',
  too_few: 'A bracket needs at least two teams or players. Players without a team are grouped into teams when you generate.',
  not_open: 'Signups are not open yet. Press Interested and come back when they open.',
  not_captain: 'Only the team founder can change the team.',
  not_full: 'A seat is free: sign up instead of waiting.',
  no_waitlist: 'This event has no waitlist.',
  duplicate: 'You are already going.',
  tick_duplicate: 'They already have that tick for this event.',
  tick_not_member: 'Ticks go to current members only.',
  tick_missing: 'That tick or member is no longer on the list.',
  tick_bad_input: "The tick didn't save. Pick a tick and a member.",
  discord_unconfigured: 'The Discord bot is not set up (no bot token). The technical handbook, "Discord roles", has the steps.',
  discord_forbidden: "Discord refused. The bot's role needs Manage Roles, Manage Channels, Create Events and Manage Events, and must sit above the roles it creates.",
  discord_event_skipped: 'Discord events are made for published, upcoming events only.',
  discord_error: "Discord didn't answer. Try again in a moment.",
  discord_exists: 'This event already has that on Discord.',
  discord_needs_category: "Team voice channels go in the event's own category. Upgrade first.",
  discord_no_teams: 'No teams yet, so no team voice channels.',
  discord_missing: 'No such event.',
  discord_partial: 'The site did its part, but Discord refused to delete something. Remove the leftover by hand in Discord.',
};
// Short tags on ticket rows for why a type is not open to this person.
const TYPE_TAGS: Record<string, string> = {
  sold_out: 'Sold out',
  full: 'Sold out',
  reserved: 'Members only now',
  sales_closed: 'Sales closed',
  cancelled: 'Cancelled',
  has_ticket: 'Yours',
  not_open: 'Not yet',
};
const OK: Record<string, string> = {
  draft: 'Saved as a draft. Only the board sees it; publish it when it is ready.',
  duplicated: 'Copied as a new draft, a week later, with the ticket types, questions and cover. Fix the date and title, then publish.',
  published: 'Published and posted on Discord.',
  team_saved: 'Team created. Put people in it with the team pickers below.',
  team_added: 'Added to your team.',
  team_kicked: 'Taken out of the team; they are still signed up.',
  placed: 'Moved between the line-up and the bench.',
  grouped: 'Players without a team were grouped into teams.',
  team_renamed: 'Team renamed; its voice channel and the brackets follow.',
  reinstated: 'The event is back on. The Discord cancellation line was removed.',
  released: 'Released. Nothing was charged.',
  added: 'Added to your basket.',
  type_saved: 'Ticket type saved.',
  type_deleted: 'Ticket type removed (or retired, if tickets were sold on it).',
  question_saved: 'Questions saved.',
  answers_saved: 'Your details are saved.',
  cover_saved: 'Cover image saved.',
  cover_removed: 'Cover image removed.',
  photos_added: 'Photos added.',
  photo_removed: 'Photo removed.',
  credit_saved: 'Photo credit saved.',
  tick_given: 'Tick given. The board channel has a line about it.',
  tick_removed: 'Tick removed.',
  interested: "Marked as interested. You'll see it under My events.",
  waitlisted: "You're on the waitlist. When a seat frees you're moved to Going, the event's Discord channel tells you, and it shows under My events.",
  left_waitlist: 'Taken off the waitlist.',
  admitted: 'Let in from the waitlist; they are going, and told.',
  uninterested: 'Interest removed.',
  discord_created: 'Role and channel created. Everyone on the roster has the role; new signups get it as they come.',
  discord_removed: 'Deleted from Discord: the role and every channel the bot made for this event.',
  discord_upgraded: 'Own category made. The channel moved in as discussion, with rules, bracket, teams, Commentators and Interviews beside it.',
  discord_archived: 'Archived. The role is gone, so participants no longer see the channels; the board still does.',
  discord_event_created: "The event is on Discord's event list.",
  discord_reannounced: 'The announcement was posted again.',
  discord_event_removed: "The Discord event was removed, as this event isn't published or is cancelled.",
};
// The sync's tally rides along in the query.
function teamVoiceMessage(p: URLSearchParams): string {
  return `Team voice channels: ${p.get('c') ?? 0} made, ${p.get('x') ?? 0} removed, ${p.get('t') ?? 0} teams in all.`;
}
function syncedMessage(p: URLSearchParams): string {
  const parts = [`${p.get('a') ?? 0} given`, `${p.get('r') ?? 0} taken away`];
  if (Number(p.get('m'))) parts.push(`${p.get('m')} not in the Discord server yet`);
  if (Number(p.get('f'))) parts.push(`${p.get('f')} refused by Discord`);
  if (Number(p.get('left'))) parts.push(`${p.get('left')} left for the next sync`);
  return `Role synced: ${parts.join(', ')}.`;
}
const flash = FLASH[errKey] ?? (okKey === 'discord_synced' ? syncedMessage(Astro.url.searchParams) : okKey === 'discord_team_voice' ? teamVoiceMessage(Astro.url.searchParams) : OK[okKey]) ?? null;
---
<Base
  title={event ? event.title : 'Event not found'}
  description={event ? `${event.title}, ${formatHelsinkiRange(event.starts_at, event.ends_at)}` : undefined}
  image={event && coverAt !== null ? `${Astro.url.origin}/events/${event.id}/cover?t=${coverAt}` : undefined}
  wide
>
  {!event || (draft && !session?.isAdmin) ? (
    <article class="prose">
      <h1>No such event</h1>
      <p>Nothing lives at this id. Back to <a href="/events">events</a>.</p>
    </article>
  ) : (
    <>
      <div class="event-layout">
      <p class="back-link"><a href="/events">← All events</a></p>
      <header class="event-head">
        {cover && <img class="event-cover" src={`/events/${event.id}/cover?t=${cover.updated_at}`} alt="" width={cover.width} height={cover.height} />}
        <div class="event-head-body">
          <h1>{event.title}</h1>
          {event.organizers && <p class="event-by">by {event.organizers}</p>}
          <p class="event-actions">
            {session ? (
              <form method="post" action={`/events/${event.id}/interest`} class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <button class={`btn btn-ghost btn-sm btn-heart${interested ? ' btn-heart-on' : ''}`} type="submit" aria-pressed={interested}>
                  <span aria-hidden="true">{interested ? '♥' : '♡'}</span> {event.interest_count} interested
                </button>
              </form>
            ) : (
              <span class="btn btn-ghost btn-sm btn-heart btn-heart-static"><span aria-hidden="true">♡</span> {event.interest_count} interested</span>
            )}
            <a class="btn btn-ghost btn-sm" href={`/events/${event.id}/event.ics`}>Add to calendar</a>
            {event.discord_event_id && <a class="btn btn-ghost btn-sm" href={scheduledEventUrl(event.discord_event_id)} rel="noopener">On Discord</a>}
            <button class="btn btn-ghost btn-sm" type="button" id="share-event" data-title={event.title} hidden>Share</button>
          </p>
          <ul class="event-facts">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
              <span>
                {formatHelsinkiRange(event.starts_at, event.ends_at)}
                {event.starts_at <= nowSeconds && event.ends_at !== null && event.ends_at > nowSeconds && <> <span class="live-badge">Happening now</span></>}
              </span>
            </li>
            {event.location && (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                <span>{event.location}</span>
              </li>
            )}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
              <span>
                {isTeamEvent
                  ? `Teams of ${event.team_size}: ${eventTeams.length}${event.capacity !== null ? ` / ${event.capacity}` : ''} teams, ${going.length} players in`
                  : `${going.length}${event.capacity !== null ? ` / ${event.capacity}` : ''} going${maybe.length > 0 ? `, ${maybe.length} maybe` : ''}`}
                {ticketed && event.capacity !== null && going.length >= event.capacity && <> <span class="status-badge status-muted">Sold out</span></>}
              </span>
            </li>
            {hasTicket && myTicket && (
              <li class="event-fact-mine">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3a3 3 0 0 1 0-6V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z" /><path d="M13 5v2" /><path d="M13 17v2" /><path d="M13 11v2" /></svg>
                <span>You have a ticket · {myTicket.type_name}{myTicket.checked_in_at ? ' · checked in' : ''} · <a href={`/tickets/${myTicket.code}`}>Show ticket</a></span>
              </li>
            )}
            {event.discord_channel_id && (session?.isAdmin || (event.discord_role_id && (mine || hasTicket))) && (
              <li class="event-fact-mine">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
                <span><a href={channelUrl(event.discord_channel_id)} rel="noopener">Participants' channel on Discord</a></span>
              </li>
            )}
          </ul>
          {(draft || opensLater || event.cancelled_at !== null || (signupsClosed && event.cancelled_at === null) || event.members_only === 1 || event.member_slots !== null) && (
            <p class="event-gating">
              {draft && <span class="status-badge status-muted">Draft</span>}
              {opensLater && event.cancelled_at === null && <span class="status-badge">Signups open {formatHelsinki(event.signups_open_at!)}</span>}
              {event.cancelled_at !== null && <span class="status-badge status-danger">Cancelled</span>}
              {signupsClosed && event.cancelled_at === null && <span class="status-badge status-muted">Signups closed</span>}
              {event.members_only === 1 && <span class="status-badge status-member">Members only</span>}
              {event.member_slots !== null && event.members_only !== 1 && (
                <span class="status-badge">{event.member_slots} of {event.capacity} seats reserved for members{access && access.openSeatsLeft !== null && !access.member ? `, ${access.openSeatsLeft} open to everyone` : ''}</span>
              )}
            </p>
          )}
        </div>
      </header>
      <ViewAs mode={view.mode} path={`/events/${event.id}`} />
      <aside class="event-side">
      {draft && (
        <div class="queue-card">
          <div class="queue-body">
            <p class="queue-name">Draft</p>
            <p class="queue-meta">Only the board sees this page. Publishing lists it, opens signups and sales, posts it on Discord and puts it on Discord's event list.</p>
          </div>
          <form method="post" action={`/events/${event.id}/publish`} class="publish-form">
            <input type="hidden" name="csrf" value={csrf} />
            {botOn && !event.discord_role_id && (
              <fieldset class="publish-discord">
                <legend class="queue-meta">On Discord, for participants:</legend>
                <label class="check"><input type="radio" name="discord_setup" value="channel" checked /> <span>A role and one channel under Events</span></label>
                <label class="check"><input type="radio" name="discord_setup" value="category" /> <span>A role and an own category: rules, bracket, teams, discussion, Commentators and Interviews voice, a voice channel per team</span></label>
                <label class="check"><input type="radio" name="discord_setup" value="none" /> <span>Nothing beyond the event list</span></label>
              </fieldset>
            )}
            <label class="publish-ping">
              Ping on Discord
              <select name="ping">
                <option value="" selected={!event.ping}>Nobody</option>
                <option value="everyone" selected={event.ping === 'everyone'}>@everyone</option>
                {pingRoles.map((r) => <option value={r.id} selected={event.ping === r.id}>@{r.name}</option>)}
              </select>
            </label>
            <button class="btn btn-cta" type="submit" data-confirm="Publish this event? It goes on Discord right away.">Publish</button>
          </form>
        </div>
      )}
      {!session && <SessionBox session={session} csrf={csrf} prompt={ticketed ? 'Sign in with Discord for member prices and to keep tickets on your account.' : undefined} />}
      {flash && <p class="flash">{flash}</p>}

      {ticketed && (
        <section class="tickets-box" id="buy">
          <h2 class="section-label">Tickets</h2>
          {hasTicket && myTicket && (
            <p class="ticket-have">
              <span class="status-badge status-member">You're in</span>
              <span>{myTicket.type_name}{myTicket.checked_in_at ? ', checked in' : ''} · <a href={`/tickets/${myTicket.code}`}>Show your ticket</a></span>
            </p>
          )}
          {pendingPurchase && (
            <div class="queue-card">
              <div class="queue-body">
                <p class="queue-name">Your payment is not finished</p>
                <p class="queue-meta">{resume ? 'Its seats are held for a while. Continue it, or release it and start over.' : 'Its payment window closed. Release it to start over.'}</p>
              </div>
              <div class="entry-actions">
                {resume && <a class="btn btn-cta" href={resume}>Continue to payment</a>}
                <form method="post" action={`/purchase/${pendingPurchase.id}/release`}>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="next" value={`/events/${event.id}`} />
                  <button class="btn btn-ghost" type="submit">Release</button>
                </form>
              </div>
            </div>
          )}
          <ul class="ticket-types">
            {activeTypes.map((t) => {
              const offer = offers.get(t.id)!;
              const left = t.quantity === null ? null : Math.max(0, t.quantity - t.sold);
              const max = offer.ok ? (offer.own ? 1 : 0) + offer.max_extras : 0;
              const canPay = t.price_cents === 0 || paymentsOn;
              const have = inBasket(t.id);
              return (
                <li class="ticket-type">
                  <div class="ticket-type-main">
                    <p class="ticket-type-name">{t.name}</p>
                    {t.description && <p class="queue-meta ticket-type-desc">{t.description}</p>}
                    <p class="ticket-type-tags">
                      <span class="ticket-type-price">
                        {t.member_price_cents !== null && t.member_price_cents !== t.price_cents
                          ? `${euro(t.price_cents)} · members ${euro(t.member_price_cents)}`
                          : t.price_cents === 0 ? 'Free' : euro(t.price_cents)}
                      </span>
                      {t.members_only === 1 && <span class="status-badge status-member">Members only</span>}
                      {!offer.ok && offer.reason !== 'members_only' && (
                        <span class="status-badge status-muted">{TYPE_TAGS[offer.reason] ?? offer.reason}</span>
                      )}
                      {offer.ok && max === 0 && <span class="status-badge status-muted">Sold out</span>}
                      {offer.ok && max > 0 && !canPay && <span class="status-badge status-muted">At the door</span>}
                      {offer.ok && max > 0 && left !== null && left <= 10 && <span class="queue-meta">{left} left</span>}
                      {t.sales_close_at !== null && offer.ok && <span class="queue-meta">until {formatHelsinki(t.sales_close_at)}</span>}
                    </p>
                  </div>
                  {offer.ok && max > 0 && canPay ? (
                    <form method="post" action="/basket/add" class="basket-add">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="kind" value="ticket" />
                      <input type="hidden" name="id" value={t.id} />
                      <input type="hidden" name="next" value={`/events/${event.id}`} />
                      {max > 1 && (
                        <select name="count" aria-label="How many tickets">
                          {Array.from({ length: max }, (_, i) => i + 1).map((n) => <option value={n}>{n}</option>)}
                        </select>
                      )}
                      <button class={`btn ${hasTicket && have === 0 ? 'btn-ghost' : 'btn-cta'}`} type="submit">{have > 0 ? `In basket (${have}) · Add more` : hasTicket ? 'Add for a friend' : 'Add to basket'}</button>
                    </form>
                  ) : null}
                </li>
              );
            })}
          </ul>
          {basketTotal > 0 && (
            <p class="basket-bar"><strong>{basketTotal} in your basket.</strong> <a class="btn btn-primary btn-sm" href="/checkout">Go to checkout</a></p>
          )}
          <p class="queue-meta">
            {session
              ? 'Tickets are personal and shown as a QR code. You can buy tickets for friends by name at the checkout.'
              : 'Without Discord, tickets are links you keep. You can buy for friends by name at the checkout.'}{' '}
            <a href="/terms">Terms of sale.</a>
          </p>
        </section>
      )}

      {!ticketed && !isTeamEvent && session && open && access && !access.allowed && (
        <p class="flash">{FLASH[access.reason!]}{access.reason === 'members_only' && <> <a href="/join">Link or apply</a>.</>}</p>
      )}

      {!ticketed && !isTeamEvent && session && open && (!access || access.allowed) && (
        <form method="post" action={`/events/${event.id}/signup`} class={questions.length > 0 ? 'app-form signup-with-questions' : 'signup-bar'} id="signup">
          <input type="hidden" name="csrf" value={csrf} />
          {questions.length > 0 && !mine && <p class="queue-meta">A couple of questions before you sign up:</p>}
          {questions.length > 0 && !mine && questions.map((q) => {
                const value = myAnswers.get(q.id) ?? '';
                return q.kind === 'checkbox' ? (
                  <label class="check check-standalone">
                    <input type="checkbox" name={`q${q.id}`} checked={value === 'yes'} /> <span>{q.label}{q.required ? ' *' : ''}</span>
                  </label>
                ) : q.kind === 'choice' ? (
                  <label>
                    {q.label}{q.required ? ' *' : ''}
                    <select name={`q${q.id}`} required={q.required === 1}>
                      <option value="" selected={value === ''}>Choose…</option>
                      {questionOptions(q).map((o) => <option value={o} selected={value === o}>{o}</option>)}
                    </select>
                  </label>
                ) : (
                  <label>
                    {q.label}{q.required ? ' *' : ''}
                    <input name={`q${q.id}`} maxlength="300" value={value} required={q.required === 1} />
                  </label>
                );
              })}
          <button
            class={`btn ${mine?.status === 'yes' ? 'btn-primary' : 'btn-ghost'}`}
            name="status"
            value="yes"
            disabled={isFull && mine?.status !== 'yes'}
            type="submit"
          >
            {isFull && mine?.status !== 'yes' ? 'Full' : "I'm going"}
          </button>
          <button
            class={`btn ${mine?.status === 'maybe' ? 'btn-primary' : 'btn-ghost'}`}
            name="status"
            value="maybe"
            type="submit"
          >Maybe</button>
          {mine && (
            <button class="btn btn-ghost" name="status" value="remove" type="submit">
              Remove my signup
            </button>
          )}
        </form>
      )}
      {!ticketed && !isTeamEvent && session && open && hasWaitlist && isFull && mine?.status !== 'yes' && (
        <form method="post" action={`/events/${event.id}/waitlist`} class="signup-bar waitlist-bar">
          <input type="hidden" name="csrf" value={csrf} />
          {myPlace === null ? (
            <>
              <input type="hidden" name="action" value="join" />
              <button class="btn btn-primary" type="submit">Join the waitlist{waitlist.length > 0 ? ` (${waitlist.length} waiting)` : ''}</button>
              <span class="queue-meta">First come, first in when a seat frees. You'll be moved to Going on your own.</span>
            </>
          ) : (
            <>
              <input type="hidden" name="action" value="leave" />
              <span class="queue-meta">You're <strong>#{myPlace}</strong> on the waitlist of {waitlist.length}.</span>
              <button class="btn btn-ghost btn-sm" type="submit">Leave the waitlist</button>
            </>
          )}
        </form>
      )}

      {questions.length > 0 && session && open && (mine || hasTicket || (isTeamEvent && !ticketed)) && (
        <section class="self-panel event-card" id="details">
          <h2 class="section-label">Your details for this event</h2>
          {isTeamEvent && !answersOk && <p class="flash">Answer the required questions before forming or joining a team.</p>}
          <form method="post" action={`/events/${event.id}/answers`} class="app-form">
            <input type="hidden" name="csrf" value={csrf} />
            {questions.map((q) => {
                const value = myAnswers.get(q.id) ?? '';
                return q.kind === 'checkbox' ? (
                  <label class="check check-standalone">
                    <input type="checkbox" name={`q${q.id}`} checked={value === 'yes'} /> <span>{q.label}{q.required ? ' *' : ''}</span>
                  </label>
                ) : q.kind === 'choice' ? (
                  <label>
                    {q.label}{q.required ? ' *' : ''}
                    <select name={`q${q.id}`} required={q.required === 1}>
                      <option value="" selected={value === ''}>Choose…</option>
                      {questionOptions(q).map((o) => <option value={o} selected={value === o}>{o}</option>)}
                    </select>
                  </label>
                ) : (
                  <label>
                    {q.label}{q.required ? ' *' : ''}
                    <input name={`q${q.id}`} maxlength="300" value={value} required={q.required === 1} />
                  </label>
                );
              })}
            <button class="btn btn-primary" type="submit">Save</button>
          </form>
        </section>
      )}

      {isTeamEvent && ticketed && session && open && !hasTicket && (
        <p class="flash">Teams are formed by ticket holders: get your ticket above first.</p>
