      </aside>
      <div class="event-body">
        {(event.description || liveBrackets.length > 0 || event.link_url) && (
          <section class="event-card">
            <h2 class="section-label">Description</h2>
            <div class="event-description">{paragraphs.map((para) => <p>{para}</p>)}</div>
            {(liveBrackets.length > 0 || event.link_url) && (
              <p class="entry-actions">
                {liveBrackets.length === 1 && <a class="btn btn-primary" href={`/events/${event.id}/bracket`}>View the bracket</a>}
