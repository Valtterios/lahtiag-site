---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import SessionBox from '../../components/SessionBox.astro';
import { currentSession, ensureCsrf } from '../../lib/guard';
import { listUpcomingEvents, listPastEvents } from '../../lib/db';
import { formatHelsinki, formatHelsinkiRange } from '../../lib/time';

// Server-rendered: the events list lives in D1. The Phase 1 Markdown page
// of event stories moved to /history when this route took the path over.

const session = await currentSession(Astro.request, env);
const csrf = ensureCsrf(Astro.cookies);
const now = Math.floor(Date.now() / 1000);

const [upcoming, past] = await Promise.all([
  listUpcomingEvents(env.DB, now),
  listPastEvents(env.DB, now, 10),
]);

const FLASH: Record<string, string> = {
  forbidden: 'That needs the admin role in Discord.',
  discord_down: "Discord didn't answer while re-checking your role. Try again.",
  bad_input: "The event couldn't be created from those values (reserved seats need a capacity and must not exceed it).",
  bad_time: "That date and time didn't parse. Use YYYY-MM-DD and HH:MM.",
  csrf: 'The form was stale. Try again.',
};
const OK: Record<string, string> = {
  purged: 'Member removed from every event and signup list.',
};
const flash =
  FLASH[Astro.url.searchParams.get('err') ?? ''] ?? OK[Astro.url.searchParams.get('ok') ?? ''] ?? null;
---
<Base title="Events" description="Upcoming LahtiAG events, tournaments and meetups, with signups.">
  <article class="prose">
    <h1>Events</h1>
  </article>
  <SessionBox session={session} csrf={csrf} />
  {flash && <p class="flash">{flash}</p>}

  {upcoming.length === 0 ? (
    <p class="app-empty">
      Nothing scheduled right now. Announcements land on <a href="https://discord.com/invite/u2pcgDhQ7G" rel="noopener">Discord</a> first.
    </p>
  ) : (
    <ul class="event-list">
      {upcoming.map((event) => (
        <li class="event-card">
          <p class="event-when">
            {event.starts_at <= now && <span class="live-badge">Happening now</span>}
            {formatHelsinkiRange(event.starts_at, event.ends_at)}
          </p>
          <h2><a href={`/events/${event.id}`}>{event.title}</a></h2>
          <p class="event-meta">
            {event.organizers && <span>By {event.organizers}, </span>}
            {event.team_size !== null ? (
              <span>
                teams of {event.team_size}, {event.teams_count}
                {event.capacity !== null ? ` / ${event.capacity}` : ''} teams in
              </span>
            ) : (
              <span>
                {event.yes_count}{event.capacity !== null ? ` / ${event.capacity}` : ''} going
                {event.maybe_count > 0 ? `, ${event.maybe_count} maybe` : ''}
              </span>
            )}
          </p>
        </li>
      ))}
    </ul>
  )}

  {past.length > 0 && (
    <section class="prose">
      <h2>Recently</h2>
      <ul>
        {past.map((event) => (
          <li>
            <a href={`/events/${event.id}`}>{event.title}</a> ({formatHelsinki(event.starts_at)})
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="calendar-box">
    <div>
      <p><strong>Get events in your calendar</strong></p>
      <p class="event-meta">
        One subscription, every future event, updates included.
      </p>
    </div>
    <div>
      <a class="btn btn-primary" href={`webcal://${Astro.url.host}/events.ics`}>Subscribe</a>
    </div>
    <p class="calendar-manual event-meta">
      On Android or Google Calendar the button may not work: open Google
      Calendar settings, choose <em>Add calendar, From URL</em>, and paste <code>{Astro.url.origin}/events.ics</code>
    </p>
  </section>

  <p class="app-empty">
    Looking for the older event stories, like Game Fest and the Mario Kart
    Tournament? They live on the <a href="/history">history page</a>.
  </p>

  {session?.isAdmin && (
    <section class="admin-panel">
      <h2>At the door</h2>
      <p class="event-meta">
        Is someone a member? The member check shows names and status only; the full register is
        for the accounts with register access.
      </p>
      <p><a class="btn btn-primary" href="/register/lookup">Member check</a></p>
      <h2>Create an event</h2>
      <form method="post" action="/events/new" class="app-form">
        <input type="hidden" name="csrf" value={csrf} />
        <label>Title <input name="title" required maxlength="120" /></label>
        <label>Date <input name="date" type="date" required /></label>
        <label>Starts (Helsinki) <input name="time" type="time" required /></label>
        <label>Ends <input name="end_time" type="time" required /></label>
        <label>
          Team size
          <input name="team_size" type="number" min="1" placeholder="empty = individual signups" />
        </label>
        <label>
          Capacity
          <input name="capacity" type="number" min="1" placeholder="unlimited (people, or teams for a team event)" />
        </label>
        <label class="check check-standalone">
          <input type="checkbox" name="members_only" /> <span>Members only (a linked, current membership is needed to sign up or buy)</span>
        </label>
        <label>
          Seats reserved for members
          <input name="member_slots" type="number" min="1" placeholder="empty = none; needs a capacity" />
        </label>
        <label>
          Organizers
          <input name="organizers" placeholder="LahtiAG, Kapital" maxlength="120" />
        </label>
        <label>
          Link
          <input name="link_url" type="url" placeholder="https:// stream, rules, venue…" maxlength="300" />
        </label>
        <label>Description <textarea name="description" rows="3"></textarea></label>
        <button class="btn btn-primary" type="submit">Create event</button>
      </form>
      <details class="admin-edit">
        <summary>Remove a member everywhere</summary>
        <p class="event-meta">
          Deletes every signup and team membership of one member across all
          events (ban cleanup, or a member asking to be erased). Get the
          Discord id via Developer Mode: right-click the user, Copy ID.
        </p>
        <form method="post" action="/members/purge" class="app-form">
          <input type="hidden" name="csrf" value={csrf} />
          <label>Discord id <input name="discord_id" required pattern="\d{5,25}" /></label>
          <button class="btn btn-ghost" type="submit">Remove everywhere</button>
        </form>
      </details>
    </section>
  )}
</Base>
