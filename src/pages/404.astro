---
import Base from '../layouts/Base.astro';

export const prerender = true;
---
<Base title="Page not found">
  <article class="prose">
    <p class="hero-eyebrow">Error 404</p>
    <h1>Game over. No page here.</h1>
    <p>There is nothing at this address. Continue?</p>
    <p><a class="btn btn-primary" href="/">Press start</a></p>
  </article>
</Base>
