---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { exchangeCode, fetchMe, fetchGuildMember, hasAdminRole } from '../../lib/discord';
import { DISCORD_GUILD_ID } from '../../lib/config';
import {
  SESSION_COOKIE,
  CSRF_COOKIE,
  SESSION_TTL_SECONDS,
  sealSession,
  newCsrfToken,
} from '../../lib/auth';
import { upsertMember } from '../../lib/db';

// The OAuth return leg. The three failure modes the spec's error handling
// distinguishes each get their own message: a stale state or exchange
// failure ("try again"), not being in the Discord server (show the invite),
// and Discord itself being unreachable.


type Outcome = 'expired' | 'not_member' | 'discord_down';
let outcome: Outcome | null = null;

sign: {
  if (!env.DISCORD_CLIENT_ID || !env.DISCORD_CLIENT_SECRET || !env.SESSION_SECRET) {
    return Astro.redirect('/auth/unavailable');
  }

  const code = Astro.url.searchParams.get('code');
  const state = Astro.url.searchParams.get('state');
  const stateCookie = Astro.cookies.get('__Host-oauth-state')?.value ?? '';
  Astro.cookies.delete('__Host-oauth-state', { path: '/' });
  const dot = stateCookie.lastIndexOf('.');
  const expectedState = dot >= 0 ? stateCookie.slice(0, dot) : stateCookie;
  const wasSilent = stateCookie.endsWith('.silent');
  if (!state || !expectedState || state !== expectedState) {
    outcome = 'expired';
    break sign;
  }
  if (!code) {
    // The silent prompt=none attempt bounced (never authorized, or Discord
    // wants interaction): retry once with the real consent screen. A
    // code-less return from the consent flow is the user cancelling.
    if (wasSilent) return Astro.redirect('/login?retry=1');
    outcome = 'expired';
    break sign;
  }

  const accessToken = await exchangeCode(
    env.DISCORD_CLIENT_ID,
    env.DISCORD_CLIENT_SECRET,
    code,
    `${Astro.url.origin}/auth/callback`,
  );
  if (!accessToken) {
    outcome = 'discord_down';
    break sign;
  }

  const [user, membership] = await Promise.all([
    fetchMe(accessToken),
    fetchGuildMember(accessToken, DISCORD_GUILD_ID),
  ]);
  if (!user || membership.status === 'error') {
    outcome = 'discord_down';
    break sign;
  }
  if (membership.status === 'not_member') {
    outcome = 'not_member';
    break sign;
  }

  const now = Math.floor(Date.now() / 1000);
  const username = membership.nick ?? user.global_name ?? user.username;
  await upsertMember(
    env.DB,
    { discord_id: user.id, username, avatar_hash: user.avatar },
    now,
  );

  const token = await sealSession(
    {
      discordId: user.id,
      username,
      avatarHash: user.avatar,
      isAdmin: hasAdminRole(membership.roles, env.ADMIN_ROLE_ID),
      accessToken,
      expiresAt: now + SESSION_TTL_SECONDS,
    },
    env.SESSION_SECRET,
  );
  // Astro.cookies (not response header appends): headers set on
  // Astro.response are dropped when Astro.redirect() builds its fresh
  // response, which silently lost the session and left users "signed in"
  // straight back to the sign-in button.
  const cookieOptions = {
    path: '/',
    maxAge: SESSION_TTL_SECONDS,
    httpOnly: true,
    secure: true,
    sameSite: 'lax',
  } as const;
  Astro.cookies.set(SESSION_COOKIE, token, cookieOptions);
  Astro.cookies.set(CSRF_COOKIE, newCsrfToken(), cookieOptions);
  return Astro.redirect('/events');
}
---
<Base title="Signing in">
  <article class="prose">
    {outcome === 'expired' && (
      <>
        <h1>That sign-in expired</h1>
        <p>The login attempt was stale or incomplete. It happens. Just start over.</p>
        <p><a class="btn btn-primary" href="/login">Sign in with Discord</a></p>
      </>
    )}
    {outcome === 'not_member' && (
      <>
        <h1>You're not in the LahtiAG Discord yet</h1>
        <p>
          Membership here comes from the Discord server: join it first, then
          sign in again.
        </p>
        <p>
          <a class="btn btn-primary" href="https://discord.com/invite/u2pcgDhQ7G" rel="noopener">
            Join the Discord server
          </a>
        </p>
      </>
    )}
    {outcome === 'discord_down' && (
      <>
        <h1>Discord didn't answer</h1>
        <p>
          Your account is fine. Discord itself was unreachable while signing
          you in. Wait a moment and try again.
        </p>
        <p><a class="btn btn-primary" href="/login">Try again</a></p>
      </>
    )}
  </article>
</Base>
