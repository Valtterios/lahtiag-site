---
import { getCollection } from 'astro:content';
import { navLinks, isCurrentNavLink, APP_PAGES } from '../lib/nav';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  // Register pages: a table with eight columns wants the whole window,
  // not the reading measure.
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;

// The nav is built from the collection at build time, so a new Markdown
// file with a navOrder appears in the header without touching this file.
const links = navLinks([...(await getCollection('pages')), ...APP_PAGES]);
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | LahtiAG</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={`${title} | LahtiAG`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content="LahtiAG" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/brand/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#4169e1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/chakra-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/" aria-label="LahtiAG home">
          <img src="/brand/wordmark-blue.png" alt="Lahti AG" width="514" height="160" />
        </a>
        <nav aria-label="Main">
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrentNavLink(pathname, link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class={wide ? 'site-main site-main-wide' : 'site-main'} id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <div>
          <h2>Lahti Association of Gaming LAG ry</h2>
          <p>Mukkulankatu 19<br />15210 Lahti, Finland</p>
          <p class="footer-legal">Business ID / Y-tunnus 3485167-1</p>
        </div>
        <div>
          <h2>Association</h2>
          <ul>
            <li><a href="/rules">Rules</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/members">Become a member</a></li>
            <li><a href="/membership">My membership</a></li>
            <li><a href="/register">Member register (board)</a></li>
          </ul>
        </div>
        <div>
          <h2>Find us</h2>
          <ul>
            <li><a href="https://discord.com/invite/u2pcgDhQ7G" rel="noopener">Discord</a></li>
            <li><a href="https://www.instagram.com/lahti_ag" rel="noopener">Instagram</a></li>
            <li><a href="mailto:board@lahtiag.fi">board@lahtiag.fi</a></li>
          </ul>
        </div>
        <p class="footer-note">
          <img src="/brand/wordmark-white.png" alt="" width="514" height="160" />
          <span>© {new Date().getFullYear()} Lahti Association of Gaming LAG ry</span>
        </p>
      </div>
    </footer>
  </body>
</html>
