# /etc/lahtiag-whitelist.conf — root-only (chmod 600). See docs/OPERATIONS.md.
URL=https://lahtiag.fi/api/minecraft/whitelist
TOKEN=the MINECRAFT_WHITELIST_TOKEN secret
WHITELIST_FILE=/mnt/storage/amp-instances/LahtiAG02/Minecraft/whitelist.json
AMP_URL=http://127.0.0.1:8081
# An AMP user with console access to the instance. Without these a running
# server is left alone; a stopped one still gets its whitelist.json updated.
AMP_USER=
AMP_PASS=
CONTAINER=AMP_LahtiAG02
KEEP=Axinikk
REMOVE=yes
