# /opt/lahtiag-bridge/.env — root-only (chmod 600). lahtiag-bridge-setcreds
# fills in the secrets; the rest is set here.
SERVER=gtnh
SERVER_LABEL=GT:NH
SITE_URL=https://lahtiag.fi
# The Discord text channel the game chat is bridged with, and a webhook in it.
BRIDGE_CHANNEL_ID=
BRIDGE_WEBHOOK_URL=
# The bot (the same one as the activity listener), with the Message Content intent turned on.
DISCORD_BOT_TOKEN=
# The instance's AMP endpoint and a user with console access to it (the
# whitelist sync's ones do), for Discord messages to reach the game.
AMP_URL=http://127.0.0.1:8089
AMP_USER=
AMP_PASS=
# The whitelist token, for posting the quest book progress to the site.
SITE_TOKEN=
# How often the quest book is read, in seconds.
PROGRESS_EVERY=300
